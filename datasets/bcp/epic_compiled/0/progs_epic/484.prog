          '\n'
          'Output format:\n'
          'DOC_RESULT_START\n'
          'Match: <Yes/No/Possibly>\n'
          'ArticleTitle: <if found>\n'
          'AuthorCountry: <if found>\n'
          'SubjectName: <if found>\n'
          'SubjectCountry: <if found>\n'
          'ResourceSharingPassage: <quote or NA>\n'
