def execute_command(image)->str:
    image_patch = ImagePatch(image)
    nightstand_patches = image_patch.find("nightstand")
    # If no nightstand is found, ask directly
    if len(nightstand_patches) == 0:
        return image_patch.simple_query("Are there beds to the right of the nightstand on the left side?")
    # Choose the leftmost nightstand
    left_nightstand = min(nightstand_patches, key=lambda p: p.horizontal_center)
    bed_patches = image_patch.find("bed")
    if len(bed_patches) == 0:
        return "no"
    for bed_patch in bed_patches:
        if bed_patch.horizontal_center > left_nightstand.horizontal_center:
            return "yes"
    return "no"