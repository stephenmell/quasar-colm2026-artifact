def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cow_patches = image_patch.find("cow")
    # Question assumes only one cow patch
    if len(cow_patches) == 0:
        # If no cow is found, query the image directly
        return image_patch.simple_query("Does the cow seem to be brown?")
    is_brown = any(cow_patch.verify_property("cow", "brown") for cow_patch in cow_patches)
    return bool_to_yesno(is_brown)