def execute_command(image)->str:
    image_patch = ImagePatch(image)
    umbrella_patches = image_patch.find("umbrella")
    if len(umbrella_patches) == 0:
        return image_patch.simple_query("Are there umbrellas in the scene that are not orange?")
    for umbrella_patch in umbrella_patches:
        if not umbrella_patch.verify_property("umbrella", "orange"):
            return "yes"
    return "no"