def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # Identify the man on the left side (leftmost man)
    if len(man_patches) == 0:
        # If no man is found, query the image directly
        return image_patch.simple_query("Is there any bottle to the right of the man on the left side?")
    leftmost_man = min(man_patches, key=lambda p: p.horizontal_center)

    bottle_patches = image_patch.find("bottle")
    if len(bottle_patches) == 0:
        return "no"
    for bottle_patch in bottle_patches:
        if bottle_patch.horizontal_center > leftmost_man.horizontal_center:
            return "yes"
    return "no"