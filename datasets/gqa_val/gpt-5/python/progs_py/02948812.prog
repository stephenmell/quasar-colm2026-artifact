# Does that water bottle have green color?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    water_bottle_patches = image_patch.find("water bottle")
    # Question assumes only one water bottle patch
    if len(water_bottle_patches) == 0:
        # If no water bottle is found, query the image directly
        return image_patch.simple_query("Does that water bottle have green color?")
    return bool_to_yesno(water_bottle_patches[0].verify_property("water bottle", "green"))