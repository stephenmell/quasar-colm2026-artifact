def execute_command(image)->str:
    image_patch = ImagePatch(image)
    sweater_patches = image_patch.find("sweater")
    if len(sweater_patches) == 0:
        return image_patch.simple_query("How long is the gray sweater?")
    gray_sweaters = [p for p in sweater_patches if p.verify_property("sweater", "gray")]
    if len(gray_sweaters) == 0:
        return image_patch.simple_query("How long is the gray sweater?")
    return gray_sweaters[0].best_text_match(["short", "long"])