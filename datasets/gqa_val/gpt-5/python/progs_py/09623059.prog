def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    if len(table_patches) == 0:
        # If no table is found, ask the question directly
        return image_patch.simple_query("Does the table look red?")
    is_red = any(tp.verify_property("table", "red") for tp in table_patches)
    return bool_to_yesno(is_red)