def execute_command(image)->str:
    image_patch = ImagePatch(image)
    backpack_patches = image_patch.find("backpack")
    # If no backpack is found, query the image directly
    if len(backpack_patches) == 0:
        return image_patch.simple_query("Is there a backpack in this photo that is orange?")
    # Check if any detected backpack is orange
    for backpack_patch in backpack_patches:
        if backpack_patch.verify_property("backpack", "orange"):
            return "yes"
    return "no"