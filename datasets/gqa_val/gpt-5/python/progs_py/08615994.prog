def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_words = (
        image_patch.exists("words")
        or image_patch.exists("word")
        or image_patch.exists("text")
        or image_patch.exists("letters")
    )
    has_numbers = (
        image_patch.exists("numbers")
        or image_patch.exists("number")
        or image_patch.exists("digits")
        or image_patch.exists("digit")
        or image_patch.exists("numerals")
        or image_patch.exists("numeral")
    )
    return bool_to_yesno(has_words and has_numbers)