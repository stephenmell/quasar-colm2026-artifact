def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")
    if len(fence_patches) == 0:
        # If no fence is found, query the image directly
        return image_patch.simple_query("Is there a fence in this picture that is not brown?")
    for fence_patch in fence_patches:
        if not fence_patch.verify_property("fence", "brown"):
            return "yes"
    return "no"