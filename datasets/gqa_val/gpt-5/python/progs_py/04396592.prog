def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    # Question assumes at least one woman
    if len(woman_patches) == 0:
        # If no woman is found, query the image directly
        return image_patch.simple_query("Is the woman to the left of a chair?")
    chair_patches = image_patch.find("chair")
    if len(chair_patches) == 0:
        return "no"
    for woman_patch in woman_patches:
        for chair_patch in chair_patches:
            if woman_patch.horizontal_center < chair_patch.horizontal_center:
                return "yes"
    return "no"