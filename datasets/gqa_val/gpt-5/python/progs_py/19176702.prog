def execute_command(image)->str:
    image_patch = ImagePatch(image)
    beverage_patches = image_patch.find("beverage")
    # If no beverage is found, query the image directly
    if len(beverage_patches) == 0:
        return image_patch.simple_query("Do you see men to the left of the beverage?")
    man_patches = image_patch.find("man")
    if len(man_patches) == 0:
        return "no"
    for beverage_patch in beverage_patches:
        for man_patch in man_patches:
            if man_patch.horizontal_center < beverage_patch.horizontal_center:
                return "yes"
    return "no"