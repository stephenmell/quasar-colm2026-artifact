# Do you see any trucks to the left of the vehicle on the left?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    vehicle_patches = image_patch.find("vehicle")
    if len(vehicle_patches) == 0:
        # If no vehicle is found, query the image directly
        return image_patch.simple_query("Do you see any trucks to the left of the vehicle on the left?")
    # Find the leftmost vehicle
    leftmost_vehicle = min(vehicle_patches, key=lambda p: p.horizontal_center)
    # Look for trucks to the left of this vehicle
    truck_patches = image_patch.find("truck")
    if len(truck_patches) == 0:
        return "no"
    for truck_patch in truck_patches:
        if truck_patch.horizontal_center < leftmost_vehicle.horizontal_center:
            return "yes"
    return "no"