def execute_command(image)->str:
    image_patch = ImagePatch(image)
    nose_patches = image_patch.find("nose")
    if len(nose_patches) == 0:
        # If no nose is found, query the image directly
        return image_patch.simple_query("Does the nose have white color?")
    for nose_patch in nose_patches:
        if nose_patch.verify_property("nose", "white"):
            return "yes"
    return "no"