def execute_command(image)->str:
    image_patch = ImagePatch(image)
    tire_patches = image_patch.find("tire")
    # If no tires are found, ask the question directly
    if len(tire_patches) == 0:
        return image_patch.simple_query("Do the tires look black?")
    # Require all detected tires to look black
    for tire_patch in tire_patches:
        if not tire_patch.verify_property("tire", "black"):
            return "no"
    return "yes"