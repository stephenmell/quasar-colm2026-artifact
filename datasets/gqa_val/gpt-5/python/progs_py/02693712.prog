def execute_command(image)->str:
    image_patch = ImagePatch(image)
    animal_patches = image_patch.find("animal")
    # Question assumes at least one animal
    if len(animal_patches) == 0:
        # If no animal is found, query the image directly
        return image_patch.simple_query("What animal is brown?")
    for animal_patch in animal_patches:
        if animal_patch.verify_property("animal", "brown"):
            return animal_patch.simple_query("What animal is brown?")  # keep property in the query
    # If no brown animal is detected, ask about the first animal
    return animal_patches[0].simple_query("What animal is brown?")