def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    if len(woman_patches) == 0:
        return image_patch.simple_query("Does the woman's hair look dark?")
    woman_patch = woman_patches[0]
    hair_patches = woman_patch.find("hair")
    if len(hair_patches) > 0:
        is_dark = hair_patches[0].verify_property("hair", "dark")
        return bool_to_yesno(is_dark)
    return woman_patch.simple_query("Does the woman's hair look dark?")