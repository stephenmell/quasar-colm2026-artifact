def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # If no man is found, ask directly
    if len(man_patches) == 0:
        return image_patch.simple_query("Is the man that is playing wearing gloves?")
    # Find the man who is playing
    for man_patch in man_patches:
        if man_patch.verify_property("man", "playing"):
            return bool_to_yesno(man_patch.verify_property("man", "wearing gloves"))
    # If no man is identified as playing, ask directly
    return image_patch.simple_query("Is the man that is playing wearing gloves?")