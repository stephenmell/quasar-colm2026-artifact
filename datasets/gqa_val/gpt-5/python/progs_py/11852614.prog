# Is the jeep to the left of the white vehicle?
def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Find jeep(s)
    jeep_patches = image_patch.find("jeep")
    if len(jeep_patches) == 0:
        # If no jeep is found, query the image directly
        return image_patch.simple_query("Is the jeep to the left of the white vehicle?")

    # Find white vehicle(s)
    white_vehicle_patches = image_patch.find("white vehicle")
    if len(white_vehicle_patches) == 0:
        # Fallback: find vehicles and filter by white color property
        candidate_vehicle_patches = image_patch.find("vehicle")
        white_vehicle_patches = [v for v in candidate_vehicle_patches if v.verify_property("vehicle", "white")]

    if len(white_vehicle_patches) == 0:
        # If no white vehicle is found, query directly
        return image_patch.simple_query("Is the jeep to the left of the white vehicle?")

    # Check if any jeep is to the left of any white vehicle
    for jeep in jeep_patches:
        for white_vehicle in white_vehicle_patches:
            if jeep.horizontal_center < white_vehicle.horizontal_center:
                return "yes"
    return "no"