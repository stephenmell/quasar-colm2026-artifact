def execute_command(image)->str:
    image_patch = ImagePatch(image)
    letters_patches = image_patch.find("letters")
    if len(letters_patches) == 0:
        return image_patch.simple_query("Are there white letters?")
    is_white = any(p.verify_property("letters", "white") for p in letters_patches)
    return bool_to_yesno(is_white)