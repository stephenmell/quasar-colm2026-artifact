def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Find all computers; if none, ask directly
    computer_patches = image_patch.find("computer")
    if len(computer_patches) == 0:
        return image_patch.simple_query("Is the small device to the right or to the left of the computer in the middle?")

    # Choose the computer that is closest to the center of the image (the "computer in the middle")
    img_cx, img_cy = image_patch.horizontal_center, image_patch.vertical_center
    def dist2_to_image_center(p):
        dx = p.horizontal_center - img_cx
        dy = p.vertical_center - img_cy
        return dx*dx + dy*dy
    middle_computer = min(computer_patches, key=dist2_to_image_center)

    # Find devices; if none, ask directly
    device_patches = image_patch.find("device")
    if len(device_patches) == 0:
        return image_patch.simple_query("Is the small device to the right or to the left of the computer in the middle?")

    # Prefer devices that are verified "small"
    small_devices = []
    for d in device_patches:
        if d.verify_property("device", "small"):
            small_devices.append(d)

    candidates = small_devices if len(small_devices) > 0 else device_patches

    # If still ambiguous, choose the device nearest to the middle computer
    def dist2_to_computer(d):
        dx = d.horizontal_center - middle_computer.horizontal_center
        dy = d.vertical_center - middle_computer.vertical_center
        return dx*dx + dy*dy
    small_device = min(candidates, key=dist2_to_computer)

    # Determine relative horizontal position
    return "right" if small_device.horizontal_center >= middle_computer.horizontal_center else "left"