def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lettuce_patches = image_patch.find("lettuce")
    tomato_patches = image_patch.find("tomato")

    # If objects aren't detected, ask directly
    if len(lettuce_patches) == 0 or len(tomato_patches) == 0:
        return image_patch.simple_query("Is the lettuce to the right or to the left of the tomato that looks red?")

    # Filter tomatoes that look red
    red_tomato_patches = []
    for tomato_patch in tomato_patches:
        if tomato_patch.verify_property("tomato", "red") or tomato_patch.verify_property("tomato", "looks red"):
            red_tomato_patches.append(tomato_patch)

    if len(red_tomato_patches) == 0:
        return image_patch.simple_query("Is the lettuce to the right or to the left of the tomato that looks red?")

    red_tomato = red_tomato_patches[0]
    # Choose the lettuce closest horizontally to the red tomato (in case of multiple lettuces)
    lettuce = min(lettuce_patches, key=lambda lp: abs(lp.horizontal_center - red_tomato.horizontal_center))

    if lettuce.horizontal_center > red_tomato.horizontal_center:
        return "right"
    else:
        return "left"