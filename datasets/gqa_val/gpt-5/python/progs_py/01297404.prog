def execute_command(image)->str:
    image_patch = ImagePatch(image)
    pizza_patches = image_patch.find("pizza")
    onion_patches = image_patch.find("onion")

    # If neither is found, ask directly
    if len(pizza_patches) == 0 and len(onion_patches) == 0:
        return image_patch.simple_query("What kind of food is cooked, the pizza or the onion?")

    # Check if any pizza is cooked
    for pizza_patch in pizza_patches:
        if pizza_patch.verify_property("pizza", "cooked"):
            return "pizza"
        # Fallback check via question
        if pizza_patch.simple_query("Is the pizza cooked?") == "yes":
            return "pizza"

    # Check if any onion is cooked
    for onion_patch in onion_patches:
        if onion_patch.verify_property("onion", "cooked"):
            return "onion"
        # Fallback check via question
        if onion_patch.simple_query("Is the onion cooked?") == "yes":
            return "onion"

    # If uncertain, ask directly
    return image_patch.simple_query("What kind of food is cooked, the pizza or the onion?")