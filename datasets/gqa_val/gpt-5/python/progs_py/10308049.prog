def execute_command(image)->str:
    image_patch = ImagePatch(image)
    truck_patches = image_patch.find("truck")
    house_patches = image_patch.find("house")
    # If either object isn't detected, ask directly
    if len(truck_patches) == 0 or len(house_patches) == 0:
        return image_patch.simple_query("Is the color of the truck different than the house?")
    truck_patch = truck_patches[0]
    house_patch = house_patches[0]
    # Use a palette of common colors to compare
    colors = [
        "black", "blue", "brown", "gray", "green", "orange", "pink",
        "purple", "red", "white", "yellow", "silver", "gold",
        "beige", "tan", "maroon", "teal"
    ]
    truck_color = truck_patch.best_text_match(colors)
    house_color = house_patch.best_text_match(colors)
    return "yes" if truck_color != house_color else "no"