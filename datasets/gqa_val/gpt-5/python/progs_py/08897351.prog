# How big is the bowl?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bowl_patches = image_patch.find("bowl")
    # Question assumes only one bowl patch
    if len(bowl_patches) == 0:
        # If no bowl is found, query the image directly
        return image_patch.simple_query("How big is the bowl?")
    # If multiple bowls are found, pick the largest one
    largest_bowl_patch = max(bowl_patches, key=lambda p: p.width * p.height)
    return largest_bowl_patch.simple_query("How big is the bowl?")