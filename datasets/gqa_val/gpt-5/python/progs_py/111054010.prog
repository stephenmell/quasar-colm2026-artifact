def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lamp_patches = image_patch.find("lamp")
    if len(lamp_patches) == 0:
        # If no lamp is found, query the image directly
        return image_patch.simple_query("Are there any books to the right of the lamp that is on the left?")
    # Choose the leftmost lamp
    left_lamp = min(lamp_patches, key=lambda p: p.horizontal_center)
    book_patches = image_patch.find("book")
    if len(book_patches) == 0:
        return "no"
    for book_patch in book_patches:
        if book_patch.horizontal_center > left_lamp.horizontal_center:
            return "yes"
    return "no"