def execute_command(image)->str:
    image_patch = ImagePatch(image)
    scarf_patches = image_patch.find("scarf")
    bag_patches = image_patch.find("bag")

    # If neither object is detected, ask the whole image directly
    if len(scarf_patches) == 0 and len(bag_patches) == 0:
        return image_patch.simple_query("Is there a orange scarf or bag?")

    # Check for an orange scarf
    for scarf_patch in scarf_patches:
        if scarf_patch.verify_property("scarf", "orange"):
            return "yes"

    # Check for an orange bag
    for bag_patch in bag_patches:
        if bag_patch.verify_property("bag", "orange"):
            return "yes"

    return "no"