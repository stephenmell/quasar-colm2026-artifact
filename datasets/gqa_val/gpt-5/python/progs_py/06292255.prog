def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    man_patches = image_patch.find("man")

    # If we can't localize the people, ask directly
    if len(woman_patches) == 0 or len(man_patches) == 0:
        return image_patch.simple_query("Does the man to the left of the woman appear to be crouching?")

    # Use the first detected woman as reference
    woman_patch = woman_patches[0]

    # Find men to the left of this woman
    left_men = [m for m in man_patches if m.horizontal_center < woman_patch.horizontal_center]
    if len(left_men) == 0:
        return "no"

    # Choose the man closest to the woman's left
    left_men.sort(key=lambda m: woman_patch.horizontal_center - m.horizontal_center)
    target_man = left_men[0]

    # Check if he appears to be crouching (with a few synonyms as fallback)
    is_crouching = target_man.verify_property("man", "crouching")
    if not is_crouching:
        is_crouching = (
            target_man.verify_property("man", "squatting")
            or target_man.verify_property("man", "kneeling")
            or (target_man.simple_query("Is the man crouching?") == "yes")
        )

    return bool_to_yesno(is_crouching)