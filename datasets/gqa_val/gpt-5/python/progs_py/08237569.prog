def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")
    # If no fence is found, query the image directly
    if len(fence_patches) == 0:
        return image_patch.simple_query("Is there any fence in the picture that is not brown?")
    for fence_patch in fence_patches:
        is_brown = fence_patch.verify_property("fence", "brown")
        if not is_brown:
            return "yes"
    return "no"