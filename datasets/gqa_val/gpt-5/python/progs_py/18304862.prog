def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # Question assumes one man patch
    if len(man_patches) == 0:
        # If no man is found, query the image directly
        return image_patch.simple_query("Are there people to the right of the man?")
    man_patch = man_patches[0]
    person_patches = image_patch.find("person")
    if len(person_patches) == 0:
        return "no"
    for person_patch in person_patches:
        # Skip the same patch if detected as both "man" and "person"
        if (person_patch.left == man_patch.left and
            person_patch.right == man_patch.right and
            person_patch.upper == man_patch.upper and
            person_patch.lower == man_patch.lower):
            continue
        if person_patch.horizontal_center > man_patch.horizontal_center:
            return "yes"
    return "no"