def execute_command(image)->str:
    image_patch = ImagePatch(image)
    ski_patches = image_patch.find("skis")
    if len(ski_patches) == 0:
        ski_patches = image_patch.find("ski")
        if len(ski_patches) == 0:
            return image_patch.simple_query("Are there any skis in this picture that are gray?")
    for ski_patch in ski_patches:
        if ski_patch.verify_property("skis", "gray") or ski_patch.verify_property("ski", "gray"):
            return "yes"
    return "no"