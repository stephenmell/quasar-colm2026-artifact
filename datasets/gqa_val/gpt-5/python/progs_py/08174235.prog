def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Try to find a black car directly
    black_car_patches = image_patch.find("black car")
    black_car_patch = None

    if len(black_car_patches) > 0:
        black_car_patch = black_car_patches[0]
    else:
        # Fallback: find cars and check which one is black
        car_patches = image_patch.find("car")
        if len(car_patches) == 0:
            # If no car is found, ask directly
            return image_patch.simple_query("Is there a bus to the left of the black car?")
        for car_patch in car_patches:
            if car_patch.verify_property("car", "black"):
                black_car_patch = car_patch
                break
        if black_car_patch is None:
            # If no black car is found, ask directly
            return image_patch.simple_query("Is there a bus to the left of the black car?")

    bus_patches = image_patch.find("bus")
    if len(bus_patches) == 0:
        return "no"

    for bus_patch in bus_patches:
        if bus_patch.horizontal_center < black_car_patch.horizontal_center:
            return "yes"
    return "no"