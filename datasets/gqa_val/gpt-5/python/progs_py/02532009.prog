def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # First try to directly find a rectangular basket
    rect_basket_patches = image_patch.find("rectangular basket")
    if len(rect_basket_patches) > 0:
        return bool_to_yesno(rect_basket_patches[0].verify_property("rectangular basket", "white"))
    # Otherwise, find baskets and check which are rectangular
    basket_patches = image_patch.find("basket")
    if len(basket_patches) == 0:
        # If no basket is found, query the image directly
        return image_patch.simple_query("Does the rectangular basket look white?")
    for basket_patch in basket_patches:
        if basket_patch.verify_property("basket", "rectangular"):
            return bool_to_yesno(basket_patch.verify_property("basket", "white"))
    # If no rectangular basket is identified, ask directly
    return image_patch.simple_query("Does the rectangular basket look white?")