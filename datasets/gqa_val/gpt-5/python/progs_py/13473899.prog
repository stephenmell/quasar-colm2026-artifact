def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fork_patches = image_patch.find("fork")
    # If no fork is found, ask the question directly
    if len(fork_patches) == 0:
        return image_patch.simple_query("Does the fork have black color?")
    # If multiple forks are found, return yes if any is black
    for fork_patch in fork_patches:
        if fork_patch.verify_property("fork", "black"):
            return "yes"
    return "no"