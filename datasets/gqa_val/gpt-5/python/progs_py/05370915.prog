def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Find bikes in the image
    bike_patches = image_patch.find("bike")
    if len(bike_patches) == 0:
        # Try synonym
        bike_patches = image_patch.find("bicycle")
    # If no bikes are found, ask the question directly
    if len(bike_patches) == 0:
        return image_patch.simple_query("Is there a bike in the photograph that is not black?")
    # Check if any found bike is not black
    for bike_patch in bike_patches:
        is_black = (
            bike_patch.verify_property("bike", "black")
            or bike_patch.verify_property("bicycle", "black")
        )
        if not is_black:
            return "yes"
    return "no"