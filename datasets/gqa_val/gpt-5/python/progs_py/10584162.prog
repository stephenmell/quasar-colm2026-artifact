def execute_command(image)->str:
    image_patch = ImagePatch(image)
    airplane_patches = image_patch.find("airplane")
    if len(airplane_patches) == 0:
        # If no airplane is found, query the image directly
        return image_patch.simple_query("Is there an airplane in the picture that is not white?")
    for airplane_patch in airplane_patches:
        # If any airplane is not white, answer yes
        if not airplane_patch.verify_property("airplane", "white"):
            return "yes"
    return "no"