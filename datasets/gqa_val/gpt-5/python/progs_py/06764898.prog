# Does he wear shorts?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # If no man is found, ask directly
    if len(man_patches) == 0:
        return image_patch.simple_query("Does he wear shorts?")
    # Check each detected man
    for man_patch in man_patches:
        # Try property verification
        if man_patch.verify_property("man", "wearing shorts"):
            return "yes"
        # Look for shorts within the man's region
        if man_patch.exists("shorts"):
            return "yes"
        # Fallback: ask about wearing within the man's crop
        if man_patch.simple_query("Is the man wearing shorts?") == "yes":
            return "yes"
    return "no"