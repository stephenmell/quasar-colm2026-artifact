def execute_command(image)->str:
    image_patch = ImagePatch(image)
    dog_patches = image_patch.find("dog")
    # If no dog is found, query the image directly
    if len(dog_patches) == 0:
        return image_patch.simple_query("Is the skateboard to the right of the dog on the left?")
    # Select the leftmost dog
    left_dog = min(dog_patches, key=lambda p: p.horizontal_center)
    skateboard_patches = image_patch.find("skateboard")
    if len(skateboard_patches) == 0:
        return "no"
    for skateboard_patch in skateboard_patches:
        if skateboard_patch.horizontal_center > left_dog.horizontal_center:
            return "yes"
    return "no"