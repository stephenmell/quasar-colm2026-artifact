def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bus_patches = image_patch.find("bus")
    if len(bus_patches) == 0:
        # If no bus is found, query the image directly
        return image_patch.simple_query("Does that bus look white?")
    return bool_to_yesno(bus_patches[0].verify_property("bus", "white"))