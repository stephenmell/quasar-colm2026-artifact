def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bird_patches = image_patch.find("bird")
    if len(bird_patches) == 0:
        return "no"
    water_patches = image_patch.find("water")
    if len(water_patches) == 0:
        # If no water is found, ask directly
        return image_patch.simple_query("Are there any birds above the water?")
    for bird_patch in bird_patches:
        for water_patch in water_patches:
            # "Above" means a higher vertical center in this coordinate system
            if bird_patch.vertical_center > water_patch.vertical_center:
                return "yes"
    return "no"