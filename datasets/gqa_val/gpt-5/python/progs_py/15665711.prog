def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Check for any white words
    white_words = False
    for name in ["words", "word", "text", "letters"]:
        patches = image_patch.find(name)
        for patch in patches:
            if patch.verify_property(name, "white"):
                white_words = True
                break
        if white_words:
            break

    # Check for any cars (any color)
    has_car = image_patch.exists("car")

    return bool_to_yesno(white_words or has_car)