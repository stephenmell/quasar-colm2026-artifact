def execute_command(image)->str:
    image_patch = ImagePatch(image)
    umbrella_patches = image_patch.find("umbrella")
    is_white_umbrella = False
    for umbrella_patch in umbrella_patches:
        if umbrella_patch.verify_property("umbrella", "white"):
            is_white_umbrella = True
            break
    is_car = image_patch.exists("car")
    return bool_to_yesno(is_white_umbrella or is_car)