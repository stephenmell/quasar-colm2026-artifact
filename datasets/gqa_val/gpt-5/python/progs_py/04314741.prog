def execute_command(image)->str:
    image_patch = ImagePatch(image)
    window_patches = image_patch.find("window")
    if len(window_patches) == 0:
        # If no windows are found, query the image directly
        return image_patch.simple_query("Are there any windows that are not blue?")
    for window_patch in window_patches:
        if not window_patch.verify_property("window", "blue"):
            return "yes"
    return "no"