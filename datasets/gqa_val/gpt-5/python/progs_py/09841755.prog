def execute_command(image)->str:
    image_patch = ImagePatch(image)
    door_patches = image_patch.find("door")
    # If no doors are found, query the image directly
    if len(door_patches) == 0:
        return image_patch.simple_query("Are there doors in this photo that are red?")
    # Check if any detected door is red
    for door_patch in door_patches:
        if door_patch.verify_property("door", "red"):
            return "yes"
    return "no"