def execute_command(image)->str:
    image_patch = ImagePatch(image)
    water_patches = image_patch.find("water")
    # Question assumes there is water; if none found, ask directly
    if len(water_patches) == 0:
        return image_patch.simple_query("Is the water dark and wavy?")
    # Check if any detected water region is both dark and wavy
    for water_patch in water_patches:
        is_dark = water_patch.verify_property("water", "dark")
        is_wavy = water_patch.verify_property("water", "wavy")
        if is_dark and is_wavy:
            return "yes"
    return "no"