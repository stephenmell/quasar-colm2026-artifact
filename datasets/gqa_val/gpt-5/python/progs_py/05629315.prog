def execute_command(image)->str:
    image_patch = ImagePatch(image)
    backpack_patches = image_patch.find("backpack")
    if len(backpack_patches) == 0:
        # If no backpack is found, query the image directly
        return image_patch.simple_query("Do you see any black backpacks?")
    for backpack_patch in backpack_patches:
        if backpack_patch.verify_property("backpack", "black"):
            return "yes"
    return "no"