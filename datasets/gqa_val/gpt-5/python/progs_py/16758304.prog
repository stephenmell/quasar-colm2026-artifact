def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Try classifying the scene as outdoors vs indoors
    scene = image_patch.best_text_match(["outdoors", "indoors"])
    if scene == "outdoors":
        return "yes"
    if scene == "indoors":
        return "no"
    # Fallback: ask directly
    return image_patch.simple_query("Is it an outdoors scene?")