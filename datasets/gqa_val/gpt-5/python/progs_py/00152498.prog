# Is the blue bandana on the white dog?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    dog_patches = image_patch.find("dog")
    # If no dog is found, ask directly
    if len(dog_patches) == 0:
        return image_patch.simple_query("Is the blue bandana on the white dog?")
    # Look for a white dog that has a blue bandana within its crop
    for dog_patch in dog_patches:
        if dog_patch.verify_property("dog", "white"):
            bandana_patches = dog_patch.find("bandana")
            for bandana_patch in bandana_patches:
                if bandana_patch.verify_property("bandana", "blue"):
                    return "yes"
    return "no"