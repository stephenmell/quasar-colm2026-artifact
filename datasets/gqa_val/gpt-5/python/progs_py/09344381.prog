def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # If no man is found, ask directly
    if len(man_patches) == 0:
        return image_patch.simple_query("Do you see cars to the left of the man that is wearing jeans?")
    # Filter men wearing jeans
    jeans_men = []
    for man_patch in man_patches:
        if man_patch.simple_query("Is the man wearing jeans?") == "yes":
            jeans_men.append(man_patch)
    # If no man wearing jeans is found, ask directly
    if len(jeans_men) == 0:
        return image_patch.simple_query("Do you see cars to the left of the man that is wearing jeans?")
    # Find cars and check if any are to the left of any jeans-wearing man
    car_patches = image_patch.find("car")
    if len(car_patches) == 0:
        return "no"
    for man_patch in jeans_men:
        for car_patch in car_patches:
            if car_patch.horizontal_center < man_patch.horizontal_center:
                return "yes"
    return "no"