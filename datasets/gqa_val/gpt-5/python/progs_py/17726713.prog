def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bottle_patches = image_patch.find("bottle")
    if len(bottle_patches) == 0:
        # If no bottle is found, query the image directly
        return image_patch.simple_query("Does the green bottle look tall?")
    # Find the green bottle among detected bottles
    for bottle_patch in bottle_patches:
        if bottle_patch.verify_property("bottle", "green"):
            return bool_to_yesno(bottle_patch.verify_property("bottle", "tall"))
    # If no green bottle is found, ask directly
    return image_patch.simple_query("Does the green bottle look tall?")