def execute_command(image)->str:
    image_patch = ImagePatch(image)
    animal_patches = image_patch.find("animal")
    if len(animal_patches) == 0:
        return image_patch.simple_query("Is the animal that is not little bending or standing?")
    not_little_animals = []
    for animal_patch in animal_patches:
        if not animal_patch.verify_property("animal", "little"):
            not_little_animals.append(animal_patch)
    if len(not_little_animals) == 0:
        return image_patch.simple_query("Is the animal that is not little bending or standing?")
    target_patch = not_little_animals[0]
    if target_patch.verify_property("animal", "bending"):
        return "bending"
    if target_patch.verify_property("animal", "standing"):
        return "standing"
    return target_patch.best_text_match(["bending", "standing"])