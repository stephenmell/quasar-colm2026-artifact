def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # If no man is found, ask directly
    if len(man_patches) == 0:
        return image_patch.simple_query("Is the computer mouse to the right or to the left of the man that is shown in the picture?")
    man_patch = man_patches[0]

    # Try to find a computer mouse; fall back to "mouse" if needed
    mouse_patches = image_patch.find("computer mouse")
    if len(mouse_patches) == 0:
        mouse_patches = image_patch.find("mouse")
        if len(mouse_patches) == 0:
            return image_patch.simple_query("Is the computer mouse to the right or to the left of the man that is shown in the picture?")

    # Choose the mouse closest to the man horizontally
    closest_mouse = min(mouse_patches, key=lambda p: abs(p.horizontal_center - man_patch.horizontal_center))

    return "right" if closest_mouse.horizontal_center > man_patch.horizontal_center else "left"