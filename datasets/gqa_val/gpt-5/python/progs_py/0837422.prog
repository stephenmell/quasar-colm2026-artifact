# Does the bed have the same color as the ground?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bed_patches = image_patch.find("bed")
    if len(bed_patches) == 0:
        return image_patch.simple_query("Does the bed have the same color as the ground?")

    ground_patches = image_patch.find("ground")
    if len(ground_patches) == 0:
        # fallback for indoor scenes
        ground_patches = image_patch.find("floor")
    if len(ground_patches) == 0:
        return image_patch.simple_query("Does the bed have the same color as the ground?")

    bed_patch = bed_patches[0]
    ground_patch = ground_patches[0]

    colors = ["black","white","gray","brown","blue","green","red","yellow","orange","pink","purple","tan","beige"]
    bed_color = bed_patch.best_text_match(colors)
    ground_color = ground_patch.best_text_match(colors)

    return "yes" if bed_color == ground_color else "no"