def execute_command(image)->str:
    image_patch = ImagePatch(image)
    appliance_patches = image_patch.find("appliance")
    # If no appliance is found, query directly
    if len(appliance_patches) == 0:
        return image_patch.simple_query("Is there a bed to the left of the appliance on the right side of the image?")
    # Consider only appliances on the right half of the image
    right_side_appliances = [p for p in appliance_patches if p.horizontal_center > image_patch.horizontal_center]
    if len(right_side_appliances) == 0:
        return image_patch.simple_query("Is there a bed to the left of the appliance on the right side of the image?")
    # Choose the right-most appliance among those on the right side
    appliance_patch = max(right_side_appliances, key=lambda p: p.horizontal_center)
    bed_patches = image_patch.find("bed")
    if len(bed_patches) == 0:
        return "no"
    for bed_patch in bed_patches:
        if bed_patch.horizontal_center < appliance_patch.horizontal_center:
            return "yes"
    return "no"