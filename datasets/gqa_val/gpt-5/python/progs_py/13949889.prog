def execute_command(image)->str:
    image_patch = ImagePatch(image)
    chair_patches = image_patch.find("chair")

    # Need at least two chairs to resolve "the chair to the right of the other chair"
    if len(chair_patches) < 2:
        return image_patch.simple_query("What is the chair that is to the right of the other chair made of?")

    # Find the closest pair horizontally and pick the right one from that pair
    best_pair = None
    best_gap = float("inf")
    for i, left_chair in enumerate(chair_patches):
        for j, right_chair in enumerate(chair_patches):
            if right_chair.horizontal_center > left_chair.horizontal_center:
                gap = right_chair.horizontal_center - left_chair.horizontal_center
                if gap < best_gap:
                    best_gap = gap
                    best_pair = (i, j)

    if best_pair is None:
        # Fallback if no ordered pair found
        return image_patch.simple_query("What is the chair that is to the right of the other chair made of?")

    right_chair = chair_patches[best_pair[1]]
    return right_chair.simple_query("What is the chair made of?")