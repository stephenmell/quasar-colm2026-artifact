def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cat_patches = image_patch.find("cat")
    if len(cat_patches) == 0:
        # If no cats are found, query the image directly
        return image_patch.simple_query("Are there any happy cats?")
    for cat_patch in cat_patches:
        if cat_patch.verify_property("cat", "happy"):
            return "yes"
    return "no"