def execute_command(image)->str:
    image_patch = ImagePatch(image)
    mirror_patches = image_patch.find("mirror")
    # If no mirror is found, query the image directly
    if len(mirror_patches) == 0:
        return image_patch.simple_query("Do you see any mirrors that are not silver?")
    for mirror_patch in mirror_patches:
        is_silver = mirror_patch.verify_property("mirror", "silver")
        if not is_silver:
            return "yes"
    return "no"