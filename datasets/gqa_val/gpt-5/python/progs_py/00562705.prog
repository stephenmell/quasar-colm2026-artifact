def execute_command(image)->str:
    image_patch = ImagePatch(image)
    belt_patches = image_patch.find("belt")
    # Question assumes only one belt patch
    if len(belt_patches) == 0:
        # If no belt is found, query the image directly
        return image_patch.simple_query("Does the belt have brown color?")
    is_brown = any(belt_patch.verify_property("belt", "brown") for belt_patch in belt_patches)
    return bool_to_yesno(is_brown)