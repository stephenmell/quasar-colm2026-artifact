def execute_command(image)->str:
    image_patch = ImagePatch(image)
    frisbee_patches = image_patch.find("frisbee")
    if len(frisbee_patches) == 0:
        # If no frisbee is found, query the image directly
        return image_patch.simple_query("Are there any frisbees in this image that are white?")
    for frisbee_patch in frisbee_patches:
        if frisbee_patch.verify_property("frisbee", "white"):
            return "yes"
    return "no"