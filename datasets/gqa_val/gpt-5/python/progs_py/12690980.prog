def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fork_patches = image_patch.find("fork")
    spoon_patches = image_patch.find("spoon")

    if len(fork_patches) == 0 and len(spoon_patches) == 0:
        return image_patch.simple_query("Do you see any clean forks or spoons?")

    for fork_patch in fork_patches:
        if fork_patch.verify_property("fork", "clean"):
            return "yes"

    for spoon_patch in spoon_patches:
        if spoon_patch.verify_property("spoon", "clean"):
            return "yes"

    return "no"