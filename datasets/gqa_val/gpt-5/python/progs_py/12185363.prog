def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    # Question assumes one table patch
    if len(table_patches) == 0:
        # If no table is found, query the image directly
        return image_patch.simple_query("Is there a toothbrush to the right of the table?")
    table_patch = table_patches[0]
    toothbrush_patches = image_patch.find("toothbrush")
    if len(toothbrush_patches) == 0:
        return "no"
    for toothbrush_patch in toothbrush_patches:
        if toothbrush_patch.horizontal_center > table_patch.horizontal_center:
            return "yes"
    return "no"