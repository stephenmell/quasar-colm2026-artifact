def execute_command(image)->str:
    image_patch = ImagePatch(image)
    chain_patches = image_patch.find("chain")
    # Question assumes only one chain patch
    if len(chain_patches) == 0:
        # If no chain is found, query the image directly
        return image_patch.simple_query("Does the chain look red or silver?")
    return chain_patches[0].best_text_match(["red", "silver"])