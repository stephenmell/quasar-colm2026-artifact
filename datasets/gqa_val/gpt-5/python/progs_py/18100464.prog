def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Direct check for office chairs
    if image_patch.exists("office chair"):
        return "yes"
    # Fallback: check chairs with 'office' property
    chair_patches = image_patch.find("chair")
    for chair_patch in chair_patches:
        if chair_patch.verify_property("chair", "office") or chair_patch.simple_query("Is this an office chair?") == "yes":
            return "yes"
    return "no"