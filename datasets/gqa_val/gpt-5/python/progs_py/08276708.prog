def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Find umbrellas and filter for black ones
    umbrella_patches = image_patch.find("umbrella")
    if len(umbrella_patches) == 0:
        return image_patch.simple_query("Is the black umbrella to the right or to the left of the white vehicle?")
    black_umbrellas = [u for u in umbrella_patches if u.verify_property("umbrella", "black")]
    if len(black_umbrellas) == 0:
        return image_patch.simple_query("Is the black umbrella to the right or to the left of the white vehicle?")

    # Find white vehicles (try several common vehicle categories)
    white_vehicle_patches = []
    vehicle_types = ["vehicle", "car", "truck", "bus", "van", "automobile", "suv"]
    for vt in vehicle_types:
        patches = image_patch.find(vt)
        for p in patches:
            if p.verify_property(vt, "white"):
                white_vehicle_patches.append(p)
        if len(white_vehicle_patches) > 0:
            break

    if len(white_vehicle_patches) == 0:
        return image_patch.simple_query("Is the black umbrella to the right or to the left of the white vehicle?")

    # Choose the closest umbrella-vehicle pair horizontally
    best_u, best_v, best_dist = None, None, None
    for u in black_umbrellas:
        for v in white_vehicle_patches:
            dist = abs(u.horizontal_center - v.horizontal_center)
            if best_dist is None or dist < best_dist:
                best_u, best_v, best_dist = u, v, dist

    if best_u.horizontal_center > best_v.horizontal_center:
        return "right"
    else:
        return "left"