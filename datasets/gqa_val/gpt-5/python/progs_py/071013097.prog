def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    # Question assumes only one woman patch
    if len(woman_patches) == 0:
        # If no woman is found, query the image directly
        return image_patch.simple_query("What color is the glove the woman is wearing?")
    for woman_patch in woman_patches:
        is_wearing_glove = (woman_patch.simple_query("Is the woman wearing a glove?") == "yes")
        if is_wearing_glove:
            return woman_patch.simple_query("What color is the glove the woman is wearing?")
    # If no woman is wearing a glove, ask the image directly
    return image_patch.simple_query("What color is the glove the woman is wearing?")