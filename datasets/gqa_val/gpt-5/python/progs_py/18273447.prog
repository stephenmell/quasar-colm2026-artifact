def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    # If no table is found, ask directly
    if len(table_patches) == 0:
        return image_patch.simple_query("Is there a table that is not made of wood?")
    # Check if any detected table is not wooden
    for table_patch in table_patches:
        is_wooden = (
            table_patch.verify_property("table", "wood")
            or table_patch.verify_property("table", "wooden")
            or table_patch.simple_query("Is the table made of wood?") == "yes"
        )
        if not is_wooden:
            return "yes"
    return "no"