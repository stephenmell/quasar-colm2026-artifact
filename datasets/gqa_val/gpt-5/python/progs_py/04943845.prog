def execute_command(image)->str:
    image_patch = ImagePatch(image)
    uniform_patches = image_patch.find("uniform")
    if len(uniform_patches) == 0:
        return image_patch.simple_query("Is the uniform blue?")
    is_blue = any(patch.verify_property("uniform", "blue") for patch in uniform_patches)
    return bool_to_yesno(is_blue)