def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")
    if len(fence_patches) == 0:
        return image_patch.simple_query("Is the white fence made of wood?")
    found_white = False
    for fence_patch in fence_patches:
        if fence_patch.verify_property("fence", "white"):
            found_white = True
            if fence_patch.verify_property("fence", "wood"):
                return "yes"
    if found_white:
        return "no"
    return image_patch.simple_query("Is the white fence made of wood?")