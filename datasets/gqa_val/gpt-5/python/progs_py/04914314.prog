def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    # Question assumes one man patch
    if len(man_patches) == 0:
        # If no man is found, ask directly
        return image_patch.simple_query("What kind of furniture is to the right of the man?")
    man_patch = man_patches[0]

    furniture_patches = image_patch.find("furniture")
    if len(furniture_patches) == 0:
        # If no furniture is detected, ask directly
        return image_patch.simple_query("What kind of furniture is to the right of the man?")

    # Keep only furniture to the right of the man
    right_furniture = [fp for fp in furniture_patches if fp.horizontal_center > man_patch.horizontal_center]
    if len(right_furniture) == 0:
        return image_patch.simple_query("What kind of furniture is to the right of the man?")

    # Choose the nearest furniture to the right
    right_furniture.sort(key=lambda fp: fp.horizontal_center - man_patch.horizontal_center)
    # Ask what it is
    return right_furniture[0].simple_query("What kind of furniture is this?")