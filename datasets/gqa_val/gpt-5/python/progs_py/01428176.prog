def execute_command(image)->str:
    image_patch = ImagePatch(image)
    tap_patches = image_patch.find("tap")
    # If no tap is found, ask the whole image
    if len(tap_patches) == 0:
        return image_patch.simple_query("What is the tap made of?")
    # Ask about the first detected tap
    return tap_patches[0].simple_query("What is the tap made of?")