def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lamb_patches = image_patch.find("lamb")
    # Question assumes only one lamb patch
    if len(lamb_patches) == 0:
        # If no lamb is found, query the image directly
        return image_patch.simple_query("Is there any monkey to the right of the lamb?")
    monkey_patches = image_patch.find("monkey")
    if len(monkey_patches) == 0:
        return "no"
    for lamb_patch in lamb_patches:
        for monkey_patch in monkey_patches:
            if monkey_patch.horizontal_center > lamb_patch.horizontal_center:
                return "yes"
    return "no"