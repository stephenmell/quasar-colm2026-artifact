def execute_command(image)->str:
    image_patch = ImagePatch(image)
    zebra_patches = image_patch.find("zebra")
    # If no zebra is found, ask the question directly
    if len(zebra_patches) == 0:
        return image_patch.simple_query("Is there a zebra that is not sitting?")
    # If any zebra is not sitting, answer yes
    for zebra_patch in zebra_patches:
        if not zebra_patch.verify_property("zebra", "sitting"):
            return "yes"
    return "no"