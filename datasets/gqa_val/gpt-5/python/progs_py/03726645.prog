def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Find men and curtains to identify the man that is left of a curtain
    man_patches = image_patch.find("man")
    curtain_patches = image_patch.find("curtain")

    # If key references are missing, ask directly
    if len(man_patches) == 0 or len(curtain_patches) == 0:
        return image_patch.simple_query("Are there any bags to the left of the man that is to the left of the curtain?")

    # Find any man that is to the left of any curtain
    qualifying_men = []
    for man_patch in man_patches:
        for curtain_patch in curtain_patches:
            if man_patch.horizontal_center < curtain_patch.horizontal_center:
                qualifying_men.append(man_patch)
                break

    if len(qualifying_men) == 0:
        return "no"

    # Find bags
    bag_patches = image_patch.find("bag")
    if len(bag_patches) == 0:
        return "no"

    # Check if any bag is to the left of any qualifying man
    for man_patch in qualifying_men:
        for bag_patch in bag_patches:
            if bag_patch.horizontal_center < man_patch.horizontal_center:
                return "yes"

    return "no"