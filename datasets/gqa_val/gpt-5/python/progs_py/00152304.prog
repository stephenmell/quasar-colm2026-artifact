def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    if len(woman_patches) == 0:
        # If no woman is found, ask directly
        return image_patch.simple_query("Do you see bags to the right of the woman on the left?")
    # Select the leftmost woman by horizontal center
    leftmost_woman = min(woman_patches, key=lambda p: p.horizontal_center)
    # Look for various bag types
    bag_patches = []
    for name in ["bag", "bags", "handbag", "purse", "shopping bag", "backpack"]:
        bag_patches.extend(image_patch.find(name))
    if len(bag_patches) == 0:
        return "no"
    for bag_patch in bag_patches:
        if bag_patch.horizontal_center > leftmost_woman.horizontal_center:
            return "yes"
    return "no"