def execute_command(image)->str:
    image_patch = ImagePatch(image)
    logo_patches = image_patch.find("logo")
    if len(logo_patches) == 0:
        # If no logo is found, ask the question directly about the whole image
        return image_patch.simple_query("What bag is the logo on?")
    # Ask about the first detected logo patch
    return logo_patches[0].simple_query("What bag is the logo on?")