def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    if len(table_patches) == 0:
        # If no table is found, query the image directly
        return image_patch.simple_query("What is the table made of?")
    # Use the largest detected table patch
    table_patch = max(table_patches, key=lambda p: p.width * p.height)
    return table_patch.simple_query("What is the table made of?")