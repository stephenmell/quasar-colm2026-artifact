def execute_command(image)->str:
    image_patch = ImagePatch(image)
    surfboard_patches = image_patch.find("surfboard")
    if len(surfboard_patches) == 0:
        # If no surfboard is found, query the image directly
        return image_patch.simple_query("Is the surfboard blue?")
    # If multiple surfboards exist, return yes if any is blue
    for surfboard_patch in surfboard_patches:
        if surfboard_patch.verify_property("surfboard", "blue"):
            return "yes"
    return "no"