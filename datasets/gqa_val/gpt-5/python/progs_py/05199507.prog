def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    if len(table_patches) == 0:
        # If no tables are found, query the image directly
        return image_patch.simple_query("Are there round tables in the image?")
    for table_patch in table_patches:
        if table_patch.verify_property("table", "round"):
            return "yes"
    return "no"