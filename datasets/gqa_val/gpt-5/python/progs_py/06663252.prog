def execute_command(image)->str:
    image_patch = ImagePatch(image)
    # Focus on the bottom part of the image
    bottom_patch = image_patch.crop(0, 0, image_patch.width, int(image_patch.vertical_center))
    # Ask the relational question within the bottom region
    return bottom_patch.simple_query("What is the drink to the left of the box?")