# Do you see a pillow that is white?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    pillow_patches = image_patch.find("pillow")
    if len(pillow_patches) == 0:
        # If no pillow is found, query the image directly
        return image_patch.simple_query("Do you see a pillow that is white?")
    for pillow_patch in pillow_patches:
        if pillow_patch.verify_property("pillow", "white"):
            return "yes"
    return "no"