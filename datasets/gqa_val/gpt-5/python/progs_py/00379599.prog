# Is the bowl to the right or to the left of the placemat near the pizza?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    pizza_patches = image_patch.find("pizza")
    placemat_patches = image_patch.find("placemat")
    bowl_patches = image_patch.find("bowl")

    # Fallback if key objects are missing
    if len(pizza_patches) == 0 or len(placemat_patches) == 0 or len(bowl_patches) == 0:
        return image_patch.simple_query("Is the bowl to the right or to the left of the placemat near the pizza?")

    # Helper to compute squared distance between centers
    def dist2(a, b):
        dx = a.horizontal_center - b.horizontal_center
        dy = a.vertical_center - b.vertical_center
        return dx*dx + dy*dy

    # Select the placemat nearest to any pizza (placemat "near the pizza")
    best_placemat = None
    best_d = float("inf")
    for pl in placemat_patches:
        d = min(dist2(pl, pi) for pi in pizza_patches)
        if d < best_d:
            best_d = d
            best_placemat = pl

    # Select the bowl nearest to that placemat
    best_bowl = None
    best_bd = float("inf")
    for b in bowl_patches:
        d = dist2(b, best_placemat)
        if d < best_bd:
            best_bd = d
            best_bowl = b

    # Compare horizontal centers
    if best_bowl.horizontal_center > best_placemat.horizontal_center:
        return "right"
    else:
        return "left"