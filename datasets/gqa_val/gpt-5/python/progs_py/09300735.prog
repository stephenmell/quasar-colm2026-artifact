# Does the ball look white or purple?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    ball_patches = image_patch.find("ball")
    # Question assumes only one ball patch
    if len(ball_patches) == 0:
        # If no ball is found, query the image directly
        return image_patch.simple_query("Does the ball look white or purple?")
    return ball_patches[0].best_text_match(["white", "purple"])