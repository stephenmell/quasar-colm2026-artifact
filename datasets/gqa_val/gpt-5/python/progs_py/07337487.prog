def execute_command(image)->str:
    image_patch = ImagePatch(image)
    faucet_patches = image_patch.find("faucet")
    # Question assumes only one faucet patch
    if len(faucet_patches) == 0:
        # If no faucet is found, query the image directly
        return image_patch.simple_query("In which part of the picture is the faucet, the bottom or the top?")
    if faucet_patches[0].vertical_center < image_patch.vertical_center:
        return "bottom"
    else:
        return "top"