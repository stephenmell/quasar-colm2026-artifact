def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    # If no woman is found, query the image directly
    if len(woman_patches) == 0:
        return image_patch.simple_query("Is the person that is to the left of the woman wearing a helmet?")
    woman_patch = woman_patches[0]

    person_patches = image_patch.find("person")
    # If no person is found, query the image directly
    if len(person_patches) == 0:
        return image_patch.simple_query("Is the person that is to the left of the woman wearing a helmet?")

    # Find the person immediately to the left of the woman (closest on the left)
    target_person = None
    min_dx = None
    for person_patch in person_patches:
        if person_patch.horizontal_center < woman_patch.horizontal_center:
            dx = woman_patch.horizontal_center - person_patch.horizontal_center
            if min_dx is None or dx < min_dx:
                min_dx = dx
                target_person = person_patch

    if target_person is None:
        return "no"

    answer = target_person.simple_query("Is the person wearing a helmet?")
    return "yes" if str(answer).strip().lower() == "yes" else "no"