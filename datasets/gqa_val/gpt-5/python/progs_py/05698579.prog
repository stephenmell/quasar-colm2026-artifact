def execute_command(image)->str:
    image_patch = ImagePatch(image)
    motorbike_patches = image_patch.find("motorbike")
    # If no motorbike is found, ask directly
    if len(motorbike_patches) == 0:
        return image_patch.simple_query("Do you see a bag to the left of the motorbike that looks purple?")
    motorbike_patch = motorbike_patches[0]
    bag_patches = image_patch.find("bag")
    if len(bag_patches) == 0:
        return "no"
    for bag_patch in bag_patches:
        if bag_patch.horizontal_center < motorbike_patch.horizontal_center:
            if bag_patch.verify_property("bag", "purple"):
                return "yes"
    return "no"