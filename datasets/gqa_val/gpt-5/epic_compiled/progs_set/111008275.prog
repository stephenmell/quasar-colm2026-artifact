def execute_command(image) -> str:
    image_patch = None
    is_glass = None
    is_sack = None
    result = None
    image_patch = ImagePatch(image)
    is_sack = image_patch.exists('sack')
    is_glass = image_patch.exists('glass')
    result = bool_to_yesno(or_expr(is_sack, is_glass))
    return result