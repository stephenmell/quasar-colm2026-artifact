def execute_command(image) -> str:
    image_patch = None
    pot_patches = None
    result = None
    tea_patches = None
    image_patch = ImagePatch(image)
    pot_patches = image_patch.find('pot')

    def _if(image_patch, pot_patches, result, tea_patches):
        result = image_patch.simple_query('Is the pot to the right of tea?')
        return (image_patch, pot_patches, result, tea_patches)

    def _else(image_patch, pot_patches, result, tea_patches):
        tea_patches = image_patch.find('tea')

        def _if(image_patch, pot_patches, result, tea_patches):
            result = 'no'
            return (image_patch, pot_patches, result, tea_patches)

        def _else(image_patch, pot_patches, result, tea_patches):
            result = 'no'

            def _for(pot_patch, image_patch, pot_patches, result, tea_patches):

                def _for(tea_patch, image_patch, pot_patches, result, tea_patches):

                    def _if(image_patch, pot_patches, result, tea_patches):
                        result = 'yes'
                        return (image_patch, pot_patches, result, tea_patches)
                    image_patch, pot_patches, result, tea_patches = if_stmt(_if, None, pot_patch.horizontal_center > tea_patch.horizontal_center, (image_patch, pot_patches, result, tea_patches))
                    return (image_patch, pot_patches, result, tea_patches)
                image_patch, pot_patches, result, tea_patches = for_stmt(_for, tea_patches, (image_patch, pot_patches, result, tea_patches))
                return (image_patch, pot_patches, result, tea_patches)
            image_patch, pot_patches, result, tea_patches = for_stmt(_for, pot_patches, (image_patch, pot_patches, result, tea_patches))
            return (image_patch, pot_patches, result, tea_patches)
        image_patch, pot_patches, result, tea_patches = if_stmt(_if, _else, len(tea_patches) == 0, (image_patch, pot_patches, result, tea_patches))
        return (image_patch, pot_patches, result, tea_patches)
    image_patch, pot_patches, result, tea_patches = if_stmt(_if, _else, len(pot_patches) == 0, (image_patch, pot_patches, result, tea_patches))
    return result