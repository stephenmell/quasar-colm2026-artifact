def execute_command(image) -> str:
    image_patch = None
    is_lamp = None
    is_tablecloth = None
    result = None
    image_patch = ImagePatch(image)
    is_tablecloth = image_patch.exists('tablecloth')
    is_lamp = image_patch.exists('lamp')
    result = bool_to_yesno(or_expr(is_tablecloth, is_lamp))
    return result