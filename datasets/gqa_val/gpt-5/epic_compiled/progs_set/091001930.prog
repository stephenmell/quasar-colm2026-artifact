def execute_command(image) -> str:
    has_dog = None
    has_fence = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_fence = image_patch.exists('fence')
    has_dog = image_patch.exists('dog')
    result = bool_to_yesno(or_expr(has_fence, has_dog))
    return result