def execute_command(image) -> str:
    image_patch = None
    is_dark = None
    is_wavy = None
    result = None
    water_patches = None
    image_patch = ImagePatch(image)
    water_patches = image_patch.find('water')
    result = 'no'

    def _if(image_patch, is_dark, is_wavy, result, water_patches):
        result = image_patch.simple_query('Is the water dark and wavy?')
        return (image_patch, is_dark, is_wavy, result, water_patches)

    def _else(image_patch, is_dark, is_wavy, result, water_patches):

        def _for(water_patch, image_patch, is_dark, is_wavy, result, water_patches):
            is_dark = water_patch.verify_property('water', 'dark')
            is_wavy = water_patch.verify_property('water', 'wavy')

            def _if(image_patch, is_dark, is_wavy, result, water_patches):
                result = 'yes'
                return (image_patch, is_dark, is_wavy, result, water_patches)
            image_patch, is_dark, is_wavy, result, water_patches = if_stmt(_if, None, and_expr(is_dark, is_wavy), (image_patch, is_dark, is_wavy, result, water_patches))
            return (image_patch, is_dark, is_wavy, result, water_patches)
        image_patch, is_dark, is_wavy, result, water_patches = for_stmt(_for, water_patches, (image_patch, is_dark, is_wavy, result, water_patches))
        return (image_patch, is_dark, is_wavy, result, water_patches)
    image_patch, is_dark, is_wavy, result, water_patches = if_stmt(_if, _else, len(water_patches) == 0, (image_patch, is_dark, is_wavy, result, water_patches))
    return result