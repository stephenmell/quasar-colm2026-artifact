def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_train = None
    result = None
    image_patch = ImagePatch(image)
    is_train = image_patch.exists('train')
    is_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(is_train, is_fence))
    return result