def execute_command(image) -> str:
    image_patch = None
    result = None
    sweater_patches = None
    image_patch = ImagePatch(image)
    sweater_patches = image_patch.find('sweater')

    def _if(image_patch, result, sweater_patches):
        result = image_patch.simple_query('Does the sweater look black?')
        return (image_patch, result, sweater_patches)

    def _else(image_patch, result, sweater_patches):
        result = 'no'

        def _for(sweater_patch, image_patch, result, sweater_patches):

            def _if(image_patch, result, sweater_patches):
                result = 'yes'
                return (image_patch, result, sweater_patches)
            image_patch, result, sweater_patches = if_stmt(_if, None, sweater_patch.verify_property('sweater', 'black'), (image_patch, result, sweater_patches))
            return (image_patch, result, sweater_patches)
        image_patch, result, sweater_patches = for_stmt(_for, sweater_patches, (image_patch, result, sweater_patches))
        return (image_patch, result, sweater_patches)
    image_patch, result, sweater_patches = if_stmt(_if, _else, len(sweater_patches) == 0, (image_patch, result, sweater_patches))
    return result