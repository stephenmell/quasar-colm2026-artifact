def execute_command(image) -> str:
    has_fence = None
    has_helmet = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_helmet = image_patch.exists('helmet')
    has_fence = image_patch.exists('fence')
    result = bool_to_yesno(and_expr(has_helmet, has_fence))
    return result