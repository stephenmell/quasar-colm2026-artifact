def execute_command(image) -> str:
    image_patch = None
    is_lettuce = None
    is_meat = None
    result = None
    image_patch = ImagePatch(image)
    is_lettuce = image_patch.exists('lettuce')
    is_meat = image_patch.exists('meat')
    result = bool_to_yesno(or_expr(is_lettuce, is_meat))
    return result