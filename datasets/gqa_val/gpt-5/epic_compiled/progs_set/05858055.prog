def execute_command(image) -> str:
    exists_obj = None
    found_any = None
    image_patch = None
    object_names = None
    result = None
    image_patch = ImagePatch(image)
    object_names = ('fork', 'forks')
    found_any = False

    def _for(name, exists_obj, found_any, image_patch, object_names):
        exists_obj = image_patch.exists(name)

        def _if(exists_obj, found_any, image_patch, object_names):
            found_any = True
            return (exists_obj, found_any, image_patch, object_names)
        exists_obj, found_any, image_patch, object_names = if_stmt(_if, None, exists_obj, (exists_obj, found_any, image_patch, object_names))
        return (exists_obj, found_any, image_patch, object_names)
    exists_obj, found_any, image_patch, object_names = for_stmt(_for, object_names, (exists_obj, found_any, image_patch, object_names))
    result = bool_to_yesno(found_any)
    return result