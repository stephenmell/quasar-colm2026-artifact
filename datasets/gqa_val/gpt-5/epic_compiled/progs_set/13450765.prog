def execute_command(image) -> str:
    image_patch = None
    lamp_patches = None
    result = None
    image_patch = ImagePatch(image)
    lamp_patches = image_patch.find('lamp')

    def _if(image_patch, lamp_patches, result):
        result = image_patch.simple_query('Is there a lamp in this picture that is black?')
        return (image_patch, lamp_patches, result)

    def _else(image_patch, lamp_patches, result):
        result = 'no'

        def _for(lamp_patch, image_patch, lamp_patches, result):

            def _if(image_patch, lamp_patches, result):
                result = 'yes'
                return (image_patch, lamp_patches, result)
            image_patch, lamp_patches, result = if_stmt(_if, None, lamp_patch.verify_property('lamp', 'black'), (image_patch, lamp_patches, result))
            return (image_patch, lamp_patches, result)
        image_patch, lamp_patches, result = for_stmt(_for, lamp_patches, (image_patch, lamp_patches, result))
        return (image_patch, lamp_patches, result)
    image_patch, lamp_patches, result = if_stmt(_if, _else, len(lamp_patches) == 0, (image_patch, lamp_patches, result))
    return result