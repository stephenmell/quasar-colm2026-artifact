def execute_command(image) -> str:
    all_vehicle_patches = None
    center_vehicle_dist2 = None
    center_vehicle_patch = None
    d2 = None
    d2_v = None
    dx = None
    dx_v = None
    dy = None
    dy_v = None
    found_patches = None
    image_patch = None
    img_cx = None
    img_cy = None
    is_white_van = None
    result = None
    van_patches = None
    vehicle_types = None
    white_van_dist2 = None
    white_van_patch = None
    image_patch = ImagePatch(image)
    result = None
    van_patches = image_patch.find('van')
    white_van_patch = None
    white_van_dist2 = None

    def _if(d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch):
        img_cx = image_patch.horizontal_center
        img_cy = image_patch.vertical_center

        def _for(vp, d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch):
            is_white_van = vp.verify_property('van', 'white')

            def _if(d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch):
                dx_v = vp.horizontal_center - img_cx
                dy_v = vp.vertical_center - img_cy
                d2_v = dx_v * dx_v + dy_v * dy_v

                def _if(d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch):
                    white_van_patch = vp
                    white_van_dist2 = d2_v
                    return (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch)
                d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch = if_stmt(_if, None, or_expr(white_van_patch is None, d2_v < white_van_dist2), (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch))
                return (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch)
            d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch = if_stmt(_if, None, is_white_van, (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch))
            return (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch)
        d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch = for_stmt(_for, van_patches, (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch))
        return (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch)
    d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch = if_stmt(_if, None, len(van_patches) > 0, (d2_v, dx_v, dy_v, image_patch, img_cx, img_cy, is_white_van, result, van_patches, white_van_dist2, white_van_patch))
    vehicle_types = ('vehicle', 'car', 'truck', 'bus', 'van', 'suv')
    all_vehicle_patches = ()

    def _for(vt, all_vehicle_patches, d2_v, dx_v, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
        found_patches = image_patch.find(vt)
        all_vehicle_patches = all_vehicle_patches + found_patches
        return (all_vehicle_patches, d2_v, dx_v, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
    all_vehicle_patches, d2_v, dx_v, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = for_stmt(_for, vehicle_types, (all_vehicle_patches, d2_v, dx_v, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))
    center_vehicle_patch = None
    center_vehicle_dist2 = None

    def _if(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
        img_cx = image_patch.horizontal_center
        img_cy = image_patch.vertical_center

        def _for(vp, all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
            dx = vp.horizontal_center - img_cx
            dy = vp.vertical_center - img_cy
            d2 = dx * dx + dy * dy

            def _if(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
                center_vehicle_patch = vp
                center_vehicle_dist2 = d2
                return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
            all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = if_stmt(_if, None, or_expr(center_vehicle_patch is None, d2 < center_vehicle_dist2), (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))
            return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
        all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = for_stmt(_for, all_vehicle_patches, (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))
        return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
    all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = if_stmt(_if, None, len(all_vehicle_patches) > 0, (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))

    def _if(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):

        def _if(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
            result = 'right'
            return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)

        def _else(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
            result = 'left'
            return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
        all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = if_stmt(_if, _else, white_van_patch.horizontal_center > center_vehicle_patch.horizontal_center, (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))
        return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)

    def _else(all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch):
        result = image_patch.simple_query('Is the white van to the right or to the left of the vehicle in the middle of the picture?')
        return (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch)
    all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch = if_stmt(_if, _else, and_expr(white_van_patch is not None, center_vehicle_patch is not None), (all_vehicle_patches, center_vehicle_dist2, center_vehicle_patch, d2, d2_v, dx, dx_v, dy, dy_v, found_patches, image_patch, img_cx, img_cy, is_white_van, result, van_patches, vehicle_types, white_van_dist2, white_van_patch))
    return result