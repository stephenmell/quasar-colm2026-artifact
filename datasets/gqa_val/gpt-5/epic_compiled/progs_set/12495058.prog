def execute_command(image) -> str:
    image_patch = None
    is_tower = None
    is_towers = None
    result = None
    image_patch = ImagePatch(image)
    is_tower = image_patch.exists('tower')
    is_towers = image_patch.exists('towers')
    result = bool_to_yesno(or_expr(is_tower, is_towers))
    return result