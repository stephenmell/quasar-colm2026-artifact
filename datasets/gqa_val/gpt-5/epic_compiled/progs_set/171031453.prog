def execute_command(image) -> str:
    bottle_exists = None
    bottle_patches = None
    image_patch = None
    plate_exists = None
    plate_patches = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'
    plate_exists = image_patch.exists('plate')

    def _if(image_patch, plate_exists, plate_patches, result):
        plate_patches = image_patch.find('plate')

        def _for(plate_patch, image_patch, plate_exists, plate_patches, result):

            def _if(image_patch, plate_exists, plate_patches, result):
                result = 'yes'
                return (image_patch, plate_exists, plate_patches, result)
            image_patch, plate_exists, plate_patches, result = if_stmt(_if, None, plate_patch.verify_property('plate', 'plastic'), (image_patch, plate_exists, plate_patches, result))
            return (image_patch, plate_exists, plate_patches, result)
        image_patch, plate_exists, plate_patches, result = for_stmt(_for, plate_patches, (image_patch, plate_exists, plate_patches, result))
        return (image_patch, plate_exists, plate_patches, result)
    image_patch, plate_exists, plate_patches, result = if_stmt(_if, None, plate_exists, (image_patch, plate_exists, plate_patches, result))
    bottle_exists = image_patch.exists('bottle')

    def _if(bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result):
        bottle_patches = image_patch.find('bottle')

        def _for(bottle_patch, bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result):

            def _if(bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result):
                result = 'yes'
                return (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result)
            bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result = if_stmt(_if, None, bottle_patch.verify_property('bottle', 'plastic'), (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result))
            return (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result)
        bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result = for_stmt(_for, bottle_patches, (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result))
        return (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result)
    bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result = if_stmt(_if, None, bottle_exists, (bottle_exists, bottle_patches, image_patch, plate_exists, plate_patches, result))
    return result