def execute_command(image) -> str:
    dog_patches = None
    image_patch = None
    is_small = None
    result = None
    image_patch = ImagePatch(image)
    dog_patches = image_patch.find('dog')

    def _if(dog_patches, image_patch, is_small, result):
        result = image_patch.simple_query('Do you see any dogs that are not small?')
        return (dog_patches, image_patch, is_small, result)

    def _else(dog_patches, image_patch, is_small, result):
        result = 'no'

        def _for(dog_patch, dog_patches, image_patch, is_small, result):
            is_small = dog_patch.verify_property('dog', 'small')

            def _if(dog_patches, image_patch, is_small, result):
                result = 'yes'
                return (dog_patches, image_patch, is_small, result)
            dog_patches, image_patch, is_small, result = if_stmt(_if, None, not_expr(is_small), (dog_patches, image_patch, is_small, result))
            return (dog_patches, image_patch, is_small, result)
        dog_patches, image_patch, is_small, result = for_stmt(_for, dog_patches, (dog_patches, image_patch, is_small, result))
        return (dog_patches, image_patch, is_small, result)
    dog_patches, image_patch, is_small, result = if_stmt(_if, _else, len(dog_patches) == 0, (dog_patches, image_patch, is_small, result))
    return result