def execute_command(image) -> str:
    image_patch = None
    is_baseball = None
    is_mirror = None
    result = None
    image_patch = ImagePatch(image)
    is_mirror = image_patch.exists('mirror')
    is_baseball = image_patch.exists('baseball')
    result = bool_to_yesno(or_expr(is_mirror, is_baseball))
    return result