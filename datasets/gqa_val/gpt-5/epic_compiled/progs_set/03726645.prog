def execute_command(image) -> str:
    bag_patches = None
    curtain_patches = None
    image_patch = None
    man_left_of_any_curtain = None
    man_patches = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'
    man_patches = image_patch.find('man')
    curtain_patches = image_patch.find('curtain')

    def _if(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
        result = image_patch.simple_query('Are there any bags to the left of the man that is to the left of the curtain?')
        return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)

    def _else(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
        bag_patches = image_patch.find('bag')

        def _if(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
            result = 'no'
            return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)

        def _else(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):

            def _for(man_patch, bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
                man_left_of_any_curtain = False

                def _for(curtain_patch, bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):

                    def _if(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
                        man_left_of_any_curtain = True
                        return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
                    bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = if_stmt(_if, None, man_patch.horizontal_center < curtain_patch.horizontal_center, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
                    return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
                bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = for_stmt(_for, curtain_patches, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))

                def _if(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):

                    def _for(bag_patch, bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):

                        def _if(bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result):
                            result = 'yes'
                            return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
                        bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = if_stmt(_if, None, bag_patch.horizontal_center < man_patch.horizontal_center, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
                        return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
                    bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = for_stmt(_for, bag_patches, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
                    return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
                bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = if_stmt(_if, None, man_left_of_any_curtain, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
                return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
            bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = for_stmt(_for, man_patches, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
            return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
        bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = if_stmt(_if, _else, len(bag_patches) == 0, (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
        return (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result)
    bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result = if_stmt(_if, _else, or_expr(len(man_patches) == 0, len(curtain_patches) == 0), (bag_patches, curtain_patches, image_patch, man_left_of_any_curtain, man_patches, result))
    return result