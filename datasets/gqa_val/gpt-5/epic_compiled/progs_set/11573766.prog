def execute_command(image) -> str:
    image_patch = None
    mug_patches = None
    result = None
    saucer_patches = None
    image_patch = ImagePatch(image)
    saucer_patches = image_patch.find('saucer')

    def _if(image_patch, mug_patches, result, saucer_patches):
        result = image_patch.simple_query('Is that saucer under a mug?')
        return (image_patch, mug_patches, result, saucer_patches)

    def _else(image_patch, mug_patches, result, saucer_patches):
        result = 'no'
        mug_patches = image_patch.find('mug')

        def _for(saucer_patch, image_patch, mug_patches, result, saucer_patches):

            def _for(mug_patch, image_patch, mug_patches, result, saucer_patches):

                def _if(image_patch, mug_patches, result, saucer_patches):
                    result = 'yes'
                    return (image_patch, mug_patches, result, saucer_patches)
                image_patch, mug_patches, result, saucer_patches = if_stmt(_if, None, saucer_patch.vertical_center > mug_patch.vertical_center, (image_patch, mug_patches, result, saucer_patches))
                return (image_patch, mug_patches, result, saucer_patches)
            image_patch, mug_patches, result, saucer_patches = for_stmt(_for, mug_patches, (image_patch, mug_patches, result, saucer_patches))
            return (image_patch, mug_patches, result, saucer_patches)
        image_patch, mug_patches, result, saucer_patches = for_stmt(_for, saucer_patches, (image_patch, mug_patches, result, saucer_patches))
        return (image_patch, mug_patches, result, saucer_patches)
    image_patch, mug_patches, result, saucer_patches = if_stmt(_if, _else, len(saucer_patches) == 0, (image_patch, mug_patches, result, saucer_patches))
    return result