def execute_command(image) -> str:
    area = None
    best_area = None
    best_window = None
    image_patch = None
    result = None
    window_patches = None
    image_patch = ImagePatch(image)
    window_patches = image_patch.find('window')
    result = None

    def _if(area, best_area, best_window, image_patch, result, window_patches):
        result = image_patch.simple_query('What size is that window, large or little?')
        return (area, best_area, best_window, image_patch, result, window_patches)

    def _else(area, best_area, best_window, image_patch, result, window_patches):
        best_window = None
        best_area = -1

        def _for(window_patch, area, best_area, best_window, image_patch, result, window_patches):
            area = window_patch.width * window_patch.height

            def _if(area, best_area, best_window, image_patch, result, window_patches):
                best_area = area
                best_window = window_patch
                return (area, best_area, best_window, image_patch, result, window_patches)
            area, best_area, best_window, image_patch, result, window_patches = if_stmt(_if, None, area > best_area, (area, best_area, best_window, image_patch, result, window_patches))
            return (area, best_area, best_window, image_patch, result, window_patches)
        area, best_area, best_window, image_patch, result, window_patches = for_stmt(_for, window_patches, (area, best_area, best_window, image_patch, result, window_patches))

        def _if(area, best_area, best_window, image_patch, result, window_patches):
            result = best_window.best_text_match(('large', 'little'))
            return (area, best_area, best_window, image_patch, result, window_patches)

        def _else(area, best_area, best_window, image_patch, result, window_patches):
            result = image_patch.simple_query('What size is that window, large or little?')
            return (area, best_area, best_window, image_patch, result, window_patches)
        area, best_area, best_window, image_patch, result, window_patches = if_stmt(_if, _else, best_window, (area, best_area, best_window, image_patch, result, window_patches))
        return (area, best_area, best_window, image_patch, result, window_patches)
    area, best_area, best_window, image_patch, result, window_patches = if_stmt(_if, _else, len(window_patches) == 0, (area, best_area, best_window, image_patch, result, window_patches))
    return result