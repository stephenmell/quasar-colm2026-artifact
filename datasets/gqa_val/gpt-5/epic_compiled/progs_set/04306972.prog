def execute_command(image) -> str:
    image_patch = None
    is_black = None
    result = None
    table_patches = None
    image_patch = ImagePatch(image)
    result = 'no'

    def _if(image_patch, is_black, result, table_patches):
        result = image_patch.simple_query('Are there tables that are not black?')
        return (image_patch, is_black, result, table_patches)

    def _else(image_patch, is_black, result, table_patches):
        table_patches = image_patch.find('table')

        def _for(table_patch, image_patch, is_black, result, table_patches):
            is_black = table_patch.verify_property('table', 'black')

            def _if(image_patch, is_black, result, table_patches):
                result = 'yes'
                return (image_patch, is_black, result, table_patches)
            image_patch, is_black, result, table_patches = if_stmt(_if, None, not_expr(is_black), (image_patch, is_black, result, table_patches))
            return (image_patch, is_black, result, table_patches)
        image_patch, is_black, result, table_patches = for_stmt(_for, table_patches, (image_patch, is_black, result, table_patches))
        return (image_patch, is_black, result, table_patches)
    image_patch, is_black, result, table_patches = if_stmt(_if, _else, not_expr(image_patch.exists('table')), (image_patch, is_black, result, table_patches))
    return result