def execute_command(image) -> str:
    fence_exists = None
    image_patch = None
    result = None
    zebra_exists = None
    image_patch = ImagePatch(image)
    fence_exists = image_patch.exists('fence')
    zebra_exists = image_patch.exists('zebra')
    result = bool_to_yesno(or_expr(fence_exists, zebra_exists))
    return result