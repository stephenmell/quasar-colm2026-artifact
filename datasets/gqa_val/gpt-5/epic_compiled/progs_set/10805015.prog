def execute_command(image) -> str:
    image_patch = None
    is_bus = None
    is_truck = None
    result = None
    image_patch = ImagePatch(image)
    is_truck = image_patch.exists('truck')
    is_bus = image_patch.exists('bus')
    result = bool_to_yesno(or_expr(is_truck, is_bus))
    return result