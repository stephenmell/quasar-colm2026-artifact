def execute_command(image) -> str:
    has_skateboard = None
    has_skis = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_skateboard = image_patch.exists('skateboard')
    has_skis = or_expr(image_patch.exists('skis'), image_patch.exists('ski'))
    result = bool_to_yesno(and_expr(has_skateboard, has_skis))
    return result