def execute_command(image) -> str:
    image_patch = None
    is_blue = None
    is_calm = None
    result = None
    water_patches = None
    image_patch = ImagePatch(image)
    water_patches = image_patch.find('water')

    def _if(image_patch, is_blue, is_calm, result, water_patches):
        result = image_patch.simple_query('Does the blue water look calm?')
        return (image_patch, is_blue, is_calm, result, water_patches)

    def _else(image_patch, is_blue, is_calm, result, water_patches):
        result = 'no'

        def _for(water_patch, image_patch, is_blue, is_calm, result, water_patches):
            is_blue = water_patch.verify_property('water', 'blue')
            is_calm = water_patch.verify_property('water', 'calm')

            def _if(image_patch, is_blue, is_calm, result, water_patches):
                result = 'yes'
                return (image_patch, is_blue, is_calm, result, water_patches)
            image_patch, is_blue, is_calm, result, water_patches = if_stmt(_if, None, and_expr(is_blue, is_calm), (image_patch, is_blue, is_calm, result, water_patches))
            return (image_patch, is_blue, is_calm, result, water_patches)
        image_patch, is_blue, is_calm, result, water_patches = for_stmt(_for, water_patches, (image_patch, is_blue, is_calm, result, water_patches))
        return (image_patch, is_blue, is_calm, result, water_patches)
    image_patch, is_blue, is_calm, result, water_patches = if_stmt(_if, _else, len(water_patches) == 0, (image_patch, is_blue, is_calm, result, water_patches))
    return result