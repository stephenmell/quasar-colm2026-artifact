def execute_command(image) -> str:
    image_patch = None
    result = None
    surfboard_patches = None
    image_patch = ImagePatch(image)
    surfboard_patches = image_patch.find('surfboard')

    def _if(image_patch, result, surfboard_patches):
        result = image_patch.simple_query('Is the surfboard blue?')
        return (image_patch, result, surfboard_patches)

    def _else(image_patch, result, surfboard_patches):
        result = 'no'

        def _for(surfboard_patch, image_patch, result, surfboard_patches):

            def _if(image_patch, result, surfboard_patches):
                result = 'yes'
                return (image_patch, result, surfboard_patches)
            image_patch, result, surfboard_patches = if_stmt(_if, None, surfboard_patch.verify_property('surfboard', 'blue'), (image_patch, result, surfboard_patches))
            return (image_patch, result, surfboard_patches)
        image_patch, result, surfboard_patches = for_stmt(_for, surfboard_patches, (image_patch, result, surfboard_patches))
        return (image_patch, result, surfboard_patches)
    image_patch, result, surfboard_patches = if_stmt(_if, _else, len(surfboard_patches) == 0, (image_patch, result, surfboard_patches))
    return result