def execute_command(image) -> str:
    image_patch = None
    result = None
    sink_patches = None
    image_patch = ImagePatch(image)
    sink_patches = image_patch.find('sink')

    def _if(image_patch, result, sink_patches):
        result = image_patch.simple_query('Does that sink have brown color?')
        return (image_patch, result, sink_patches)

    def _else(image_patch, result, sink_patches):
        result = bool_to_yesno(sink_patches[0].verify_property('sink', 'brown'))
        return (image_patch, result, sink_patches)
    image_patch, result, sink_patches = if_stmt(_if, _else, len(sink_patches) == 0, (image_patch, result, sink_patches))
    return result