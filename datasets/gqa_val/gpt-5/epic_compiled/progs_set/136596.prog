def execute_command(image) -> str:
    has_lamp = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_lamp = or_expr(image_patch.exists('lamp'), image_patch.exists('lamps'))

    def _if(has_lamp, image_patch, result):
        result = 'yes'
        return (has_lamp, image_patch, result)

    def _else(has_lamp, image_patch, result):
        result = image_patch.simple_query('Do you see lamps in the image?')
        return (has_lamp, image_patch, result)
    has_lamp, image_patch, result = if_stmt(_if, _else, has_lamp, (has_lamp, image_patch, result))
    return result