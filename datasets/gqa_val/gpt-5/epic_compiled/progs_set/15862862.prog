def execute_command(image) -> str:
    has_person_to_right = None
    image_patch = None
    is_wearing_mask = None
    masked_person_patch = None
    person_patches = None
    question = None
    result = None
    image_patch = ImagePatch(image)
    question = 'Do you see people to the right of the person that is wearing a mask?'
    person_patches = image_patch.find('person')

    def _if(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
        result = image_patch.simple_query(question)
        return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)

    def _else(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
        masked_person_patch = None

        def _for(person_patch, image_patch, is_wearing_mask, masked_person_patch, person_patches, question):

            def _if(image_patch, is_wearing_mask, masked_person_patch, person_patches, question):
                is_wearing_mask = person_patch.simple_query('Is the person wearing a mask?') == 'yes'

                def _if(image_patch, is_wearing_mask, masked_person_patch, person_patches, question):
                    masked_person_patch = person_patch
                    return (image_patch, is_wearing_mask, masked_person_patch, person_patches, question)
                image_patch, is_wearing_mask, masked_person_patch, person_patches, question = if_stmt(_if, None, is_wearing_mask, (image_patch, is_wearing_mask, masked_person_patch, person_patches, question))
                return (image_patch, is_wearing_mask, masked_person_patch, person_patches, question)
            image_patch, is_wearing_mask, masked_person_patch, person_patches, question = if_stmt(_if, None, masked_person_patch is None, (image_patch, is_wearing_mask, masked_person_patch, person_patches, question))
            return (image_patch, is_wearing_mask, masked_person_patch, person_patches, question)
        image_patch, is_wearing_mask, masked_person_patch, person_patches, question = for_stmt(_for, person_patches, (image_patch, is_wearing_mask, masked_person_patch, person_patches, question))

        def _if(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
            result = image_patch.simple_query(question)
            return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)

        def _else(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
            has_person_to_right = False

            def _for(other_patch, has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question):

                def _if(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question):
                    has_person_to_right = True
                    return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question)
                has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question = if_stmt(_if, None, other_patch.horizontal_center > masked_person_patch.horizontal_center, (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question))
                return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question)
            has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question = for_stmt(_for, person_patches, (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question))

            def _if(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
                result = 'yes'
                return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)

            def _else(has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result):
                result = 'no'
                return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)
            has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result = if_stmt(_if, _else, has_person_to_right, (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result))
            return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)
        has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result = if_stmt(_if, _else, not_expr(masked_person_patch), (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result))
        return (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result)
    has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result = if_stmt(_if, _else, len(person_patches) == 0, (has_person_to_right, image_patch, is_wearing_mask, masked_person_patch, person_patches, question, result))
    return result