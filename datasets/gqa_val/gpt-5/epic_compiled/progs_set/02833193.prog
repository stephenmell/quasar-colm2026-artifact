def execute_command(image) -> str:
    has_bicycle = None
    has_box = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_bicycle = image_patch.exists('bicycle')
    has_box = image_patch.exists('box')
    result = bool_to_yesno(or_expr(has_bicycle, has_box))
    return result