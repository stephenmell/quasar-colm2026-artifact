def execute_command(image) -> str:
    image_patch = None
    result = None
    sky_patches = None
    image_patch = ImagePatch(image)
    sky_patches = image_patch.find('sky')

    def _if(image_patch, result, sky_patches):
        result = image_patch.simple_query('Does the sky have blue color?')
        return (image_patch, result, sky_patches)

    def _else(image_patch, result, sky_patches):
        result = 'no'

        def _for(sky_patch, image_patch, result, sky_patches):

            def _if(image_patch, result, sky_patches):
                result = 'yes'
                return (image_patch, result, sky_patches)
            image_patch, result, sky_patches = if_stmt(_if, None, sky_patch.verify_property('sky', 'blue'), (image_patch, result, sky_patches))
            return (image_patch, result, sky_patches)
        image_patch, result, sky_patches = for_stmt(_for, sky_patches, (image_patch, result, sky_patches))
        return (image_patch, result, sky_patches)
    image_patch, result, sky_patches = if_stmt(_if, _else, len(sky_patches) == 0, (image_patch, result, sky_patches))
    return result