def execute_command(image) -> str:
    image_patch = None
    result = None
    table_patches = None
    image_patch = ImagePatch(image)
    result = 'no'

    def _if(image_patch, result, table_patches):
        result = 'yes'
        return (image_patch, result, table_patches)

    def _else(image_patch, result, table_patches):
        table_patches = image_patch.find('table')

        def _if(image_patch, result, table_patches):
            result = image_patch.simple_query('Are there round tables in the image?')
            return (image_patch, result, table_patches)

        def _else(image_patch, result, table_patches):

            def _for(table_patch, image_patch, result, table_patches):

                def _if(image_patch, result, table_patches):
                    result = 'yes'
                    return (image_patch, result, table_patches)
                image_patch, result, table_patches = if_stmt(_if, None, table_patch.verify_property('table', 'round'), (image_patch, result, table_patches))
                return (image_patch, result, table_patches)
            image_patch, result, table_patches = for_stmt(_for, table_patches, (image_patch, result, table_patches))
            return (image_patch, result, table_patches)
        image_patch, result, table_patches = if_stmt(_if, _else, len(table_patches) == 0, (image_patch, result, table_patches))
        return (image_patch, result, table_patches)
    image_patch, result, table_patches = if_stmt(_if, _else, image_patch.exists('round table'), (image_patch, result, table_patches))
    return result