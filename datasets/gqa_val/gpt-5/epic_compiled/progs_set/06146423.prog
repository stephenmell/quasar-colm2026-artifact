def execute_command(image) -> str:
    image_patch = None
    is_bench = None
    is_cage = None
    result = None
    image_patch = ImagePatch(image)
    is_bench = or_expr(image_patch.exists('bench'), image_patch.exists('benches'))
    is_cage = or_expr(image_patch.exists('cage'), image_patch.exists('cages'))
    result = bool_to_yesno(or_expr(is_bench, is_cage))
    return result