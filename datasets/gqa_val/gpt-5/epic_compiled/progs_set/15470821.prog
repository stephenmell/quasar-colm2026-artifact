def execute_command(image) -> str:
    image_patch = None
    is_wearing_hat = None
    knife_patches = None
    person_patches = None
    result = None
    image_patch = ImagePatch(image)
    knife_patches = image_patch.find('knife')

    def _if(image_patch, is_wearing_hat, knife_patches, person_patches, result):
        result = image_patch.simple_query('Is the person to the left of the knife wearing a hat?')
        return (image_patch, is_wearing_hat, knife_patches, person_patches, result)

    def _else(image_patch, is_wearing_hat, knife_patches, person_patches, result):
        result = 'no'
        person_patches = image_patch.find('person')

        def _for(knife_patch, image_patch, is_wearing_hat, knife_patches, person_patches, result):

            def _for(person_patch, image_patch, is_wearing_hat, knife_patches, person_patches, result):

                def _if(image_patch, is_wearing_hat, knife_patches, person_patches, result):
                    is_wearing_hat = person_patch.simple_query('Is the person wearing a hat?') == 'yes'

                    def _if(image_patch, is_wearing_hat, knife_patches, person_patches, result):
                        result = 'yes'
                        return (image_patch, is_wearing_hat, knife_patches, person_patches, result)
                    image_patch, is_wearing_hat, knife_patches, person_patches, result = if_stmt(_if, None, is_wearing_hat, (image_patch, is_wearing_hat, knife_patches, person_patches, result))
                    return (image_patch, is_wearing_hat, knife_patches, person_patches, result)
                image_patch, is_wearing_hat, knife_patches, person_patches, result = if_stmt(_if, None, person_patch.horizontal_center < knife_patch.horizontal_center, (image_patch, is_wearing_hat, knife_patches, person_patches, result))
                return (image_patch, is_wearing_hat, knife_patches, person_patches, result)
            image_patch, is_wearing_hat, knife_patches, person_patches, result = for_stmt(_for, person_patches, (image_patch, is_wearing_hat, knife_patches, person_patches, result))
            return (image_patch, is_wearing_hat, knife_patches, person_patches, result)
        image_patch, is_wearing_hat, knife_patches, person_patches, result = for_stmt(_for, knife_patches, (image_patch, is_wearing_hat, knife_patches, person_patches, result))
        return (image_patch, is_wearing_hat, knife_patches, person_patches, result)
    image_patch, is_wearing_hat, knife_patches, person_patches, result = if_stmt(_if, _else, len(knife_patches) == 0, (image_patch, is_wearing_hat, knife_patches, person_patches, result))
    return result