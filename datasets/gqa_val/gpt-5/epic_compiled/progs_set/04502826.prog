def execute_command(image) -> str:
    image_patch = None
    is_collar = None
    is_collars = None
    result = None
    image_patch = ImagePatch(image)
    is_collar = image_patch.exists('collar')
    is_collars = image_patch.exists('collars')
    result = bool_to_yesno(or_expr(is_collar, is_collars))
    return result