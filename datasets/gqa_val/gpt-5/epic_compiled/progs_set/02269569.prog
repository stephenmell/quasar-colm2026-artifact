def execute_command(image) -> str:
    answer = None
    image_patch = None
    man_patches = None
    result = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(answer, image_patch, man_patches, result):
        result = image_patch.simple_query('Is the man wearing trousers?')
        return (answer, image_patch, man_patches, result)

    def _else(answer, image_patch, man_patches, result):
        result = 'no'

        def _for(man_patch, answer, image_patch, man_patches, result):
            answer = man_patch.simple_query('Is the man wearing trousers?')

            def _if(answer, image_patch, man_patches, result):
                result = 'yes'
                return (answer, image_patch, man_patches, result)
            answer, image_patch, man_patches, result = if_stmt(_if, None, answer == 'yes', (answer, image_patch, man_patches, result))
            return (answer, image_patch, man_patches, result)
        answer, image_patch, man_patches, result = for_stmt(_for, man_patches, (answer, image_patch, man_patches, result))
        return (answer, image_patch, man_patches, result)
    answer, image_patch, man_patches, result = if_stmt(_if, _else, len(man_patches) == 0, (answer, image_patch, man_patches, result))
    return result