def execute_command(image) -> str:
    has_helmet = None
    has_skateboard = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_skateboard = image_patch.exists('skateboard')
    has_helmet = image_patch.exists('helmet')
    result = bool_to_yesno(or_expr(has_skateboard, has_helmet))
    return result