def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_house = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_house = image_patch.exists('house')
    result = bool_to_yesno(or_expr(is_fence, is_house))
    return result