def execute_command(image) -> str:
    ground_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    ground_patches = image_patch.find('ground')

    def _if(ground_patches, image_patch, result):
        result = image_patch.simple_query('Is the ground sandy?')
        return (ground_patches, image_patch, result)

    def _else(ground_patches, image_patch, result):
        result = 'no'

        def _for(ground_patch, ground_patches, image_patch, result):

            def _if(ground_patches, image_patch, result):
                result = 'yes'
                return (ground_patches, image_patch, result)
            ground_patches, image_patch, result = if_stmt(_if, None, ground_patch.verify_property('ground', 'sandy'), (ground_patches, image_patch, result))
            return (ground_patches, image_patch, result)
        ground_patches, image_patch, result = for_stmt(_for, ground_patches, (ground_patches, image_patch, result))
        return (ground_patches, image_patch, result)
    ground_patches, image_patch, result = if_stmt(_if, _else, len(ground_patches) == 0, (ground_patches, image_patch, result))
    return result