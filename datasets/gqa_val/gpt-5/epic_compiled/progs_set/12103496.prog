def execute_command(image) -> str:
    image_center = None
    image_patch = None
    result = None
    stove_patches = None
    image_patch = ImagePatch(image)
    stove_patches = image_patch.find('stove')

    def _if(image_center, image_patch, result, stove_patches):
        result = image_patch.simple_query('Is the stove on the left side?')
        return (image_center, image_patch, result, stove_patches)

    def _else(image_center, image_patch, result, stove_patches):
        result = 'no'
        image_center = image_patch.horizontal_center

        def _for(stove_patch, image_center, image_patch, result, stove_patches):

            def _if(image_center, image_patch, result, stove_patches):
                result = 'yes'
                return (image_center, image_patch, result, stove_patches)
            image_center, image_patch, result, stove_patches = if_stmt(_if, None, stove_patch.horizontal_center < image_center, (image_center, image_patch, result, stove_patches))
            return (image_center, image_patch, result, stove_patches)
        image_center, image_patch, result, stove_patches = for_stmt(_for, stove_patches, (image_center, image_patch, result, stove_patches))
        return (image_center, image_patch, result, stove_patches)
    image_center, image_patch, result, stove_patches = if_stmt(_if, _else, len(stove_patches) == 0, (image_center, image_patch, result, stove_patches))
    return result