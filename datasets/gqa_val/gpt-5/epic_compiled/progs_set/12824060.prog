def execute_command(image) -> str:
    helmets_exist = None
    image_patch = None
    result = None
    trays_exist = None
    image_patch = ImagePatch(image)
    trays_exist = image_patch.exists('tray')
    helmets_exist = image_patch.exists('helmet')
    result = bool_to_yesno(or_expr(trays_exist, helmets_exist))
    return result