def execute_command(image) -> str:
    has_tv = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_tv = image_patch.exists('television')

    def _if(has_tv, image_patch):
        has_tv = image_patch.exists('tv')
        return (has_tv, image_patch)
    has_tv, image_patch = if_stmt(_if, None, not_expr(has_tv), (has_tv, image_patch))
    result = bool_to_yesno(has_tv)
    return result