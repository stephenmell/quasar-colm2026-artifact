def execute_command(image) -> str:
    image_patch = None
    is_in_front_answer = None
    is_white_umbrella = None
    person_in_front_patch = None
    person_patches = None
    ref_statue = None
    result = None
    statue_patches = None
    umbrella_patches = None
    white_umbrella_patch = None
    image_patch = ImagePatch(image)
    result = None
    white_umbrella_patch = None
    umbrella_patches = image_patch.find('umbrella')

    def _for(umbrella_patch, image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch):
        is_white_umbrella = umbrella_patch.verify_property('umbrella', 'white')

        def _if(image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch):
            white_umbrella_patch = umbrella_patch
            return (image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch)
        image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch = if_stmt(_if, None, and_expr(is_white_umbrella, white_umbrella_patch is None), (image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch))
        return (image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch)
    image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch = for_stmt(_for, umbrella_patches, (image_patch, is_white_umbrella, result, umbrella_patches, white_umbrella_patch))
    person_in_front_patch = None
    person_patches = image_patch.find('person')
    statue_patches = image_patch.find('statue')

    def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):

        def _for(person_patch, image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch):
            is_in_front_answer = person_patch.simple_query('Is the person in front of the statue?')

            def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch):
                person_in_front_patch = person_patch
                return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch)
            image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, None, and_expr(is_in_front_answer == 'yes', person_in_front_patch is None), (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch))
            return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch)
        image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch = for_stmt(_for, person_patches, (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, result, statue_patches, umbrella_patches, white_umbrella_patch))

        def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):
            ref_statue = statue_patches[0]

            def _for(person_patch, image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):

                def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):
                    person_in_front_patch = person_patch
                    return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
                image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, None, and_expr(person_patch.vertical_center > ref_statue.vertical_center, person_in_front_patch is None), (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))
                return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
            image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = for_stmt(_for, person_patches, (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))
            return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
        image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, None, person_in_front_patch is None, (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))
        return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
    image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, None, and_expr(len(person_patches) > 0, len(statue_patches) > 0), (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))

    def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):
        result = image_patch.simple_query('Is the white umbrella to the right or to the left of the person that is in front of the statue?')
        return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)

    def _else(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):

        def _if(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):
            result = 'right'
            return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)

        def _else(image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch):
            result = 'left'
            return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
        image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, _else, white_umbrella_patch.horizontal_center > person_in_front_patch.horizontal_center, (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))
        return (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch)
    image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch = if_stmt(_if, _else, or_expr(white_umbrella_patch is None, person_in_front_patch is None), (image_patch, is_in_front_answer, is_white_umbrella, person_in_front_patch, person_patches, ref_statue, result, statue_patches, umbrella_patches, white_umbrella_patch))
    return result