def execute_command(image) -> str:
    fence_exists = None
    image_patch = None
    result = None
    surfer_exists = None
    image_patch = ImagePatch(image)
    fence_exists = image_patch.exists('fence')
    surfer_exists = image_patch.exists('surfer')
    result = bool_to_yesno(or_expr(fence_exists, surfer_exists))
    return result