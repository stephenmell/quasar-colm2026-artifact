def execute_command(image) -> str:
    image_patch = None
    is_gray = None
    jacket_patches = None
    result = None
    image_patch = ImagePatch(image)
    jacket_patches = image_patch.find('jacket')

    def _if(image_patch, is_gray, jacket_patches, result):
        result = image_patch.simple_query('Does the jacket look gray?')
        return (image_patch, is_gray, jacket_patches, result)

    def _else(image_patch, is_gray, jacket_patches, result):
        is_gray = False

        def _for(jacket_patch, image_patch, is_gray, jacket_patches):

            def _if(image_patch, is_gray, jacket_patches):
                is_gray = True
                return (image_patch, is_gray, jacket_patches)
            image_patch, is_gray, jacket_patches = if_stmt(_if, None, jacket_patch.verify_property('jacket', 'gray'), (image_patch, is_gray, jacket_patches))
            return (image_patch, is_gray, jacket_patches)
        image_patch, is_gray, jacket_patches = for_stmt(_for, jacket_patches, (image_patch, is_gray, jacket_patches))
        result = bool_to_yesno(is_gray)
        return (image_patch, is_gray, jacket_patches, result)
    image_patch, is_gray, jacket_patches, result = if_stmt(_if, _else, len(jacket_patches) == 0, (image_patch, is_gray, jacket_patches, result))
    return result