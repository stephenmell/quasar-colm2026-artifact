def execute_command(image) -> str:
    has_bottle = None
    has_cup = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_bottle = image_patch.exists('bottle')
    has_cup = image_patch.exists('cup')
    result = bool_to_yesno(or_expr(has_bottle, has_cup))
    return result