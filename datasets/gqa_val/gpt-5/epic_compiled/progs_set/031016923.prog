def execute_command(image) -> str:
    image_patch = None
    is_bed = None
    is_entertainment_center = None
    result = None
    image_patch = ImagePatch(image)
    is_bed = image_patch.exists('bed')
    is_entertainment_center = image_patch.exists('entertainment center')
    result = bool_to_yesno(or_expr(is_bed, is_entertainment_center))
    return result