def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_ostrich = None
    result = None
    image_patch = ImagePatch(image)
    is_ostrich = image_patch.exists('ostrich')
    is_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(is_ostrich, is_fence))
    return result