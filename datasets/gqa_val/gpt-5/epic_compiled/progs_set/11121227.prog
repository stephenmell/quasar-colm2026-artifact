def execute_command(image) -> str:
    image_patch = None
    is_napkin = None
    is_plate = None
    result = None
    image_patch = ImagePatch(image)
    is_plate = image_patch.exists('plate')
    is_napkin = image_patch.exists('napkin')
    result = bool_to_yesno(and_expr(is_plate, is_napkin))
    return result