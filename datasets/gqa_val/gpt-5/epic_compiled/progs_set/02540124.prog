def execute_command(image) -> str:
    image_patch = None
    result = None
    shelf_brown = None
    shelf_patches = None
    table_brown = None
    table_patches = None
    image_patch = ImagePatch(image)
    shelf_patches = image_patch.find('shelf')
    table_patches = image_patch.find('table')

    def _if(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):
        result = image_patch.simple_query('Which kind of furniture is brown, the shelf or the table?')
        return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)

    def _else(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):
        shelf_brown = False

        def _for(shelf_patch, image_patch, shelf_brown, shelf_patches, table_patches):

            def _if(image_patch, shelf_brown, shelf_patches, table_patches):
                shelf_brown = True
                return (image_patch, shelf_brown, shelf_patches, table_patches)
            image_patch, shelf_brown, shelf_patches, table_patches = if_stmt(_if, None, shelf_patch.verify_property('shelf', 'brown'), (image_patch, shelf_brown, shelf_patches, table_patches))
            return (image_patch, shelf_brown, shelf_patches, table_patches)
        image_patch, shelf_brown, shelf_patches, table_patches = for_stmt(_for, shelf_patches, (image_patch, shelf_brown, shelf_patches, table_patches))
        table_brown = False

        def _for(table_patch, image_patch, shelf_brown, shelf_patches, table_brown, table_patches):

            def _if(image_patch, shelf_brown, shelf_patches, table_brown, table_patches):
                table_brown = True
                return (image_patch, shelf_brown, shelf_patches, table_brown, table_patches)
            image_patch, shelf_brown, shelf_patches, table_brown, table_patches = if_stmt(_if, None, table_patch.verify_property('table', 'brown'), (image_patch, shelf_brown, shelf_patches, table_brown, table_patches))
            return (image_patch, shelf_brown, shelf_patches, table_brown, table_patches)
        image_patch, shelf_brown, shelf_patches, table_brown, table_patches = for_stmt(_for, table_patches, (image_patch, shelf_brown, shelf_patches, table_brown, table_patches))

        def _if(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):
            result = 'shelf'
            return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)

        def _else(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):

            def _if(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):
                result = 'table'
                return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)

            def _else(image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches):
                result = image_patch.simple_query('Which kind of furniture is brown, the shelf or the table?')
                return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)
            image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches = if_stmt(_if, _else, and_expr(table_brown, not shelf_brown), (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches))
            return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)
        image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches = if_stmt(_if, _else, and_expr(shelf_brown, not table_brown), (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches))
        return (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches)
    image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches = if_stmt(_if, _else, and_expr(len(shelf_patches) == 0, len(table_patches) == 0), (image_patch, result, shelf_brown, shelf_patches, table_brown, table_patches))
    return result