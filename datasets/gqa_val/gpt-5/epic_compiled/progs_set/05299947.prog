def execute_command(image) -> str:
    chair_patches = None
    image_patch = None
    result = None
    umbrella_patches = None
    image_patch = ImagePatch(image)
    chair_patches = image_patch.find('chair')

    def _if(chair_patches, image_patch, result, umbrella_patches):
        result = image_patch.simple_query('Are the chairs to the right of an umbrella?')
        return (chair_patches, image_patch, result, umbrella_patches)

    def _else(chair_patches, image_patch, result, umbrella_patches):
        umbrella_patches = image_patch.find('umbrella')

        def _if(chair_patches, image_patch, result, umbrella_patches):
            result = 'no'
            return (chair_patches, image_patch, result, umbrella_patches)

        def _else(chair_patches, image_patch, result, umbrella_patches):
            result = 'no'

            def _for(chair_patch, chair_patches, image_patch, result, umbrella_patches):

                def _for(umbrella_patch, chair_patches, image_patch, result, umbrella_patches):

                    def _if(chair_patches, image_patch, result, umbrella_patches):
                        result = 'yes'
                        return (chair_patches, image_patch, result, umbrella_patches)
                    chair_patches, image_patch, result, umbrella_patches = if_stmt(_if, None, chair_patch.horizontal_center > umbrella_patch.horizontal_center, (chair_patches, image_patch, result, umbrella_patches))
                    return (chair_patches, image_patch, result, umbrella_patches)
                chair_patches, image_patch, result, umbrella_patches = for_stmt(_for, umbrella_patches, (chair_patches, image_patch, result, umbrella_patches))
                return (chair_patches, image_patch, result, umbrella_patches)
            chair_patches, image_patch, result, umbrella_patches = for_stmt(_for, chair_patches, (chair_patches, image_patch, result, umbrella_patches))
            return (chair_patches, image_patch, result, umbrella_patches)
        chair_patches, image_patch, result, umbrella_patches = if_stmt(_if, _else, len(umbrella_patches) == 0, (chair_patches, image_patch, result, umbrella_patches))
        return (chair_patches, image_patch, result, umbrella_patches)
    chair_patches, image_patch, result, umbrella_patches = if_stmt(_if, _else, len(chair_patches) == 0, (chair_patches, image_patch, result, umbrella_patches))
    return result