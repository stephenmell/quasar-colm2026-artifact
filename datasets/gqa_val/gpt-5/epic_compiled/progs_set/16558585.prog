def execute_command(image) -> str:
    image_patch = None
    is_bridge = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_bridge = image_patch.exists('bridge')
    result = bool_to_yesno(and_expr(is_fence, is_bridge))
    return result