def execute_command(image) -> str:
    image_patch = None
    is_sitting_in_chair = None
    man_patches = None
    result = None
    sitting_man_patch = None
    speaker_patches = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
        result = image_patch.simple_query('Is there a speaker to the left of the man that is sitting in the chair?')
        return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)

    def _else(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
        sitting_man_patch = None

        def _for(man_patch, image_patch, is_sitting_in_chair, man_patches, sitting_man_patch):
            is_sitting_in_chair = man_patch.simple_query('Is the man sitting in the chair?') == 'yes'

            def _if(image_patch, is_sitting_in_chair, man_patches, sitting_man_patch):
                sitting_man_patch = man_patch
                return (image_patch, is_sitting_in_chair, man_patches, sitting_man_patch)
            image_patch, is_sitting_in_chair, man_patches, sitting_man_patch = if_stmt(_if, None, is_sitting_in_chair, (image_patch, is_sitting_in_chair, man_patches, sitting_man_patch))
            return (image_patch, is_sitting_in_chair, man_patches, sitting_man_patch)
        image_patch, is_sitting_in_chair, man_patches, sitting_man_patch = for_stmt(_for, man_patches, (image_patch, is_sitting_in_chair, man_patches, sitting_man_patch))

        def _if(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
            result = image_patch.simple_query('Is there a speaker to the left of the man that is sitting in the chair?')
            return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)

        def _else(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
            speaker_patches = image_patch.find('speaker')

            def _if(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
                result = 'no'
                return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)

            def _else(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
                result = 'no'

                def _for(speaker_patch, image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):

                    def _if(image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches):
                        result = 'yes'
                        return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)
                    image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches = if_stmt(_if, None, speaker_patch.horizontal_center < sitting_man_patch.horizontal_center, (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches))
                    return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)
                image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches = for_stmt(_for, speaker_patches, (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches))
                return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)
            image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches = if_stmt(_if, _else, len(speaker_patches) == 0, (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches))
            return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)
        image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches = if_stmt(_if, _else, not_expr(sitting_man_patch), (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches))
        return (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches)
    image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches = if_stmt(_if, _else, len(man_patches) == 0, (image_patch, is_sitting_in_chair, man_patches, result, sitting_man_patch, speaker_patches))
    return result