def execute_command(image) -> str:
    image_patch = None
    mug_patches = None
    plate_patches = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'

    def _if(image_patch, plate_patches, result):
        plate_patches = image_patch.find('plate')

        def _for(plate_patch, image_patch, plate_patches, result):

            def _if(image_patch, plate_patches, result):
                result = 'yes'
                return (image_patch, plate_patches, result)
            image_patch, plate_patches, result = if_stmt(_if, None, plate_patch.verify_property('plate', 'white'), (image_patch, plate_patches, result))
            return (image_patch, plate_patches, result)
        image_patch, plate_patches, result = for_stmt(_for, plate_patches, (image_patch, plate_patches, result))
        return (image_patch, plate_patches, result)
    image_patch, plate_patches, result = if_stmt(_if, None, image_patch.exists('plate'), (image_patch, plate_patches, result))

    def _if(image_patch, mug_patches, plate_patches, result):
        mug_patches = image_patch.find('mug')

        def _for(mug_patch, image_patch, mug_patches, plate_patches, result):

            def _if(image_patch, mug_patches, plate_patches, result):
                result = 'yes'
                return (image_patch, mug_patches, plate_patches, result)
            image_patch, mug_patches, plate_patches, result = if_stmt(_if, None, mug_patch.verify_property('mug', 'white'), (image_patch, mug_patches, plate_patches, result))
            return (image_patch, mug_patches, plate_patches, result)
        image_patch, mug_patches, plate_patches, result = for_stmt(_for, mug_patches, (image_patch, mug_patches, plate_patches, result))
        return (image_patch, mug_patches, plate_patches, result)
    image_patch, mug_patches, plate_patches, result = if_stmt(_if, None, image_patch.exists('mug'), (image_patch, mug_patches, plate_patches, result))
    return result