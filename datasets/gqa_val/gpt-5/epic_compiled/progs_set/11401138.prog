def execute_command(image) -> str:
    bowl_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    bowl_patches = image_patch.find('bowl')

    def _if(bowl_patches, image_patch, result):
        result = image_patch.simple_query('Which side is the bowl on?')
        return (bowl_patches, image_patch, result)

    def _else(bowl_patches, image_patch, result):

        def _if(bowl_patches, image_patch, result):
            result = 'left'
            return (bowl_patches, image_patch, result)

        def _else(bowl_patches, image_patch, result):
            result = 'right'
            return (bowl_patches, image_patch, result)
        bowl_patches, image_patch, result = if_stmt(_if, _else, bowl_patches[0].horizontal_center < image_patch.horizontal_center, (bowl_patches, image_patch, result))
        return (bowl_patches, image_patch, result)
    bowl_patches, image_patch, result = if_stmt(_if, _else, len(bowl_patches) == 0, (bowl_patches, image_patch, result))
    return result