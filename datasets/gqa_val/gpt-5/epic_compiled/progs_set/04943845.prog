def execute_command(image) -> str:
    image_patch = None
    result = None
    uniform_patches = None
    image_patch = ImagePatch(image)
    uniform_patches = image_patch.find('uniform')

    def _if(image_patch, result, uniform_patches):
        result = image_patch.simple_query('Is the uniform blue?')
        return (image_patch, result, uniform_patches)

    def _else(image_patch, result, uniform_patches):
        result = 'no'

        def _for(uniform_patch, image_patch, result, uniform_patches):

            def _if(image_patch, result, uniform_patches):
                result = 'yes'
                return (image_patch, result, uniform_patches)
            image_patch, result, uniform_patches = if_stmt(_if, None, uniform_patch.verify_property('uniform', 'blue'), (image_patch, result, uniform_patches))
            return (image_patch, result, uniform_patches)
        image_patch, result, uniform_patches = for_stmt(_for, uniform_patches, (image_patch, result, uniform_patches))
        return (image_patch, result, uniform_patches)
    image_patch, result, uniform_patches = if_stmt(_if, _else, len(uniform_patches) == 0, (image_patch, result, uniform_patches))
    return result