def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_suitcase = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_suitcase = image_patch.exists('suitcase')
    result = bool_to_yesno(or_expr(is_fence, is_suitcase))
    return result