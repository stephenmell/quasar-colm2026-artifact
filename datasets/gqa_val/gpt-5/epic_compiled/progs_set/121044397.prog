def execute_command(image) -> str:
    floor_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    floor_patches = image_patch.find('floor')

    def _if(floor_patches, image_patch, result):
        result = image_patch.simple_query('Is the floor white or brown?')
        return (floor_patches, image_patch, result)

    def _else(floor_patches, image_patch, result):
        result = floor_patches[0].best_text_match(('white', 'brown'))
        return (floor_patches, image_patch, result)
    floor_patches, image_patch, result = if_stmt(_if, _else, len(floor_patches) == 0, (floor_patches, image_patch, result))
    return result