def execute_command(image) -> str:
    image_patch = None
    is_boy = None
    is_hat = None
    result = None
    image_patch = ImagePatch(image)
    is_hat = or_expr(image_patch.exists('hat'), image_patch.exists('hats'))
    is_boy = or_expr(image_patch.exists('boy'), image_patch.exists('boys'))
    result = bool_to_yesno(or_expr(is_hat, is_boy))
    return result