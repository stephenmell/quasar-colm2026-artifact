def execute_command(image) -> str:
    image_patch = None
    is_bag = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_bag = image_patch.exists('bag')
    is_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(is_bag, is_fence))
    return result