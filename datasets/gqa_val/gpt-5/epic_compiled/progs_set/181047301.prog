def execute_command(image) -> str:
    image_patch = None
    is_green = None
    pasture_patches = None
    result = None
    image_patch = ImagePatch(image)
    pasture_patches = image_patch.find('pasture')

    def _if(image_patch, is_green, pasture_patches, result):
        result = image_patch.simple_query('Is the pasture green?')
        return (image_patch, is_green, pasture_patches, result)

    def _else(image_patch, is_green, pasture_patches, result):
        is_green = pasture_patches[0].verify_property('pasture', 'green')
        result = bool_to_yesno(is_green)
        return (image_patch, is_green, pasture_patches, result)
    image_patch, is_green, pasture_patches, result = if_stmt(_if, _else, len(pasture_patches) == 0, (image_patch, is_green, pasture_patches, result))
    return result