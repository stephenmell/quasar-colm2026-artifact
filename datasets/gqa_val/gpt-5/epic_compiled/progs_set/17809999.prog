def execute_command(image) -> str:
    has_meat = None
    has_soup = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_meat = image_patch.exists('meat')
    has_soup = image_patch.exists('soup')
    result = bool_to_yesno(and_expr(has_meat, has_soup))
    return result