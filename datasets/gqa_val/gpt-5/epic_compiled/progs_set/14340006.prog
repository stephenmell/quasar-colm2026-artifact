def execute_command(image) -> str:
    found_any = None
    image_patch = None
    object_names = None
    patches = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'
    found_any = False
    object_names = ('trousers', 'pants')

    def _for(object_name, found_any, image_patch, object_names, patches, result):
        patches = image_patch.find(object_name)

        def _if(found_any, image_patch, object_names, patches, result):
            found_any = True

            def _for(patch, found_any, image_patch, object_names, patches, result):

                def _if(found_any, image_patch, object_names, patches, result):
                    result = 'yes'
                    return (found_any, image_patch, object_names, patches, result)
                found_any, image_patch, object_names, patches, result = if_stmt(_if, None, patch.verify_property(object_name, 'beige'), (found_any, image_patch, object_names, patches, result))
                return (found_any, image_patch, object_names, patches, result)
            found_any, image_patch, object_names, patches, result = for_stmt(_for, patches, (found_any, image_patch, object_names, patches, result))
            return (found_any, image_patch, object_names, patches, result)
        found_any, image_patch, object_names, patches, result = if_stmt(_if, None, len(patches) > 0, (found_any, image_patch, object_names, patches, result))
        return (found_any, image_patch, object_names, patches, result)
    found_any, image_patch, object_names, patches, result = for_stmt(_for, object_names, (found_any, image_patch, object_names, patches, result))

    def _if(found_any, image_patch, object_names, patches, result):
        result = image_patch.simple_query('Are the trousers beige?')
        return (found_any, image_patch, object_names, patches, result)
    found_any, image_patch, object_names, patches, result = if_stmt(_if, None, not_expr(found_any), (found_any, image_patch, object_names, patches, result))
    return result