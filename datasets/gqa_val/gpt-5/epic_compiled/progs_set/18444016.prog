def execute_command(image) -> str:
    image_patch = None
    is_bowl = None
    is_vase = None
    result = None
    image_patch = ImagePatch(image)
    is_bowl = image_patch.exists('bowl')
    is_vase = image_patch.exists('vase')
    result = bool_to_yesno(or_expr(is_bowl, is_vase))
    return result