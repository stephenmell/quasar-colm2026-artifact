def execute_command(image) -> str:
    image_patch = None
    is_car = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_car = image_patch.exists('car')
    result = bool_to_yesno(or_expr(is_fence, is_car))
    return result