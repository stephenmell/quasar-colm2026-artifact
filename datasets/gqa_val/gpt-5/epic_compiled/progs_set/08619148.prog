def execute_command(image) -> str:
    has_glasses = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_glasses = image_patch.exists('glasses')

    def _if(has_glasses, image_patch):
        has_glasses = image_patch.exists('sunglasses')
        return (has_glasses, image_patch)
    has_glasses, image_patch = if_stmt(_if, None, not_expr(has_glasses), (has_glasses, image_patch))
    result = bool_to_yesno(has_glasses)
    return result