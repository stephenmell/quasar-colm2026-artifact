def execute_command(image) -> str:
    chair_patches = None
    door_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'

    def _if(door_patches, image_patch, result):
        door_patches = image_patch.find('door')

        def _for(door_patch, door_patches, image_patch, result):

            def _if(door_patches, image_patch, result):
                result = 'yes'
                return (door_patches, image_patch, result)
            door_patches, image_patch, result = if_stmt(_if, None, door_patch.verify_property('door', 'wooden'), (door_patches, image_patch, result))
            return (door_patches, image_patch, result)
        door_patches, image_patch, result = for_stmt(_for, door_patches, (door_patches, image_patch, result))
        return (door_patches, image_patch, result)
    door_patches, image_patch, result = if_stmt(_if, None, image_patch.exists('door'), (door_patches, image_patch, result))

    def _if(chair_patches, door_patches, image_patch, result):
        chair_patches = image_patch.find('chair')

        def _for(chair_patch, chair_patches, door_patches, image_patch, result):

            def _if(chair_patches, door_patches, image_patch, result):
                result = 'yes'
                return (chair_patches, door_patches, image_patch, result)
            chair_patches, door_patches, image_patch, result = if_stmt(_if, None, chair_patch.verify_property('chair', 'wooden'), (chair_patches, door_patches, image_patch, result))
            return (chair_patches, door_patches, image_patch, result)
        chair_patches, door_patches, image_patch, result = for_stmt(_for, chair_patches, (chair_patches, door_patches, image_patch, result))
        return (chair_patches, door_patches, image_patch, result)
    chair_patches, door_patches, image_patch, result = if_stmt(_if, None, image_patch.exists('chair'), (chair_patches, door_patches, image_patch, result))
    return result