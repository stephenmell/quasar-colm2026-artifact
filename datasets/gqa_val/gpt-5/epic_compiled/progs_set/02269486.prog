def execute_command(image) -> str:
    image_patch = None
    is_car = None
    is_window = None
    result = None
    image_patch = ImagePatch(image)
    is_car = image_patch.exists('car')
    is_window = image_patch.exists('window')
    result = bool_to_yesno(and_expr(is_car, is_window))
    return result