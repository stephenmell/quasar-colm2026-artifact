def execute_command(image) -> str:
    image_patch = None
    is_lamp = None
    is_mirror = None
    result = None
    image_patch = ImagePatch(image)
    is_lamp = image_patch.exists('lamp')
    is_mirror = image_patch.exists('mirror')
    result = bool_to_yesno(or_expr(is_lamp, is_mirror))
    return result