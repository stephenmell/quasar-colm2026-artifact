def execute_command(image) -> str:
    image_patch = None
    is_pillow = None
    is_towel = None
    result = None
    image_patch = ImagePatch(image)
    is_towel = image_patch.exists('towel')
    is_pillow = image_patch.exists('pillow')
    result = bool_to_yesno(or_expr(is_towel, is_pillow))
    return result