def execute_command(image) -> str:
    image_patch = None
    is_white = None
    result = None
    saucer_patches = None
    image_patch = ImagePatch(image)
    saucer_patches = image_patch.find('saucer')

    def _if(image_patch, is_white, result, saucer_patches):
        result = image_patch.simple_query('Is the white saucer in the top part of the image?')
        return (image_patch, is_white, result, saucer_patches)

    def _else(image_patch, is_white, result, saucer_patches):
        result = 'no'

        def _for(saucer_patch, image_patch, is_white, result, saucer_patches):
            is_white = saucer_patch.verify_property('saucer', 'white')

            def _if(image_patch, is_white, result, saucer_patches):

                def _if(image_patch, is_white, result, saucer_patches):
                    result = 'yes'
                    return (image_patch, is_white, result, saucer_patches)
                image_patch, is_white, result, saucer_patches = if_stmt(_if, None, saucer_patch.vertical_center >= image_patch.vertical_center, (image_patch, is_white, result, saucer_patches))
                return (image_patch, is_white, result, saucer_patches)
            image_patch, is_white, result, saucer_patches = if_stmt(_if, None, is_white, (image_patch, is_white, result, saucer_patches))
            return (image_patch, is_white, result, saucer_patches)
        image_patch, is_white, result, saucer_patches = for_stmt(_for, saucer_patches, (image_patch, is_white, result, saucer_patches))
        return (image_patch, is_white, result, saucer_patches)
    image_patch, is_white, result, saucer_patches = if_stmt(_if, _else, len(saucer_patches) == 0, (image_patch, is_white, result, saucer_patches))
    return result