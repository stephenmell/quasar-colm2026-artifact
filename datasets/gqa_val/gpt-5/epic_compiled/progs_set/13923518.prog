def execute_command(image) -> str:
    image_patch = None
    result = None
    sand_patches = None
    image_patch = ImagePatch(image)
    sand_patches = image_patch.find('sand')

    def _if(image_patch, result, sand_patches):
        result = image_patch.simple_query('Does the sand have white color?')
        return (image_patch, result, sand_patches)

    def _else(image_patch, result, sand_patches):
        result = 'no'

        def _for(sand_patch, image_patch, result, sand_patches):

            def _if(image_patch, result, sand_patches):
                result = 'yes'
                return (image_patch, result, sand_patches)
            image_patch, result, sand_patches = if_stmt(_if, None, sand_patch.verify_property('sand', 'white'), (image_patch, result, sand_patches))
            return (image_patch, result, sand_patches)
        image_patch, result, sand_patches = for_stmt(_for, sand_patches, (image_patch, result, sand_patches))
        return (image_patch, result, sand_patches)
    image_patch, result, sand_patches = if_stmt(_if, _else, len(sand_patches) == 0, (image_patch, result, sand_patches))
    return result