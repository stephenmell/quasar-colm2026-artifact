def execute_command(image) -> str:
    image_patch = None
    is_plate = None
    is_tablecloth = None
    result = None
    image_patch = ImagePatch(image)
    is_plate = image_patch.exists('plate')
    is_tablecloth = or_expr(image_patch.exists('tablecloth'), image_patch.exists('table cloth'))
    result = bool_to_yesno(or_expr(is_plate, is_tablecloth))
    return result