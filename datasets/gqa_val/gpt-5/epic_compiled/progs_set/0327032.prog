def execute_command(image) -> str:
    has_fence = None
    has_napkin = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_napkin = or_expr(image_patch.exists('napkin'), image_patch.exists('napkins'))
    has_fence = or_expr(image_patch.exists('fence'), image_patch.exists('fences'))
    result = bool_to_yesno(or_expr(has_napkin, has_fence))
    return result