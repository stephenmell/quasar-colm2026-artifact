def execute_command(image) -> str:
    catcher_patches = None
    image_patch = None
    man_patch = None
    man_patches = None
    result = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(catcher_patches, image_patch, man_patch, man_patches, result):
        result = image_patch.simple_query('Is the catcher that is to the right of the man wearing a glove?')
        return (catcher_patches, image_patch, man_patch, man_patches, result)

    def _else(catcher_patches, image_patch, man_patch, man_patches, result):
        man_patch = man_patches[0]
        catcher_patches = image_patch.find('catcher')

        def _if(catcher_patches, image_patch, man_patch, man_patches, result):
            result = 'no'
            return (catcher_patches, image_patch, man_patch, man_patches, result)

        def _else(catcher_patches, image_patch, man_patch, man_patches, result):
            result = 'no'

            def _for(catcher_patch, catcher_patches, image_patch, man_patch, man_patches, result):

                def _if(catcher_patches, image_patch, man_patch, man_patches, result):

                    def _if(catcher_patches, image_patch, man_patch, man_patches, result):
                        result = 'yes'
                        return (catcher_patches, image_patch, man_patch, man_patches, result)
                    catcher_patches, image_patch, man_patch, man_patches, result = if_stmt(_if, None, catcher_patch.simple_query('Is the catcher wearing a glove?') == 'yes', (catcher_patches, image_patch, man_patch, man_patches, result))
                    return (catcher_patches, image_patch, man_patch, man_patches, result)
                catcher_patches, image_patch, man_patch, man_patches, result = if_stmt(_if, None, catcher_patch.horizontal_center > man_patch.horizontal_center, (catcher_patches, image_patch, man_patch, man_patches, result))
                return (catcher_patches, image_patch, man_patch, man_patches, result)
            catcher_patches, image_patch, man_patch, man_patches, result = for_stmt(_for, catcher_patches, (catcher_patches, image_patch, man_patch, man_patches, result))
            return (catcher_patches, image_patch, man_patch, man_patches, result)
        catcher_patches, image_patch, man_patch, man_patches, result = if_stmt(_if, _else, len(catcher_patches) == 0, (catcher_patches, image_patch, man_patch, man_patches, result))
        return (catcher_patches, image_patch, man_patch, man_patches, result)
    catcher_patches, image_patch, man_patch, man_patches, result = if_stmt(_if, _else, len(man_patches) == 0, (catcher_patches, image_patch, man_patch, man_patches, result))
    return result