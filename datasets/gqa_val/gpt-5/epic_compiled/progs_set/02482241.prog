def execute_command(image) -> str:
    image_patch = None
    is_cabinet = None
    is_towel = None
    result = None
    image_patch = ImagePatch(image)
    is_towel = image_patch.exists('towel')
    is_cabinet = image_patch.exists('cabinet')
    result = bool_to_yesno(and_expr(is_towel, is_cabinet))
    return result