def execute_command(image) -> str:
    has_door = None
    has_window = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_window = image_patch.exists('window')
    has_door = image_patch.exists('door')
    result = bool_to_yesno(or_expr(has_window, has_door))
    return result