def execute_command(image) -> str:
    grass_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    grass_patches = image_patch.find('grass')

    def _if(grass_patches, image_patch, result):
        result = image_patch.simple_query('How does the grass look, brown or green?')
        return (grass_patches, image_patch, result)

    def _else(grass_patches, image_patch, result):
        result = grass_patches[0].best_text_match(('brown', 'green'))
        return (grass_patches, image_patch, result)
    grass_patches, image_patch, result = if_stmt(_if, _else, len(grass_patches) == 0, (grass_patches, image_patch, result))
    return result