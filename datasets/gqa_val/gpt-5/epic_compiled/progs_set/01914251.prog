def execute_command(image) -> str:
    bag_patches = None
    brown_bag_patches = None
    direct_brown_bag_patches = None
    image_patch = None
    is_brown = None
    person_patches = None
    result = None
    image_patch = ImagePatch(image)
    result = 'no'
    person_patches = image_patch.find('person')
    bag_patches = image_patch.find('bag')
    brown_bag_patches = ()

    def _for(bag_patch, bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result):
        is_brown = bag_patch.verify_property('bag', 'brown')

        def _if(bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result):
            brown_bag_patches = brown_bag_patches + (bag_patch,)
            return (bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result)
        bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result = if_stmt(_if, None, is_brown, (bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result))
        return (bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result)
    bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result = for_stmt(_for, bag_patches, (bag_patches, brown_bag_patches, image_patch, is_brown, person_patches, result))

    def _if(bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):
        direct_brown_bag_patches = image_patch.find('brown bag')

        def _if(bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):
            brown_bag_patches = direct_brown_bag_patches
            return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
        bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = if_stmt(_if, None, len(direct_brown_bag_patches) > 0, (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))
        return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
    bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = if_stmt(_if, None, len(brown_bag_patches) == 0, (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))

    def _if(bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):
        result = image_patch.simple_query('Is the person to the left of the brown bag?')
        return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)

    def _else(bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):

        def _for(person_patch, bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):

            def _for(brown_bag_patch, bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):

                def _if(bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result):
                    result = 'yes'
                    return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
                bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = if_stmt(_if, None, person_patch.horizontal_center < brown_bag_patch.horizontal_center, (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))
                return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
            bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = for_stmt(_for, brown_bag_patches, (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))
            return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
        bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = for_stmt(_for, person_patches, (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))
        return (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result)
    bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result = if_stmt(_if, _else, or_expr(len(person_patches) == 0, len(brown_bag_patches) == 0), (bag_patches, brown_bag_patches, direct_brown_bag_patches, image_patch, is_brown, person_patches, result))
    return result