def execute_command(image) -> str:
    chair_patches = None
    girl_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    girl_patches = image_patch.find('girl')

    def _if(chair_patches, girl_patches, image_patch, result):
        result = image_patch.simple_query('Is the girl to the right of the chair?')
        return (chair_patches, girl_patches, image_patch, result)

    def _else(chair_patches, girl_patches, image_patch, result):
        chair_patches = image_patch.find('chair')

        def _if(chair_patches, girl_patches, image_patch, result):
            result = 'no'
            return (chair_patches, girl_patches, image_patch, result)

        def _else(chair_patches, girl_patches, image_patch, result):
            result = 'no'

            def _for(girl_patch, chair_patches, girl_patches, image_patch, result):

                def _for(chair_patch, chair_patches, girl_patches, image_patch, result):

                    def _if(chair_patches, girl_patches, image_patch, result):
                        result = 'yes'
                        return (chair_patches, girl_patches, image_patch, result)
                    chair_patches, girl_patches, image_patch, result = if_stmt(_if, None, girl_patch.horizontal_center > chair_patch.horizontal_center, (chair_patches, girl_patches, image_patch, result))
                    return (chair_patches, girl_patches, image_patch, result)
                chair_patches, girl_patches, image_patch, result = for_stmt(_for, chair_patches, (chair_patches, girl_patches, image_patch, result))
                return (chair_patches, girl_patches, image_patch, result)
            chair_patches, girl_patches, image_patch, result = for_stmt(_for, girl_patches, (chair_patches, girl_patches, image_patch, result))
            return (chair_patches, girl_patches, image_patch, result)
        chair_patches, girl_patches, image_patch, result = if_stmt(_if, _else, len(chair_patches) == 0, (chair_patches, girl_patches, image_patch, result))
        return (chair_patches, girl_patches, image_patch, result)
    chair_patches, girl_patches, image_patch, result = if_stmt(_if, _else, len(girl_patches) == 0, (chair_patches, girl_patches, image_patch, result))
    return result