def execute_command(image) -> str:
    image_patch = None
    is_door = None
    is_train = None
    result = None
    image_patch = ImagePatch(image)
    is_train = image_patch.exists('train')
    is_door = image_patch.exists('door')
    result = bool_to_yesno(or_expr(is_train, is_door))
    return result