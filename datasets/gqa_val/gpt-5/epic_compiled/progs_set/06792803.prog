def execute_command(image) -> str:
    bathtub_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    bathtub_patches = image_patch.find('bathtub')

    def _if(bathtub_patches, image_patch, result):
        result = image_patch.simple_query('Is the bathtub white or red?')
        return (bathtub_patches, image_patch, result)

    def _else(bathtub_patches, image_patch, result):
        result = bathtub_patches[0].best_text_match(('white', 'red'))
        return (bathtub_patches, image_patch, result)
    bathtub_patches, image_patch, result = if_stmt(_if, _else, len(bathtub_patches) == 0, (bathtub_patches, image_patch, result))
    return result