def execute_command(image) -> str:
    has_cigar = None
    has_fire_hydrant = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_fire_hydrant = image_patch.exists('fire hydrant')
    has_cigar = image_patch.exists('cigar')
    result = bool_to_yesno(or_expr(has_fire_hydrant, has_cigar))
    return result