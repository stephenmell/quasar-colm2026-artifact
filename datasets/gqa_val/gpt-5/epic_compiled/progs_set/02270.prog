def execute_command(image) -> str:
    image_patch = None
    man_patch = None
    man_patches = None
    result = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(image_patch, man_patch, man_patches, result):
        result = image_patch.simple_query('On which side of the photo is the man, the left or the right?')
        return (image_patch, man_patch, man_patches, result)

    def _else(image_patch, man_patch, man_patches, result):
        man_patch = man_patches[0]

        def _if(image_patch, man_patch, man_patches, result):
            result = 'left'
            return (image_patch, man_patch, man_patches, result)

        def _else(image_patch, man_patch, man_patches, result):
            result = 'right'
            return (image_patch, man_patch, man_patches, result)
        image_patch, man_patch, man_patches, result = if_stmt(_if, _else, man_patch.horizontal_center < image_patch.horizontal_center, (image_patch, man_patch, man_patches, result))
        return (image_patch, man_patch, man_patches, result)
    image_patch, man_patch, man_patches, result = if_stmt(_if, _else, len(man_patches) == 0, (image_patch, man_patch, man_patches, result))
    return result