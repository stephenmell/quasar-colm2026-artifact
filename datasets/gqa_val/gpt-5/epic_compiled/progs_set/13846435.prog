def execute_command(image) -> str:
    bulb_names = None
    found = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    bulb_names = ('bulb', 'light bulb', 'lightbulb', 'bulbs', 'light bulbs')
    found = False

    def _for(name, bulb_names, found, image_patch):

        def _if(bulb_names, found, image_patch):
            found = True
            return (bulb_names, found, image_patch)
        bulb_names, found, image_patch = if_stmt(_if, None, image_patch.exists(name), (bulb_names, found, image_patch))
        return (bulb_names, found, image_patch)
    bulb_names, found, image_patch = for_stmt(_for, bulb_names, (bulb_names, found, image_patch))
    result = bool_to_yesno(found)
    return result