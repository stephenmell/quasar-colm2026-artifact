def execute_command(image) -> str:
    image_patch = None
    is_fork = None
    is_plate = None
    result = None
    image_patch = ImagePatch(image)
    is_plate = image_patch.exists('plate')
    is_fork = image_patch.exists('fork')
    result = bool_to_yesno(or_expr(is_plate, is_fork))
    return result