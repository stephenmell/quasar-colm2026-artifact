def execute_command(image) -> str:
    has_chair = None
    has_mirror = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_mirror = image_patch.exists('mirror')
    has_chair = image_patch.exists('chair')
    result = bool_to_yesno(or_expr(has_mirror, has_chair))
    return result