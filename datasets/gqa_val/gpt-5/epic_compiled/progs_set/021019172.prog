def execute_command(image) -> str:
    image_patch = None
    result = None
    toilet_patches = None
    image_patch = ImagePatch(image)
    toilet_patches = image_patch.find('toilet')

    def _if(image_patch, result, toilet_patches):
        result = image_patch.simple_query('Is the toilet blue or white?')
        return (image_patch, result, toilet_patches)

    def _else(image_patch, result, toilet_patches):
        result = toilet_patches[0].best_text_match(('blue', 'white'))
        return (image_patch, result, toilet_patches)
    image_patch, result, toilet_patches = if_stmt(_if, _else, len(toilet_patches) == 0, (image_patch, result, toilet_patches))
    return result