def execute_command(image) -> str:
    image_patch = None
    is_catching = None
    person_patches = None
    result = None
    right_area_patch = None
    image_patch = ImagePatch(image)
    person_patches = image_patch.find('person')
    result = 'no'

    def _if(image_patch, is_catching, person_patches, result, right_area_patch):
        result = image_patch.simple_query('Do you see any fences to the right of the person that is catching a frisbee?')
        return (image_patch, is_catching, person_patches, result, right_area_patch)

    def _else(image_patch, is_catching, person_patches, result, right_area_patch):

        def _for(person_patch, image_patch, is_catching, person_patches, result, right_area_patch):
            is_catching = person_patch.simple_query('Is the person catching a frisbee?') == 'yes'

            def _if(image_patch, is_catching, person_patches, result, right_area_patch):
                right_area_patch = image_patch.crop(person_patch.right, image_patch.lower, image_patch.right, image_patch.upper)

                def _if(image_patch, is_catching, person_patches, result, right_area_patch):
                    result = 'yes'
                    return (image_patch, is_catching, person_patches, result, right_area_patch)
                image_patch, is_catching, person_patches, result, right_area_patch = if_stmt(_if, None, right_area_patch.exists('fence'), (image_patch, is_catching, person_patches, result, right_area_patch))
                return (image_patch, is_catching, person_patches, result, right_area_patch)
            image_patch, is_catching, person_patches, result, right_area_patch = if_stmt(_if, None, is_catching, (image_patch, is_catching, person_patches, result, right_area_patch))
            return (image_patch, is_catching, person_patches, result, right_area_patch)
        image_patch, is_catching, person_patches, result, right_area_patch = for_stmt(_for, person_patches, (image_patch, is_catching, person_patches, result, right_area_patch))
        return (image_patch, is_catching, person_patches, result, right_area_patch)
    image_patch, is_catching, person_patches, result, right_area_patch = if_stmt(_if, _else, len(person_patches) == 0, (image_patch, is_catching, person_patches, result, right_area_patch))
    return result