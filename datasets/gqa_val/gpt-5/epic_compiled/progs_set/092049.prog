def execute_command(image) -> str:
    cabinet_patches = None
    image_patch = None
    result = None
    stove_patches = None
    image_patch = ImagePatch(image)
    stove_patches = image_patch.find('stove')

    def _if(cabinet_patches, image_patch, result, stove_patches):
        result = image_patch.simple_query('Is the stove to the left of a cabinet?')
        return (cabinet_patches, image_patch, result, stove_patches)

    def _else(cabinet_patches, image_patch, result, stove_patches):
        result = 'no'
        cabinet_patches = image_patch.find('cabinet')

        def _if(cabinet_patches, image_patch, result, stove_patches):
            pass
            return (cabinet_patches, image_patch, result, stove_patches)

        def _else(cabinet_patches, image_patch, result, stove_patches):

            def _for(stove_patch, cabinet_patches, image_patch, result, stove_patches):

                def _for(cabinet_patch, cabinet_patches, image_patch, result, stove_patches):

                    def _if(cabinet_patches, image_patch, result, stove_patches):
                        result = 'yes'
                        return (cabinet_patches, image_patch, result, stove_patches)
                    cabinet_patches, image_patch, result, stove_patches = if_stmt(_if, None, stove_patch.horizontal_center < cabinet_patch.horizontal_center, (cabinet_patches, image_patch, result, stove_patches))
                    return (cabinet_patches, image_patch, result, stove_patches)
                cabinet_patches, image_patch, result, stove_patches = for_stmt(_for, cabinet_patches, (cabinet_patches, image_patch, result, stove_patches))
                return (cabinet_patches, image_patch, result, stove_patches)
            cabinet_patches, image_patch, result, stove_patches = for_stmt(_for, stove_patches, (cabinet_patches, image_patch, result, stove_patches))
            return (cabinet_patches, image_patch, result, stove_patches)
        cabinet_patches, image_patch, result, stove_patches = if_stmt(_if, _else, len(cabinet_patches) == 0, (cabinet_patches, image_patch, result, stove_patches))
        return (cabinet_patches, image_patch, result, stove_patches)
    cabinet_patches, image_patch, result, stove_patches = if_stmt(_if, _else, len(stove_patches) == 0, (cabinet_patches, image_patch, result, stove_patches))
    return result