def execute_command(image) -> str:
    image_patch = None
    result = None
    train_patches = None
    image_patch = ImagePatch(image)
    train_patches = image_patch.find('train')

    def _if(image_patch, result, train_patches):
        result = image_patch.simple_query('Is the train maroon?')
        return (image_patch, result, train_patches)

    def _else(image_patch, result, train_patches):
        result = 'no'

        def _for(train_patch, image_patch, result, train_patches):

            def _if(image_patch, result, train_patches):
                result = 'yes'
                return (image_patch, result, train_patches)
            image_patch, result, train_patches = if_stmt(_if, None, train_patch.verify_property('train', 'maroon'), (image_patch, result, train_patches))
            return (image_patch, result, train_patches)
        image_patch, result, train_patches = for_stmt(_for, train_patches, (image_patch, result, train_patches))
        return (image_patch, result, train_patches)
    image_patch, result, train_patches = if_stmt(_if, _else, len(train_patches) == 0, (image_patch, result, train_patches))
    return result