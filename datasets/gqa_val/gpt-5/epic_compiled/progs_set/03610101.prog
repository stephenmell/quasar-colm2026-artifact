def execute_command(image) -> str:
    have_any_vehicle = None
    have_tent = None
    image_patch = None
    is_blue = None
    result = None
    tent_patches = None
    vehicle_types = None
    vpatches = None
    image_patch = ImagePatch(image)
    result = 'no'
    tent_patches = image_patch.find('tent')
    have_tent = len(tent_patches) > 0
    vehicle_types = ('vehicle', 'car', 'truck', 'bus', 'van', 'motorcycle', 'bicycle')
    have_any_vehicle = False

    def _for(vtype, have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types):

        def _if(have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types):
            have_any_vehicle = True
            return (have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types)
        have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types = if_stmt(_if, None, len(image_patch.find(vtype)) > 0, (have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types))
        return (have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types)
    have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types = for_stmt(_for, vehicle_types, (have_any_vehicle, have_tent, image_patch, result, tent_patches, vehicle_types))

    def _if(have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):

        def _for(vtype, have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):
            vpatches = image_patch.find(vtype)

            def _for(vpatch, have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):
                is_blue = vpatch.verify_property(vtype, 'blue')

                def _if(have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):

                    def _for(tpatch, have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):

                        def _if(have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):
                            result = 'yes'
                            return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
                        have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = if_stmt(_if, None, vpatch.horizontal_center < tpatch.horizontal_center, (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
                        return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
                    have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = for_stmt(_for, tent_patches, (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
                    return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
                have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = if_stmt(_if, None, is_blue, (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
                return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
            have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = for_stmt(_for, vpatches, (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
            return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
        have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = for_stmt(_for, vehicle_types, (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
        return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)

    def _else(have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches):
        result = image_patch.simple_query('Is the blue vehicle to the left of a tent?')
        return (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches)
    have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches = if_stmt(_if, _else, and_expr(have_tent, have_any_vehicle), (have_any_vehicle, have_tent, image_patch, is_blue, result, tent_patches, vehicle_types, vpatches))
    return result