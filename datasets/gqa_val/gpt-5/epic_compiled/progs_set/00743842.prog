def execute_command(image) -> str:
    image_patch = None
    is_knife = None
    is_napkin = None
    result = None
    image_patch = ImagePatch(image)
    is_knife = image_patch.exists('knife')
    is_napkin = image_patch.exists('napkin')
    result = bool_to_yesno(or_expr(is_knife, is_napkin))
    return result