def execute_command(image) -> str:
    image_patch = None
    result = None
    soup_patches = None
    image_patch = ImagePatch(image)
    soup_patches = image_patch.find('soup')

    def _if(image_patch, result, soup_patches):
        result = image_patch.simple_query('Is there any soup that is orange in this photograph?')
        return (image_patch, result, soup_patches)

    def _else(image_patch, result, soup_patches):
        result = 'no'

        def _for(soup_patch, image_patch, result, soup_patches):

            def _if(image_patch, result, soup_patches):
                result = 'yes'
                return (image_patch, result, soup_patches)
            image_patch, result, soup_patches = if_stmt(_if, None, soup_patch.verify_property('soup', 'orange'), (image_patch, result, soup_patches))
            return (image_patch, result, soup_patches)
        image_patch, result, soup_patches = for_stmt(_for, soup_patches, (image_patch, result, soup_patches))
        return (image_patch, result, soup_patches)
    image_patch, result, soup_patches = if_stmt(_if, _else, len(soup_patches) == 0, (image_patch, result, soup_patches))
    return result