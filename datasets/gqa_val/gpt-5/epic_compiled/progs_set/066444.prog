def execute_command(image) -> str:
    image_patch = None
    is_flatbread = None
    is_plate = None
    result = None
    image_patch = ImagePatch(image)
    is_flatbread = image_patch.exists('flatbread')
    is_plate = image_patch.exists('plate')
    result = bool_to_yesno(or_expr(is_flatbread, is_plate))
    return result