def execute_command(image) -> str:
    image_patch = None
    magazine_exists = None
    result = None
    ski_exists = None
    image_patch = ImagePatch(image)
    magazine_exists = or_expr(image_patch.exists('magazine'), image_patch.exists('magazines'))
    ski_exists = or_expr(image_patch.exists('ski'), image_patch.exists('skis'))
    result = bool_to_yesno(or_expr(magazine_exists, ski_exists))
    return result