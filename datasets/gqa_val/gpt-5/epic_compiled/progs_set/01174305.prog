def execute_command(image) -> str:
    image_patch = None
    is_clock = None
    is_nest = None
    result = None
    image_patch = ImagePatch(image)
    is_clock = image_patch.exists('clock')
    is_nest = image_patch.exists('nest')
    result = bool_to_yesno(or_expr(is_clock, is_nest))
    return result