def execute_command(image) -> str:
    best_cheese_count = None
    best_distance = None
    cheese_count_on_plate = None
    cheese_patches = None
    cup_patches = None
    distance = None
    image_patch = None
    in_x = None
    in_y = None
    plate_patches = None
    plate_with_cheese = None
    result = None
    selected_cup = None
    image_patch = ImagePatch(image)
    result = None
    cheese_patches = image_patch.find('cheese')
    plate_patches = image_patch.find('plate')
    cup_patches = image_patch.find('cup')
    plate_with_cheese = None
    best_cheese_count = -1

    def _for(plate_patch, best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result):
        cheese_count_on_plate = 0

        def _for(cheese_patch, best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result):
            in_x = and_expr(cheese_patch.horizontal_center >= plate_patch.left, cheese_patch.horizontal_center <= plate_patch.right)
            in_y = and_expr(cheese_patch.vertical_center >= plate_patch.lower, cheese_patch.vertical_center <= plate_patch.upper)

            def _if(best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result):
                cheese_count_on_plate = cheese_count_on_plate + 1
                return (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result)
            best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result = if_stmt(_if, None, and_expr(in_x, in_y), (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result))
            return (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result)
        best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result = for_stmt(_for, cheese_patches, (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result))

        def _if(best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result):
            best_cheese_count = cheese_count_on_plate
            plate_with_cheese = plate_patch
            return (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result)
        best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result = if_stmt(_if, None, cheese_count_on_plate > best_cheese_count, (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result))
        return (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result)
    best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result = for_stmt(_for, plate_patches, (best_cheese_count, cheese_count_on_plate, cheese_patches, cup_patches, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result))
    selected_cup = None

    def _if(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
        best_distance = None

        def _for(cup_patch, best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
            distance = abs(cup_patch.horizontal_center - plate_with_cheese.horizontal_center)

            def _if(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
                best_distance = distance
                selected_cup = cup_patch
                return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)
            best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup = if_stmt(_if, None, or_expr(best_distance is None, distance < best_distance), (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup))
            return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)
        best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup = for_stmt(_for, cup_patches, (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup))
        return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)
    best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup = if_stmt(_if, None, and_expr(plate_with_cheese is not None, and_expr(best_cheese_count > 0, len(cup_patches) > 0)), (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup))

    def _if(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):

        def _if(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
            result = 'right'
            return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)

        def _else(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
            result = 'left'
            return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)
        best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup = if_stmt(_if, _else, selected_cup.horizontal_center > plate_with_cheese.horizontal_center, (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup))
        return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)

    def _else(best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup):
        result = image_patch.simple_query('Is the cup to the right or to the left of the plate that the cheese is on?')
        return (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup)
    best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup = if_stmt(_if, _else, and_expr(selected_cup is not None, plate_with_cheese is not None), (best_cheese_count, best_distance, cheese_count_on_plate, cheese_patches, cup_patches, distance, image_patch, in_x, in_y, plate_patches, plate_with_cheese, result, selected_cup))
    return result