def execute_command(image) -> str:
    image_patch = None
    is_blender = None
    is_toaster = None
    result = None
    image_patch = ImagePatch(image)
    is_blender = image_patch.exists('blender')
    is_toaster = image_patch.exists('toaster')
    result = bool_to_yesno(or_expr(is_blender, is_toaster))
    return result