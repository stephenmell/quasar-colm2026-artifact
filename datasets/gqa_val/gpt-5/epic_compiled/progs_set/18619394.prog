def execute_command(image) -> str:
    has_train = None
    has_window = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_train = image_patch.exists('train')
    has_window = image_patch.exists('window')
    result = bool_to_yesno(or_expr(has_train, has_window))
    return result