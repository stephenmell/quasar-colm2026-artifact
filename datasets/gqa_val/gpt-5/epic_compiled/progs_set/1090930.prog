def execute_command(image) -> str:
    has_desk = None
    has_keyboard = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_desk = image_patch.exists('desk')
    has_keyboard = image_patch.exists('keyboard')
    result = bool_to_yesno(and_expr(has_desk, has_keyboard))
    return result