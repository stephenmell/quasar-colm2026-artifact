def execute_command(image) -> str:
    curtain_patches = None
    image_patch = None
    is_wood = None
    result = None
    table_patches = None
    image_patch = ImagePatch(image)
    table_patches = image_patch.find('table')

    def _if(curtain_patches, image_patch, is_wood, result, table_patches):
        result = image_patch.simple_query('Is the wood table to the right of a curtain?')
        return (curtain_patches, image_patch, is_wood, result, table_patches)

    def _else(curtain_patches, image_patch, is_wood, result, table_patches):
        result = 'no'
        curtain_patches = image_patch.find('curtain')

        def _for(table_patch, curtain_patches, image_patch, is_wood, result, table_patches):
            is_wood = or_expr(table_patch.verify_property('table', 'wood'), table_patch.verify_property('table', 'wooden'))

            def _if(curtain_patches, image_patch, is_wood, result, table_patches):

                def _for(curtain_patch, curtain_patches, image_patch, is_wood, result, table_patches):

                    def _if(curtain_patches, image_patch, is_wood, result, table_patches):
                        result = 'yes'
                        return (curtain_patches, image_patch, is_wood, result, table_patches)
                    curtain_patches, image_patch, is_wood, result, table_patches = if_stmt(_if, None, curtain_patch.horizontal_center < table_patch.horizontal_center, (curtain_patches, image_patch, is_wood, result, table_patches))
                    return (curtain_patches, image_patch, is_wood, result, table_patches)
                curtain_patches, image_patch, is_wood, result, table_patches = for_stmt(_for, curtain_patches, (curtain_patches, image_patch, is_wood, result, table_patches))
                return (curtain_patches, image_patch, is_wood, result, table_patches)
            curtain_patches, image_patch, is_wood, result, table_patches = if_stmt(_if, None, is_wood, (curtain_patches, image_patch, is_wood, result, table_patches))
            return (curtain_patches, image_patch, is_wood, result, table_patches)
        curtain_patches, image_patch, is_wood, result, table_patches = for_stmt(_for, table_patches, (curtain_patches, image_patch, is_wood, result, table_patches))
        return (curtain_patches, image_patch, is_wood, result, table_patches)
    curtain_patches, image_patch, is_wood, result, table_patches = if_stmt(_if, _else, len(table_patches) == 0, (curtain_patches, image_patch, is_wood, result, table_patches))
    return result