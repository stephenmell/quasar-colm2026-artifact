def execute_command(image) -> str:
    all_racket_patches = None
    image_patch = None
    is_sitting_answer = None
    is_sitting_on_seat = None
    person_patches = None
    racket_patches_primary = None
    racket_patches_secondary = None
    result = None
    seat_person_patch = None
    image_patch = ImagePatch(image)
    result = 'no'
    person_patches = image_patch.find('person')

    def _if(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
        result = image_patch.simple_query('Are there any rackets to the left of the person that sits on the seat?')
        return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)

    def _else(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
        seat_person_patch = None

        def _for(person_patch, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch):
            is_sitting_answer = person_patch.simple_query('Is the person sitting on the seat?')
            is_sitting_on_seat = is_sitting_answer == 'yes'

            def _if(image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch):
                seat_person_patch = person_patch
                return (image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch)
            image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch = if_stmt(_if, None, and_expr(is_sitting_on_seat, seat_person_patch is None), (image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch))
            return (image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch)
        image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch = for_stmt(_for, person_patches, (image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, result, seat_person_patch))

        def _if(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
            result = image_patch.simple_query('Are there any rackets to the left of the person that sits on the seat?')
            return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)

        def _else(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
            racket_patches_primary = image_patch.find('racket')
            racket_patches_secondary = image_patch.find('tennis racket')
            all_racket_patches = ()

            def _for(rp, all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
                all_racket_patches = all_racket_patches + (rp,)
                return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
            all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = for_stmt(_for, racket_patches_primary, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))

            def _for(rp, all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
                all_racket_patches = all_racket_patches + (rp,)
                return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
            all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = for_stmt(_for, racket_patches_secondary, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))

            def _if(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
                result = 'no'
                return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)

            def _else(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
                result = 'no'

                def _for(racket_patch, all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):

                    def _if(all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch):
                        result = 'yes'
                        return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
                    all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = if_stmt(_if, None, racket_patch.horizontal_center < seat_person_patch.horizontal_center, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))
                    return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
                all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = for_stmt(_for, all_racket_patches, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))
                return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
            all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = if_stmt(_if, _else, len(all_racket_patches) == 0, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))
            return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
        all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = if_stmt(_if, _else, seat_person_patch is None, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))
        return (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch)
    all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch = if_stmt(_if, _else, len(person_patches) == 0, (all_racket_patches, image_patch, is_sitting_answer, is_sitting_on_seat, person_patches, racket_patches_primary, racket_patches_secondary, result, seat_person_patch))
    return result