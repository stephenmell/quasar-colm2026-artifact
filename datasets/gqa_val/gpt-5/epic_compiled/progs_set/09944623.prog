def execute_command(image) -> str:
    image_patch = None
    is_boy = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_boy = image_patch.exists('boy')
    result = bool_to_yesno(or_expr(is_fence, is_boy))
    return result