def execute_command(image) -> str:
    has_fence = None
    has_glasses = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_glasses = image_patch.exists('glasses')
    has_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(has_glasses, has_fence))
    return result