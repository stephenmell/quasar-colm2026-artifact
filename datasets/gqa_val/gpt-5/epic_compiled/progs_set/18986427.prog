def execute_command(image) -> str:
    image_patch = None
    is_chair = None
    is_plate = None
    result = None
    image_patch = ImagePatch(image)
    is_plate = image_patch.exists('plate')
    is_chair = image_patch.exists('chair')
    result = bool_to_yesno(and_expr(is_plate, is_chair))
    return result