def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_fences = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_fences = image_patch.exists('fences')
    result = bool_to_yesno(or_expr(is_fence, is_fences))
    return result