def execute_command(image) -> str:
    girl_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    girl_patches = image_patch.find('girl')

    def _if(girl_patches, image_patch, result):
        result = image_patch.simple_query('Is the girl in the top part of the photo?')
        return (girl_patches, image_patch, result)

    def _else(girl_patches, image_patch, result):
        result = 'no'

        def _for(girl_patch, girl_patches, image_patch, result):

            def _if(girl_patches, image_patch, result):
                result = 'yes'
                return (girl_patches, image_patch, result)
            girl_patches, image_patch, result = if_stmt(_if, None, girl_patch.vertical_center >= image_patch.vertical_center, (girl_patches, image_patch, result))
            return (girl_patches, image_patch, result)
        girl_patches, image_patch, result = for_stmt(_for, girl_patches, (girl_patches, image_patch, result))
        return (girl_patches, image_patch, result)
    girl_patches, image_patch, result = if_stmt(_if, _else, len(girl_patches) == 0, (girl_patches, image_patch, result))
    return result