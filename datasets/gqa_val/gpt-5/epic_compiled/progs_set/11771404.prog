def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_skateboard = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_skateboard = image_patch.exists('skateboard')
    result = bool_to_yesno(and_expr(is_fence, is_skateboard))
    return result