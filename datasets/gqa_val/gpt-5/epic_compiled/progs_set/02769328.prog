def execute_command(image) -> str:
    chair_patches = None
    end_table_patches = None
    image_patch = None
    is_chair_below_window = None
    is_table_left_of_chair = None
    result = None
    window_patches = None
    image_patch = ImagePatch(image)
    result = 'no'
    window_patches = image_patch.find('window')
    chair_patches = image_patch.find('chair')
    end_table_patches = image_patch.find('end table')

    def _if(chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):
        result = image_patch.simple_query('Do you see end tables to the left of the chair below the window?')
        return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)

    def _else(chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):

        def _for(window_patch, chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):

            def _for(chair_patch, chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):
                is_chair_below_window = chair_patch.vertical_center > window_patch.vertical_center

                def _if(chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):

                    def _for(end_table_patch, chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):
                        is_table_left_of_chair = end_table_patch.horizontal_center < chair_patch.horizontal_center

                        def _if(chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches):
                            result = 'yes'
                            return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
                        chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = if_stmt(_if, None, is_table_left_of_chair, (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
                        return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
                    chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = for_stmt(_for, end_table_patches, (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
                    return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
                chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = if_stmt(_if, None, is_chair_below_window, (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
                return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
            chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = for_stmt(_for, chair_patches, (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
            return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
        chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = for_stmt(_for, window_patches, (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
        return (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches)
    chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches = if_stmt(_if, _else, or_expr(len(window_patches) == 0, or_expr(len(chair_patches) == 0, len(end_table_patches) == 0)), (chair_patches, end_table_patches, image_patch, is_chair_below_window, is_table_left_of_chair, result, window_patches))
    return result