def execute_command(image) -> str:
    image_patch = None
    is_surfing = None
    man_patches = None
    result = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(image_patch, is_surfing, man_patches, result):
        result = image_patch.simple_query('What is the man that is surfing wearing?')
        return (image_patch, is_surfing, man_patches, result)

    def _else(image_patch, is_surfing, man_patches, result):
        result = None

        def _for(man_patch, image_patch, is_surfing, man_patches, result):
            is_surfing = man_patch.verify_property('man', 'surfing')

            def _if(image_patch, is_surfing, man_patches, result):
                result = man_patch.simple_query('What is the man wearing?')
                return (image_patch, is_surfing, man_patches, result)
            image_patch, is_surfing, man_patches, result = if_stmt(_if, None, is_surfing, (image_patch, is_surfing, man_patches, result))
            return (image_patch, is_surfing, man_patches, result)
        image_patch, is_surfing, man_patches, result = for_stmt(_for, man_patches, (image_patch, is_surfing, man_patches, result))

        def _if(image_patch, is_surfing, man_patches, result):
            result = image_patch.simple_query('What is the man that is surfing wearing?')
            return (image_patch, is_surfing, man_patches, result)
        image_patch, is_surfing, man_patches, result = if_stmt(_if, None, not_expr(result), (image_patch, is_surfing, man_patches, result))
        return (image_patch, is_surfing, man_patches, result)
    image_patch, is_surfing, man_patches, result = if_stmt(_if, _else, len(man_patches) == 0, (image_patch, is_surfing, man_patches, result))
    return result