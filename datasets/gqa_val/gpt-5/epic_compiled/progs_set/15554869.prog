def execute_command(image) -> str:
    image_patch = None
    is_bus = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_bus = image_patch.exists('bus')
    is_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(is_bus, is_fence))
    return result