def execute_command(image) -> str:
    car_exists = None
    image_patch = None
    result = None
    umbrella_exists = None
    umbrella_patches = None
    image_patch = ImagePatch(image)
    result = 'no'
    umbrella_exists = image_patch.exists('umbrella')

    def _if(image_patch, result, umbrella_exists, umbrella_patches):
        umbrella_patches = image_patch.find('umbrella')

        def _for(umbrella_patch, image_patch, result, umbrella_exists, umbrella_patches):

            def _if(image_patch, result, umbrella_exists, umbrella_patches):
                result = 'yes'
                return (image_patch, result, umbrella_exists, umbrella_patches)
            image_patch, result, umbrella_exists, umbrella_patches = if_stmt(_if, None, umbrella_patch.verify_property('umbrella', 'white'), (image_patch, result, umbrella_exists, umbrella_patches))
            return (image_patch, result, umbrella_exists, umbrella_patches)
        image_patch, result, umbrella_exists, umbrella_patches = for_stmt(_for, umbrella_patches, (image_patch, result, umbrella_exists, umbrella_patches))
        return (image_patch, result, umbrella_exists, umbrella_patches)
    image_patch, result, umbrella_exists, umbrella_patches = if_stmt(_if, None, umbrella_exists, (image_patch, result, umbrella_exists, umbrella_patches))
    car_exists = image_patch.exists('car')

    def _if(car_exists, image_patch, result, umbrella_exists, umbrella_patches):
        result = 'yes'
        return (car_exists, image_patch, result, umbrella_exists, umbrella_patches)
    car_exists, image_patch, result, umbrella_exists, umbrella_patches = if_stmt(_if, None, car_exists, (car_exists, image_patch, result, umbrella_exists, umbrella_patches))
    return result