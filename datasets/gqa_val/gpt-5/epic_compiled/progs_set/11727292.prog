def execute_command(image) -> str:
    animal_patches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    animal_patches = image_patch.find('animal')

    def _if(animal_patches, image_patch, result):
        result = image_patch.simple_query('What kind of animal is running?')
        return (animal_patches, image_patch, result)

    def _else(animal_patches, image_patch, result):
        result = None

        def _for(animal_patch, animal_patches, image_patch, result):

            def _if(animal_patches, image_patch, result):
                result = animal_patch.simple_query('What kind of animal is running?')
                return (animal_patches, image_patch, result)
            animal_patches, image_patch, result = if_stmt(_if, None, animal_patch.verify_property('animal', 'running'), (animal_patches, image_patch, result))
            return (animal_patches, image_patch, result)
        animal_patches, image_patch, result = for_stmt(_for, animal_patches, (animal_patches, image_patch, result))

        def _if(animal_patches, image_patch, result):
            result = image_patch.simple_query('What kind of animal is running?')
            return (animal_patches, image_patch, result)
        animal_patches, image_patch, result = if_stmt(_if, None, not_expr(result), (animal_patches, image_patch, result))
        return (animal_patches, image_patch, result)
    animal_patches, image_patch, result = if_stmt(_if, _else, len(animal_patches) == 0, (animal_patches, image_patch, result))
    return result