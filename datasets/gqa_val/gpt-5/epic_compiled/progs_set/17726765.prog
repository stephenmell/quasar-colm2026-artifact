def execute_command(image) -> str:
    bag_patches = None
    image_patch = None
    is_black = None
    is_right = None
    result = None
    image_patch = ImagePatch(image)
    bag_patches = image_patch.find('bag')

    def _if(bag_patches, image_patch, is_black, is_right, result):
        result = image_patch.simple_query('Is the black bag on the right?')
        return (bag_patches, image_patch, is_black, is_right, result)

    def _else(bag_patches, image_patch, is_black, is_right, result):
        result = 'no'

        def _for(bag_patch, bag_patches, image_patch, is_black, is_right, result):
            is_black = bag_patch.verify_property('bag', 'black')
            is_right = bag_patch.horizontal_center > image_patch.horizontal_center

            def _if(bag_patches, image_patch, is_black, is_right, result):
                result = 'yes'
                return (bag_patches, image_patch, is_black, is_right, result)
            bag_patches, image_patch, is_black, is_right, result = if_stmt(_if, None, and_expr(is_black, is_right), (bag_patches, image_patch, is_black, is_right, result))
            return (bag_patches, image_patch, is_black, is_right, result)
        bag_patches, image_patch, is_black, is_right, result = for_stmt(_for, bag_patches, (bag_patches, image_patch, is_black, is_right, result))
        return (bag_patches, image_patch, is_black, is_right, result)
    bag_patches, image_patch, is_black, is_right, result = if_stmt(_if, _else, len(bag_patches) == 0, (bag_patches, image_patch, is_black, is_right, result))
    return result