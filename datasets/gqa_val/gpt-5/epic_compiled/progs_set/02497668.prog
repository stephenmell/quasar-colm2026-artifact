def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_helmet = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_helmet = image_patch.exists('helmet')
    result = bool_to_yesno(or_expr(is_fence, is_helmet))
    return result