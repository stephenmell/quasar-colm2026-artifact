def execute_command(image) -> str:
    has_fence = None
    has_street_sign = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_street_sign = image_patch.exists('street sign')
    has_fence = image_patch.exists('fence')
    result = bool_to_yesno(and_expr(has_street_sign, has_fence))
    return result