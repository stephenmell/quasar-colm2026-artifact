def execute_command(image) -> str:
    image_patch = None
    is_car = None
    is_clock_tower = None
    result = None
    image_patch = ImagePatch(image)
    is_clock_tower = image_patch.exists('clock tower')
    is_car = image_patch.exists('car')
    result = bool_to_yesno(or_expr(is_clock_tower, is_car))
    return result