def execute_command(image) -> str:
    has_bench = None
    has_benches = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    has_bench = image_patch.exists('bench')
    has_benches = image_patch.exists('benches')
    result = bool_to_yesno(or_expr(has_bench, has_benches))
    return result