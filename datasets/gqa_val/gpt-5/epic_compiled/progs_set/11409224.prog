def execute_command(image) -> str:
    bag_patches = None
    image_patch = None
    man_patches = None
    result = None
    yellow_bag_patches = None
    image_patch = ImagePatch(image)
    result = 'no'
    bag_patches = image_patch.find('bag')

    def _if(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
        result = image_patch.simple_query('Do you see any men to the right of the yellow bag?')
        return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)

    def _else(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
        yellow_bag_patches = ()

        def _for(bag_patch, bag_patches, image_patch, result, yellow_bag_patches):

            def _if(bag_patches, image_patch, result, yellow_bag_patches):
                yellow_bag_patches = yellow_bag_patches + (bag_patch,)
                return (bag_patches, image_patch, result, yellow_bag_patches)
            bag_patches, image_patch, result, yellow_bag_patches = if_stmt(_if, None, bag_patch.verify_property('bag', 'yellow'), (bag_patches, image_patch, result, yellow_bag_patches))
            return (bag_patches, image_patch, result, yellow_bag_patches)
        bag_patches, image_patch, result, yellow_bag_patches = for_stmt(_for, bag_patches, (bag_patches, image_patch, result, yellow_bag_patches))

        def _if(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
            result = image_patch.simple_query('Do you see any men to the right of the yellow bag?')
            return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)

        def _else(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
            man_patches = image_patch.find('man')

            def _if(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
                result = 'no'
                return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)

            def _else(bag_patches, image_patch, man_patches, result, yellow_bag_patches):

                def _for(yb_patch, bag_patches, image_patch, man_patches, result, yellow_bag_patches):

                    def _for(man_patch, bag_patches, image_patch, man_patches, result, yellow_bag_patches):

                        def _if(bag_patches, image_patch, man_patches, result, yellow_bag_patches):
                            result = 'yes'
                            return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
                        bag_patches, image_patch, man_patches, result, yellow_bag_patches = if_stmt(_if, None, man_patch.horizontal_center > yb_patch.horizontal_center, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
                        return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
                    bag_patches, image_patch, man_patches, result, yellow_bag_patches = for_stmt(_for, man_patches, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
                    return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
                bag_patches, image_patch, man_patches, result, yellow_bag_patches = for_stmt(_for, yellow_bag_patches, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
                return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
            bag_patches, image_patch, man_patches, result, yellow_bag_patches = if_stmt(_if, _else, len(man_patches) == 0, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
            return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
        bag_patches, image_patch, man_patches, result, yellow_bag_patches = if_stmt(_if, _else, len(yellow_bag_patches) == 0, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
        return (bag_patches, image_patch, man_patches, result, yellow_bag_patches)
    bag_patches, image_patch, man_patches, result, yellow_bag_patches = if_stmt(_if, _else, len(bag_patches) == 0, (bag_patches, image_patch, man_patches, result, yellow_bag_patches))
    return result