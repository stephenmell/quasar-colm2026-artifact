def execute_command(image) -> str:
    image_patch = None
    is_clock = None
    is_fence = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_clock = image_patch.exists('clock')
    result = bool_to_yesno(or_expr(is_fence, is_clock))
    return result