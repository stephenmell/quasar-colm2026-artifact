def execute_command(image) -> str:
    fence_patches = None
    image_patch = None
    result = None
    umbrella_patches = None
    image_patch = ImagePatch(image)
    result = 'no'

    def _if(fence_patches, image_patch, result):
        fence_patches = image_patch.find('fence')

        def _for(fence_patch, fence_patches, image_patch, result):

            def _if(fence_patches, image_patch, result):
                result = 'yes'
                return (fence_patches, image_patch, result)
            fence_patches, image_patch, result = if_stmt(_if, None, fence_patch.verify_property('fence', 'orange'), (fence_patches, image_patch, result))
            return (fence_patches, image_patch, result)
        fence_patches, image_patch, result = for_stmt(_for, fence_patches, (fence_patches, image_patch, result))
        return (fence_patches, image_patch, result)
    fence_patches, image_patch, result = if_stmt(_if, None, image_patch.exists('fence'), (fence_patches, image_patch, result))

    def _if(fence_patches, image_patch, result, umbrella_patches):
        umbrella_patches = image_patch.find('umbrella')

        def _for(umbrella_patch, fence_patches, image_patch, result, umbrella_patches):

            def _if(fence_patches, image_patch, result, umbrella_patches):
                result = 'yes'
                return (fence_patches, image_patch, result, umbrella_patches)
            fence_patches, image_patch, result, umbrella_patches = if_stmt(_if, None, umbrella_patch.verify_property('umbrella', 'orange'), (fence_patches, image_patch, result, umbrella_patches))
            return (fence_patches, image_patch, result, umbrella_patches)
        fence_patches, image_patch, result, umbrella_patches = for_stmt(_for, umbrella_patches, (fence_patches, image_patch, result, umbrella_patches))
        return (fence_patches, image_patch, result, umbrella_patches)
    fence_patches, image_patch, result, umbrella_patches = if_stmt(_if, None, image_patch.exists('umbrella'), (fence_patches, image_patch, result, umbrella_patches))
    return result