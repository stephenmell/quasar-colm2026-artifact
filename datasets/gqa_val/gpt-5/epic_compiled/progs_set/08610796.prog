def execute_command(image) -> str:
    girl_patches = None
    image_patch = None
    racket_patches = None
    result = None
    right_side_racket = None
    image_patch = ImagePatch(image)
    racket_patches = image_patch.find('racket')

    def _if(girl_patches, image_patch, racket_patches, result, right_side_racket):
        result = image_patch.simple_query('Are there any girls to the left of the racket on the right side?')
        return (girl_patches, image_patch, racket_patches, result, right_side_racket)

    def _else(girl_patches, image_patch, racket_patches, result, right_side_racket):
        right_side_racket = None

        def _for(r_patch, image_patch, racket_patches, right_side_racket):

            def _if(image_patch, racket_patches, right_side_racket):

                def _if(image_patch, racket_patches, right_side_racket):
                    right_side_racket = r_patch
                    return (image_patch, racket_patches, right_side_racket)

                def _else(image_patch, racket_patches, right_side_racket):

                    def _if(image_patch, racket_patches, right_side_racket):
                        right_side_racket = r_patch
                        return (image_patch, racket_patches, right_side_racket)
                    image_patch, racket_patches, right_side_racket = if_stmt(_if, None, r_patch.horizontal_center > right_side_racket.horizontal_center, (image_patch, racket_patches, right_side_racket))
                    return (image_patch, racket_patches, right_side_racket)
                image_patch, racket_patches, right_side_racket = if_stmt(_if, _else, right_side_racket is None, (image_patch, racket_patches, right_side_racket))
                return (image_patch, racket_patches, right_side_racket)
            image_patch, racket_patches, right_side_racket = if_stmt(_if, None, r_patch.horizontal_center > image_patch.horizontal_center, (image_patch, racket_patches, right_side_racket))
            return (image_patch, racket_patches, right_side_racket)
        image_patch, racket_patches, right_side_racket = for_stmt(_for, racket_patches, (image_patch, racket_patches, right_side_racket))

        def _if(image_patch, racket_patches, right_side_racket):
            right_side_racket = racket_patches[0]

            def _for(r_patch, image_patch, racket_patches, right_side_racket):

                def _if(image_patch, racket_patches, right_side_racket):
                    right_side_racket = r_patch
                    return (image_patch, racket_patches, right_side_racket)
                image_patch, racket_patches, right_side_racket = if_stmt(_if, None, r_patch.horizontal_center > right_side_racket.horizontal_center, (image_patch, racket_patches, right_side_racket))
                return (image_patch, racket_patches, right_side_racket)
            image_patch, racket_patches, right_side_racket = for_stmt(_for, racket_patches, (image_patch, racket_patches, right_side_racket))
            return (image_patch, racket_patches, right_side_racket)
        image_patch, racket_patches, right_side_racket = if_stmt(_if, None, right_side_racket is None, (image_patch, racket_patches, right_side_racket))
        girl_patches = image_patch.find('girl')

        def _if(girl_patches, image_patch, racket_patches, result, right_side_racket):
            result = 'no'
            return (girl_patches, image_patch, racket_patches, result, right_side_racket)

        def _else(girl_patches, image_patch, racket_patches, result, right_side_racket):
            result = 'no'

            def _for(girl_patch, girl_patches, image_patch, racket_patches, result, right_side_racket):

                def _if(girl_patches, image_patch, racket_patches, result, right_side_racket):
                    result = 'yes'
                    return (girl_patches, image_patch, racket_patches, result, right_side_racket)
                girl_patches, image_patch, racket_patches, result, right_side_racket = if_stmt(_if, None, girl_patch.horizontal_center < right_side_racket.horizontal_center, (girl_patches, image_patch, racket_patches, result, right_side_racket))
                return (girl_patches, image_patch, racket_patches, result, right_side_racket)
            girl_patches, image_patch, racket_patches, result, right_side_racket = for_stmt(_for, girl_patches, (girl_patches, image_patch, racket_patches, result, right_side_racket))
            return (girl_patches, image_patch, racket_patches, result, right_side_racket)
        girl_patches, image_patch, racket_patches, result, right_side_racket = if_stmt(_if, _else, len(girl_patches) == 0, (girl_patches, image_patch, racket_patches, result, right_side_racket))
        return (girl_patches, image_patch, racket_patches, result, right_side_racket)
    girl_patches, image_patch, racket_patches, result, right_side_racket = if_stmt(_if, _else, len(racket_patches) == 0, (girl_patches, image_patch, racket_patches, result, right_side_racket))
    return result