def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_van = None
    result = None
    image_patch = ImagePatch(image)
    is_van = image_patch.exists('van')
    is_fence = image_patch.exists('fence')
    result = bool_to_yesno(or_expr(is_van, is_fence))
    return result