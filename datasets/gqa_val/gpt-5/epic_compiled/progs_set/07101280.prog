def execute_command(image) -> str:
    image_patch = None
    is_bread = None
    is_plate = None
    result = None
    image_patch = ImagePatch(image)
    is_plate = image_patch.exists('plate')
    is_bread = image_patch.exists('bread')
    result = bool_to_yesno(or_expr(is_plate, is_bread))
    return result