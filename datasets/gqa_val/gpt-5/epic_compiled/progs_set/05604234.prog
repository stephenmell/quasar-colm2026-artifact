def execute_command(image) -> str:
    bull_patches = None
    image_patch = None
    man_patches = None
    result = None
    rightmost_man = None
    rightmost_x = None
    image_patch = ImagePatch(image)
    man_patches = image_patch.find('man')

    def _if(bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):
        result = image_patch.simple_query('Do you see any bulls to the left of the man that is on the right of the image?')
        return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)

    def _else(bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):
        rightmost_man = man_patches[0]
        rightmost_x = rightmost_man.horizontal_center

        def _for(man_patch, image_patch, man_patches, rightmost_man, rightmost_x):

            def _if(image_patch, man_patches, rightmost_man, rightmost_x):
                rightmost_man = man_patch
                rightmost_x = man_patch.horizontal_center
                return (image_patch, man_patches, rightmost_man, rightmost_x)
            image_patch, man_patches, rightmost_man, rightmost_x = if_stmt(_if, None, man_patch.horizontal_center > rightmost_x, (image_patch, man_patches, rightmost_man, rightmost_x))
            return (image_patch, man_patches, rightmost_man, rightmost_x)
        image_patch, man_patches, rightmost_man, rightmost_x = for_stmt(_for, man_patches, (image_patch, man_patches, rightmost_man, rightmost_x))
        bull_patches = image_patch.find('bull')

        def _if(bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):
            result = 'no'
            return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)

        def _else(bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):
            result = 'no'

            def _for(bull_patch, bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):

                def _if(bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x):
                    result = 'yes'
                    return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)
                bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x = if_stmt(_if, None, bull_patch.horizontal_center < rightmost_man.horizontal_center, (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x))
                return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)
            bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x = for_stmt(_for, bull_patches, (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x))
            return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)
        bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x = if_stmt(_if, _else, len(bull_patches) == 0, (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x))
        return (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x)
    bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x = if_stmt(_if, _else, len(man_patches) == 0, (bull_patches, image_patch, man_patches, result, rightmost_man, rightmost_x))
    return result