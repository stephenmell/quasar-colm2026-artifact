def execute_command(image) -> str:
    image_patch = None
    is_mirror = None
    is_vase = None
    result = None
    image_patch = ImagePatch(image)
    is_vase = image_patch.exists('vase')
    is_mirror = image_patch.exists('mirror')
    result = bool_to_yesno(or_expr(is_vase, is_mirror))
    return result