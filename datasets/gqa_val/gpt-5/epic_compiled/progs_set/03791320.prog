def execute_command(image) -> str:
    image_patch = None
    is_bed = None
    is_chair = None
    result = None
    image_patch = ImagePatch(image)
    is_bed = image_patch.exists('bed')
    is_chair = image_patch.exists('chair')
    result = bool_to_yesno(or_expr(is_bed, is_chair))
    return result