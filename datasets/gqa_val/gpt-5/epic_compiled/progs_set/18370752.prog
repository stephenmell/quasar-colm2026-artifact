    candidate_plates, cup_patch, cup_patches, delta, image_patch, min_delta, plate_patches_for_rect, rectangular_plate_patch, rectangular_plate_patches, rectangular_white, result, selected_right_plate = if_stmt(_if, None, cup_patch is not None, (candidate_plates, cup_patch, cup_patches, delta, image_patch, min_delta, plate_patches_for_rect, rectangular_plate_patch, rectangular_plate_patches, rectangular_white, result, selected_right_plate))
