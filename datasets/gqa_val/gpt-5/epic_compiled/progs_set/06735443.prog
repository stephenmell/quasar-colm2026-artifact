def execute_command(image) -> str:
    bear_exists = None
    bed_exists = None
    image_patch = None
    result = None
    image_patch = ImagePatch(image)
    bed_exists = image_patch.exists('bed')
    bear_exists = or_expr(image_patch.exists('bear'), image_patch.exists('teddy bear'))
    result = bool_to_yesno(or_expr(bed_exists, bear_exists))
    return result