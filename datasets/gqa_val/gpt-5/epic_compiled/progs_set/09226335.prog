def execute_command(image) -> str:
    image_patch = None
    is_fence = None
    is_flag = None
    result = None
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists('fence')
    is_flag = image_patch.exists('flag')
    result = bool_to_yesno(or_expr(is_fence, is_flag))
    return result