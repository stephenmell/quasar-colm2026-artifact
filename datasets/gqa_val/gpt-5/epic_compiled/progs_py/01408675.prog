# INSERT_PROMPT_HERE
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lettuce_patches = image_patch.find("lettuce")
    tomato_patches = image_patch.find("tomato")

    red_tomato_patch = None
    for tomato_patch in tomato_patches:
        is_red = tomato_patch.verify_property("tomato", "red")
        if red_tomato_patch is None and is_red:
            red_tomato_patch = tomato_patch

    if len(lettuce_patches) == 0 or red_tomato_patch is None:
        result = image_patch.simple_query("Is the lettuce to the right or to the left of the tomato that looks red?")
    else:
        lettuce_patch = lettuce_patches[0]
        if lettuce_patch.horizontal_center > red_tomato_patch.horizontal_center:
            result = "right"
        else:
            result = "left"
    return result