def execute_command(image)->str:
    image_patch = ImagePatch(image)
    boy_patches = image_patch.find("boy")
    if len(boy_patches) == 0:
        result = image_patch.simple_query("On which side of the image is the boy?")
    else:
        left_count = 0
        right_count = 0
        for boy_patch in boy_patches:
            if boy_patch.horizontal_center < image_patch.horizontal_center:
                left_count = left_count + 1
            else:
                right_count = right_count + 1
        if left_count > right_count:
            result = "left"
        elif right_count > left_count:
            result = "right"
        else:
            if boy_patches[0].horizontal_center < image_patch.horizontal_center:
                result = "left"
            else:
                result = "right"
    return result