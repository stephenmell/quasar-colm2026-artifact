def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bulb_names = ("bulb", "light bulb", "lightbulb", "bulbs", "light bulbs")
    found = False
    for name in bulb_names:
        if image_patch.exists(name):
            found = True
    result = bool_to_yesno(found)
    return result