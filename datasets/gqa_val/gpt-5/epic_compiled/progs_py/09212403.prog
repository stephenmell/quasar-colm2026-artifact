# Does that box have tan color?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    box_patches = image_patch.find("box")
    if len(box_patches) == 0:
        result = image_patch.simple_query("Does that box have tan color?")
    else:
        result = "no"
        for box_patch in box_patches:
            if box_patch.verify_property("box", "tan"):
                result = "yes"
    return result