def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")

    if len(table_patches) == 0:
        result = image_patch.simple_query("Is the wood table to the right of a curtain?")
    else:
        result = "no"
        curtain_patches = image_patch.find("curtain")
        for table_patch in table_patches:
            is_wood = table_patch.verify_property("table", "wood") or table_patch.verify_property("table", "wooden")
            if is_wood:
                for curtain_patch in curtain_patches:
                    if curtain_patch.horizontal_center < table_patch.horizontal_center:
                        result = "yes"
    return result