def execute_command(image)->str:
    image_patch = ImagePatch(image)
    object_names = ("picture", "painting", "poster", "photo", "photograph", "picture frame", "art")
    exists_any = False
    for name in object_names:
        if image_patch.exists(name):
            exists_any = True
    if exists_any:
        result = "yes"
    else:
        result = image_patch.simple_query("Are there pictures in this photo?")
    return result