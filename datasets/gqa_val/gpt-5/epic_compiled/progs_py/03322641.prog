# Do you see either any hats or boys?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    is_hat = image_patch.exists("hat") or image_patch.exists("hats")
    is_boy = image_patch.exists("boy") or image_patch.exists("boys")
    result = bool_to_yesno(is_hat or is_boy)
    return result