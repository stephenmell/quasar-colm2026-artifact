def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    # Check plates for plastic material
    plate_exists = image_patch.exists("plate")
    if plate_exists:
        plate_patches = image_patch.find("plate")
        for plate_patch in plate_patches:
            if plate_patch.verify_property("plate", "plastic"):
                result = "yes"

    # Check bottles for plastic material
    bottle_exists = image_patch.exists("bottle")
    if bottle_exists:
        bottle_patches = image_patch.find("bottle")
        for bottle_patch in bottle_patches:
            if bottle_patch.verify_property("bottle", "plastic"):
                result = "yes"

    return result