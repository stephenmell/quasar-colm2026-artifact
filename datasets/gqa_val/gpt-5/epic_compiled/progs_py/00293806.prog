# Do you see a television or a telephone in the scene?
def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Check for television
    has_tv = image_patch.exists("television")
    if not has_tv:
        has_tv = image_patch.exists("tv")

    # Check for telephone and common synonyms
    has_telephone = image_patch.exists("telephone")
    if not has_telephone:
        has_cell_phone = image_patch.exists("cell phone")
        has_mobile_phone = image_patch.exists("mobile phone")
        has_phone = image_patch.exists("phone")
        has_telephone = has_cell_phone or has_mobile_phone or has_phone

    result = bool_to_yesno(has_tv or has_telephone)
    return result