def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lady_patches = image_patch.find("lady")
    if len(lady_patches) == 0:
        woman_patches = image_patch.find("woman")
        if len(woman_patches) == 0:
            result = image_patch.simple_query("In which part of the photo is the lady, the top or the bottom?")
        else:
            woman_patch = woman_patches[0]
            if woman_patch.vertical_center < image_patch.vertical_center:
                result = "bottom"
            else:
                result = "top"
    else:
        lady_patch = lady_patches[0]
        if lady_patch.vertical_center < image_patch.vertical_center:
            result = "bottom"
        else:
            result = "top"
    return result