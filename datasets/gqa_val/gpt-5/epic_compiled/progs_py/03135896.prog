# Who is eating the sandwich?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    sandwich_patches = image_patch.find("sandwich")
    result = None

    if len(sandwich_patches) == 0:
        result = image_patch.simple_query("Who is eating the sandwich?")
    else:
        for sandwich_patch in sandwich_patches:
            if not result:
                answer = sandwich_patch.simple_query("Who is eating the sandwich?")
                if answer:
                    result = answer
        if not result:
            result = image_patch.simple_query("Who is eating the sandwich?")
    return result