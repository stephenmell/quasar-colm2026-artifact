# Does the shirt look long?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    shirt_patches = image_patch.find("shirt")
    if len(shirt_patches) == 0:
        result = image_patch.simple_query("Does the shirt look long?")
    else:
        is_long = False
        for shirt_patch in shirt_patches:
            if shirt_patch.verify_property("shirt", "long"):
                is_long = True
        result = bool_to_yesno(is_long)
    return result