def execute_command(image)->str:
    image_patch = ImagePatch(image)
    found_any = False

    # Check for locks
    for name in ("lock", "padlock", "door lock", "combination lock"):
        if image_patch.exists(name):
            found_any = True

    # Check for safety jackets/vests
    for name in ("safety jacket", "life jacket", "safety vest", "reflective vest", "life vest", "high-visibility vest", "hi-vis vest"):
        if image_patch.exists(name):
            found_any = True

    result = bool_to_yesno(found_any)
    return result