def execute_command(image)->str:
    image_patch = ImagePatch(image)
    helmet_patches = image_patch.find("helmet")

    if len(helmet_patches) == 0:
        result = image_patch.simple_query("Is the blue helmet in the bottom or in the top part of the image?")
    else:
        blue_helmet_patch = None
        for helmet_patch in helmet_patches:
            if blue_helmet_patch is None:
                if helmet_patch.verify_property("helmet", "blue"):
                    blue_helmet_patch = helmet_patch
        if not blue_helmet_patch:
            result = image_patch.simple_query("Is the blue helmet in the bottom or in the top part of the image?")
        else:
            if blue_helmet_patch.vertical_center < image_patch.vertical_center:
                result = "bottom"
            else:
                result = "top"
    return result