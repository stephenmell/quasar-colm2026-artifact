def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cell_phone_patches = image_patch.find("cell phone")

    if len(cell_phone_patches) == 0:
        result = image_patch.simple_query("Do you see cell phones there that are large?")
    else:
        result = "no"
        for cell_phone_patch in cell_phone_patches:
            if cell_phone_patch.verify_property("cell phone", "large"):
                result = "yes"
    return result