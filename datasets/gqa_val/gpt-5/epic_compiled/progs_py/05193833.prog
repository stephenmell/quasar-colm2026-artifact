# Are there both bags and cars in the photograph?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_bag = image_patch.exists("bag") or image_patch.exists("bags")
    has_car = image_patch.exists("car") or image_patch.exists("cars")
    result = bool_to_yesno(has_bag and has_car)
    return result