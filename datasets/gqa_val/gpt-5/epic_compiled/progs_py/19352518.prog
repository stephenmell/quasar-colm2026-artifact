def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lid_patches = image_patch.find("toilet lid")
    if len(lid_patches) == 0:
        lid_patches = image_patch.find("lid")
    toilet_patches = image_patch.find("toilet")

    result = "no"
    if len(lid_patches) == 0 or len(toilet_patches) == 0:
        result = image_patch.simple_query("Are both the lid and the toilet the same color?")
    else:
        lid_patch = lid_patches[0]
        toilet_patch = toilet_patches[0]

        colors = (
            "white", "off white", "cream", "beige", "tan", "gray", "grey", "black",
            "silver", "gold", "brown", "blue", "green", "red", "yellow", "pink",
            "purple", "orange"
        )

        lid_color = ""
        for c in colors:
            if lid_color == "":
                if lid_patch.verify_property("lid", c):
                    lid_color = c

        toilet_color = ""
        for c in colors:
            if toilet_color == "":
                if toilet_patch.verify_property("toilet", c):
                    toilet_color = c

        if lid_color == "":
            lid_color = lid_patch.best_text_match(colors)
        if toilet_color == "":
            toilet_color = toilet_patch.best_text_match(colors)

        if lid_color == toilet_color:
            result = "yes"
        else:
            result = "no"
    return result