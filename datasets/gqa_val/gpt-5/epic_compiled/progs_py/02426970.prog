# Is the motorcycle to the right of a boy?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    motorcycle_patches = image_patch.find("motorcycle")
    if len(motorcycle_patches) == 0:
        result = image_patch.simple_query("Is the motorcycle to the right of a boy?")
    else:
        boy_patches = image_patch.find("boy")
        if len(boy_patches) == 0:
            result = "no"
        else:
            result = "no"
            for motorcycle_patch in motorcycle_patches:
                for boy_patch in boy_patches:
                    if motorcycle_patch.horizontal_center > boy_patch.horizontal_center:
                        result = "yes"
    return result