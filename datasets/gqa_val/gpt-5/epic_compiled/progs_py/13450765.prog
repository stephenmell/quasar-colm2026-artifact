def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lamp_patches = image_patch.find("lamp")
    if len(lamp_patches) == 0:
        result = image_patch.simple_query("Is there a lamp in this picture that is black?")
    else:
        result = "no"
        for lamp_patch in lamp_patches:
            if lamp_patch.verify_property("lamp", "black"):
                result = "yes"
    return result