def execute_command(image)->str:
    image_patch = ImagePatch(image)
    snow_patches = image_patch.find("snow")
    if len(snow_patches) == 0:
        result = image_patch.simple_query("Does that snow look white?")
    else:
        is_white = False
        for snow_patch in snow_patches:
            if snow_patch.verify_property("snow", "white"):
                is_white = True
        result = bool_to_yesno(is_white)
    return result