# Does the clock look orange?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    clock_patches = image_patch.find("clock")
    if len(clock_patches) == 0:
        result = image_patch.simple_query("Does the clock look orange?")
    else:
        is_orange = False
        for clock_patch in clock_patches:
            if clock_patch.verify_property("clock", "orange"):
                is_orange = True
        result = bool_to_yesno(is_orange)
    return result