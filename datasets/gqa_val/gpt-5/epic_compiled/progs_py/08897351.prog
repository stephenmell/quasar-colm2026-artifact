def execute_command(image)->str:
    image_patch = ImagePatch(image)
    bowl_patches = image_patch.find("bowl")
    if len(bowl_patches) == 0:
        result = image_patch.simple_query("How big is the bowl?")
    else:
        result = bowl_patches[0].best_text_match(("small", "medium", "big"))
    return result