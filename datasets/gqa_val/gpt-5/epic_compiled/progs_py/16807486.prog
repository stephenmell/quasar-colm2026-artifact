def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    frisbee_exists = image_patch.exists("frisbee")
    if frisbee_exists:
        frisbee_patches = image_patch.find("frisbee")
        for frisbee_patch in frisbee_patches:
            if frisbee_patch.verify_property("frisbee", "blue"):
                result = "yes"
    else:
        result = image_patch.simple_query("Are there frisbees in this image that are blue?")
    return result