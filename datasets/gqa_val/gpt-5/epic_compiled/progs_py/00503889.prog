def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_knife_block = image_patch.exists("knife block") or image_patch.exists("knife blocks")
    has_crate = image_patch.exists("crate") or image_patch.exists("crates")
    result = bool_to_yesno(has_knife_block or has_crate)
    return result