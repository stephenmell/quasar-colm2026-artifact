# Does the giraffe have white color?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    giraffe_patches = image_patch.find("giraffe")
    if len(giraffe_patches) == 0:
        result = image_patch.simple_query("Does the giraffe have white color?")
    else:
        has_white = False
        for giraffe_patch in giraffe_patches:
            if giraffe_patch.verify_property("giraffe", "white"):
                has_white = True
        result = bool_to_yesno(has_white)
    return result