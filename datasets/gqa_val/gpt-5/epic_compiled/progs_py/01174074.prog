def execute_command(image)->str:
    image_patch = ImagePatch(image)
    horse_patches = image_patch.find("horse")
    if len(horse_patches) == 0:
        result = image_patch.simple_query("Do you see any woman to the left of the horse?")
    else:
        horse_patch = horse_patches[0]
        woman_patches = image_patch.find("woman")
        if len(woman_patches) == 0:
            result = "no"
        else:
            result = "no"
            for woman_patch in woman_patches:
                if woman_patch.horizontal_center < horse_patch.horizontal_center:
                    result = "yes"
    return result