def execute_command(image)->str:
    image_patch = ImagePatch(image)
    clock_patches = image_patch.find("clock")
    if len(clock_patches) == 0:
        result = image_patch.simple_query("Does the clock have red color?")
    else:
        has_red = False
        for clock_patch in clock_patches:
            if clock_patch.verify_property("clock", "red"):
                has_red = True
        result = bool_to_yesno(has_red)
    return result