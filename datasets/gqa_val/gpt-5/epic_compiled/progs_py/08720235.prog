def execute_command(image)->str:
    image_patch = ImagePatch(image)
    car_patches = image_patch.find("car")
    if len(car_patches) == 0:
        result = image_patch.simple_query("Do you see any trucks to the right of the car?")
    else:
        car_patch = car_patches[0]
        truck_patches = image_patch.find("truck")
        if len(truck_patches) == 0:
            result = "no"
        else:
            result = "no"
            for truck_patch in truck_patches:
                if truck_patch.horizontal_center > car_patch.horizontal_center:
                    result = "yes"
    return result