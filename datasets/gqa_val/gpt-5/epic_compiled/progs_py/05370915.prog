def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    # Gather bike/bicycle patches if they exist
    bike_patches = ()
    if image_patch.exists("bike"):
        bike_patches = bike_patches + image_patch.find("bike")
    if image_patch.exists("bicycle"):
        bike_patches = bike_patches + image_patch.find("bicycle")

    if len(bike_patches) == 0:
        # If no bikes detected, ask directly
        result = image_patch.simple_query("Is there a bike in the photograph that is not black?")
    else:
        # Check if any detected bike is not black
        temp_result = "no"
        for bike_patch in bike_patches:
            is_black_as_bike = bike_patch.verify_property("bike", "black")
            is_black_as_bicycle = bike_patch.verify_property("bicycle", "black")
            is_black = is_black_as_bike or is_black_as_bicycle
            if not is_black:
                temp_result = "yes"
        result = temp_result
    return result