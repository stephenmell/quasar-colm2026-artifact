# Is the woman looking down or talking?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    if len(woman_patches) == 0:
        result = image_patch.simple_query("Is the woman looking down or talking?")
    else:
        result = woman_patches[0].best_text_match(("looking down", "talking"))
    return result