def execute_command(image)->str:
    image_patch = ImagePatch(image)
    planter_exists = image_patch.exists("planter")
    flower_pot_exists = image_patch.exists("flower pot")
    plant_pot_exists = image_patch.exists("plant pot")
    has_any_planter = planter_exists or flower_pot_exists or plant_pot_exists
    result = bool_to_yesno(has_any_planter)
    return result