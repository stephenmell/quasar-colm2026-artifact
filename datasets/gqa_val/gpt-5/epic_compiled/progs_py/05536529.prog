# Are there any rugs or wheelchairs?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    is_rug = image_patch.exists("rug")
    is_wheelchair = image_patch.exists("wheelchair")

    # Try common synonyms/plurals if initial checks fail
    if not is_rug:
        is_rug = image_patch.exists("carpet")
    if not is_wheelchair:
        is_wheelchair = image_patch.exists("wheel chair")

    result = bool_to_yesno(is_rug or is_wheelchair)
    return result