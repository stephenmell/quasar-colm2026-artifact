def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    car_patches = image_patch.find("car")
    if len(car_patches) == 0:
        result = image_patch.simple_query("Are there men to the right of the car that is crossing the road?")
    else:
        crossing_car_found = False
        men_right_of_crossing_car = False

        man_patches = image_patch.find("man")
        for car_patch in car_patches:
            is_crossing = car_patch.verify_property("car", "crossing the road")
            if is_crossing:
                crossing_car_found = True
            if is_crossing:
                for man_patch in man_patches:
                    if man_patch.horizontal_center > car_patch.horizontal_center:
                        men_right_of_crossing_car = True

        if crossing_car_found:
            if men_right_of_crossing_car:
                result = "yes"
            else:
                result = "no"
        else:
            result = image_patch.simple_query("Are there men to the right of the car that is crossing the road?")
    return result