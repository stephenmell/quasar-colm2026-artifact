# Is the woman preparing a sandwich?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    woman_patches = image_patch.find("woman")
    if len(woman_patches) == 0:
        result = image_patch.simple_query("Is the woman preparing a sandwich?")
    else:
        result = "no"
        for woman_patch in woman_patches:
            if woman_patch.simple_query("Is the woman preparing a sandwich?") == "yes":
                result = "yes"
    return result