def execute_command(image)->str:
    image_patch = ImagePatch(image)
    ski_patches = image_patch.find("ski")
    if len(ski_patches) == 0:
        ski_patches = image_patch.find("skis")

    if len(ski_patches) == 0:
        result = image_patch.simple_query("Are there orange skis in the image?")
    else:
        result = "no"
        for ski_patch in ski_patches:
            if ski_patch.verify_property("ski", "orange"):
                result = "yes"
    return result