def execute_command(image)->str:
    image_patch = ImagePatch(image)
    soup_patches = image_patch.find("soup")
    if len(soup_patches) == 0:
        result = image_patch.simple_query("Is there any soup that is orange in this photograph?")
    else:
        result = "no"
        for soup_patch in soup_patches:
            if soup_patch.verify_property("soup", "orange"):
                result = "yes"
    return result