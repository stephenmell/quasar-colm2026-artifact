def execute_command(image)->str:
    image_patch = ImagePatch(image)
    officer_patches = image_patch.find("officer")
    if len(officer_patches) == 0:
        result = image_patch.simple_query("Is the officer on the left?")
    else:
        result = "no"
        for officer_patch in officer_patches:
            if officer_patch.horizontal_center < image_patch.horizontal_center:
                result = "yes"
    return result