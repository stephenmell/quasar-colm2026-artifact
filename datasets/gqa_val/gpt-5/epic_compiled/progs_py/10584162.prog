def execute_command(image)->str:
    image_patch = ImagePatch(image)
    airplane_patches = image_patch.find("airplane")
    if len(airplane_patches) == 0:
        result = image_patch.simple_query("Is there an airplane in the picture that is not white?")
    else:
        result = "no"
        for airplane_patch in airplane_patches:
            is_white = airplane_patch.verify_property("airplane", "white")
            if not is_white:
                result = "yes"
    return result