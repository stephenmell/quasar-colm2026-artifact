def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = None

    table_patches = image_patch.find("table")
    knife_on_table = None

    if len(table_patches) > 0:
        for table_patch in table_patches:
            knives_on_table = table_patch.find("knife")
            if len(knives_on_table) > 0 and knife_on_table is None:
                knife_on_table = knives_on_table[0]
        if knife_on_table is not None:
            result = knife_on_table.best_text_match(("silver", "brown"))

    if not result:
        knife_patches = image_patch.find("knife")
        if len(knife_patches) > 0:
            result = knife_patches[0].best_text_match(("silver", "brown"))

    if not result:
        result = image_patch.simple_query("What color is the knife on the table, silver or brown?")

    return result