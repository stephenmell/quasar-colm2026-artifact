def execute_command(image)->str:
    image_patch = ImagePatch(image)
    car_patches = image_patch.find("car")
    result = None
    white_car_patch = None

    if len(car_patches) == 0:
        result = image_patch.simple_query("On which side of the image is the white car?")
    else:
        for car_patch in car_patches:
            is_white = car_patch.verify_property("car", "white")
            if is_white and white_car_patch is None:
                white_car_patch = car_patch
        if white_car_patch is None:
            result = image_patch.simple_query("On which side of the image is the white car?")
        else:
            if white_car_patch.horizontal_center < image_patch.horizontal_center:
                result = "left"
            else:
                result = "right"
    return result