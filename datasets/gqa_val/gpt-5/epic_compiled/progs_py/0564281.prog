# Is the color of the hat different than the house?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    hat_patches = image_patch.find("hat")
    house_patches = image_patch.find("house")
    result = None

    if len(hat_patches) == 0 or len(house_patches) == 0:
        result = image_patch.simple_query("Is the color of the hat different than the house?")
    else:
        colors = ("red", "orange", "yellow", "green", "blue", "purple", "pink",
                  "brown", "black", "white", "gray", "gold", "silver",
                  "beige", "tan", "teal", "maroon", "navy")
        hat_color = hat_patches[0].best_text_match(colors)
        house_color = house_patches[0].best_text_match(colors)
        result = bool_to_yesno(hat_color != house_color)
    return result