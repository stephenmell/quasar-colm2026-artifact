# INSERT_PROMPT_HERE
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"
    if not image_patch.exists("table"):
        result = image_patch.simple_query("Are there tables that are not black?")
    else:
        table_patches = image_patch.find("table")
        for table_patch in table_patches:
            is_black = table_patch.verify_property("table", "black")
            if not is_black:
                result = "yes"
    return result