def execute_command(image)->str:
    image_patch = ImagePatch(image)
    chain_patches = image_patch.find("chain")
    if len(chain_patches) == 0:
        result = image_patch.simple_query("Does the chain look red or silver?")
    else:
        result = chain_patches[0].best_text_match(("red", "silver"))
    return result