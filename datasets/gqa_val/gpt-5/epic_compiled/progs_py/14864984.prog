def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_letters = image_patch.exists("letters") or image_patch.exists("letter") or image_patch.exists("text")
    has_clocks = image_patch.exists("clock") or image_patch.exists("clocks")
    result = bool_to_yesno(has_letters and has_clocks)
    return result