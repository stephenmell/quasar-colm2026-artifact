# Is the sky orange or blue?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    sky_patches = image_patch.find("sky")
    if len(sky_patches) == 0:
        result = image_patch.simple_query("Is the sky orange or blue?")
    else:
        result = sky_patches[0].best_text_match(("orange", "blue"))
    return result