def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"
    found_any = False

    for object_name in ("laptop", "tv", "television"):
        if image_patch.exists(object_name):
            found_any = True
            object_patches = image_patch.find(object_name)
            for obj_patch in object_patches:
                if obj_patch.verify_property(object_name, "black"):
                    result = "yes"

    if not found_any:
        result = image_patch.simple_query("Is there a black laptop or TV?")
    return result