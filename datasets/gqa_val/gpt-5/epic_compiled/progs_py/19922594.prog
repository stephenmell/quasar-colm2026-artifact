# Is this a brown plate?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    plate_patches = image_patch.find("plate")
    if len(plate_patches) == 0:
        result = image_patch.simple_query("Is this a brown plate?")
    else:
        result = "no"
        for plate_patch in plate_patches:
            if plate_patch.verify_property("plate", "brown"):
                result = "yes"
    return result