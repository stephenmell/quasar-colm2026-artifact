# Does the fence look metallic?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")

    if len(fence_patches) == 0:
        result = image_patch.simple_query("Does the fence look metallic?")
    else:
        result = "no"
        for fence_patch in fence_patches:
            is_metallic = fence_patch.verify_property("fence", "metallic")
            is_metal = fence_patch.verify_property("fence", "metal")
            is_steel = fence_patch.verify_property("fence", "steel")
            is_iron = fence_patch.verify_property("fence", "iron")
            is_aluminum = fence_patch.verify_property("fence", "aluminum")
            if is_metallic or is_metal or is_steel or is_iron or is_aluminum:
                result = "yes"
    return result