def execute_command(image)->str:
    image_patch = ImagePatch(image)
    grass_patches = image_patch.find("grass")

    if len(grass_patches) == 0:
        result = image_patch.simple_query("Is there any grass that is not brown?")
    else:
        result = "no"
        for grass_patch in grass_patches:
            is_brown = grass_patch.verify_property("grass", "brown")
            if not is_brown:
                result = "yes"
    return result