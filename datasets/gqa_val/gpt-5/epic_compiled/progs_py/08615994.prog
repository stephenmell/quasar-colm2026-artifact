# Are there both words and numbers in this image?
def execute_command(image)->str:
    image_patch = ImagePatch(image)

    word_aliases = ("letters", "words", "text", "word", "letter")
    number_aliases = ("numbers", "number", "digits", "digit", "numeral", "numerals")

    words_present = False
    for alias in word_aliases:
        if image_patch.exists(alias):
            words_present = True

    numbers_present = False
    for alias in number_aliases:
        if image_patch.exists(alias):
            numbers_present = True

    if words_present and numbers_present:
        result = "yes"
    else:
        result = image_patch.simple_query("Are there both words and numbers in this image?")
    return result