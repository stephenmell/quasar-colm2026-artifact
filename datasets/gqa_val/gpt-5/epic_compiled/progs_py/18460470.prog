def execute_command(image)->str:
    image_patch = ImagePatch(image)
    tray_patches = image_patch.find("tray")
    if len(tray_patches) == 0:
        tray_patches = image_patch.find("trays")

    if len(tray_patches) == 0:
        result = image_patch.simple_query("Do the trays look black?")
    else:
        is_black = False
        for tray_patch in tray_patches:
            if tray_patch.verify_property("tray", "black"):
                is_black = True
        result = bool_to_yesno(is_black)
    return result