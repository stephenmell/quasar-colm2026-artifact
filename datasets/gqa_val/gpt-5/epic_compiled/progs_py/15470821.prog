# Is the person to the left of the knife wearing a hat?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    knife_patches = image_patch.find("knife")

    if len(knife_patches) == 0:
        result = image_patch.simple_query("Is the person to the left of the knife wearing a hat?")
    else:
        result = "no"
        person_patches = image_patch.find("person")
        for knife_patch in knife_patches:
            for person_patch in person_patches:
                if person_patch.horizontal_center < knife_patch.horizontal_center:
                    is_wearing_hat = (person_patch.simple_query("Is the person wearing a hat?") == "yes")
                    if is_wearing_hat:
                        result = "yes"
    return result