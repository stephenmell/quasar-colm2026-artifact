# Are there any couches or rugs in this image?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_couch = image_patch.exists("couch")
    has_sofa = image_patch.exists("sofa")
    has_rug = image_patch.exists("rug")
    has_carpet = image_patch.exists("carpet")
    result_bool = (has_couch or has_sofa) or (has_rug or has_carpet)
    result = bool_to_yesno(result_bool)
    return result