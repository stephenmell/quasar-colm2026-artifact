# Are there any rackets?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    racket_names = ("racket", "racquet", "tennis racket", "tennis racquet", "badminton racket", "squash racket")
    found = False
    for name in racket_names:
        if image_patch.exists(name):
            found = True
    result = bool_to_yesno(found)
    return result