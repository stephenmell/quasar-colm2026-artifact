def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    if len(man_patches) == 0:
        result = image_patch.simple_query("Is the catcher that is to the right of the man wearing a glove?")
    else:
        man_patch = man_patches[0]
        catcher_patches = image_patch.find("catcher")
        if len(catcher_patches) == 0:
            result = "no"
        else:
            result = "no"
            for catcher_patch in catcher_patches:
                if catcher_patch.horizontal_center > man_patch.horizontal_center:
                    if catcher_patch.simple_query("Is the catcher wearing a glove?") == "yes":
                        result = "yes"
    return result