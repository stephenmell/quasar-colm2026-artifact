def execute_command(image)->str:
    image_patch = ImagePatch(image)
    person_patches = image_patch.find("person")

    if len(person_patches) == 0:
        result = image_patch.simple_query("Are there plates to the right of the people that are using a mobile phone?")
    else:
        # Collect centers of people using a (mobile/cell) phone
        using_phone_centers = ()
        for person_patch in person_patches:
            uses_mobile = (person_patch.simple_query("Is the person using a mobile phone?") == "yes")
            uses_cell = (person_patch.simple_query("Is the person using a cell phone?") == "yes")
            if uses_mobile or uses_cell:
                using_phone_centers = using_phone_centers + (person_patch.horizontal_center,)

        result = "no"
        if len(using_phone_centers) > 0:
            plate_patches = image_patch.find("plate")
            if len(plate_patches) > 0:
                for center in using_phone_centers:
                    for plate_patch in plate_patches:
                        if plate_patch.horizontal_center > center:
                            result = "yes"
    return result