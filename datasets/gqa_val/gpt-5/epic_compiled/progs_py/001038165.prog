def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"
    horse_patches = image_patch.find("horse")
    if len(horse_patches) == 0:
        result = image_patch.simple_query("Is there a horse that is brown in the photo?")
    else:
        for horse_patch in horse_patches:
            if horse_patch.verify_property("horse", "brown"):
                result = "yes"
    return result