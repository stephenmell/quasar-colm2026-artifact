def execute_command(image)->str:
    image_patch = ImagePatch(image)
    hair_patches = image_patch.find("hair")
    if len(hair_patches) == 0:
        result = image_patch.simple_query("Does the hair look blond?")
    else:
        is_blond = False
        for hair_patch in hair_patches:
            if hair_patch.verify_property("hair", "blond"):
                is_blond = True
        result = bool_to_yesno(is_blond)
    return result