# Do you see horses to the left of the fence that looks black?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")
    if len(fence_patches) == 0:
        result = image_patch.simple_query("Do you see horses to the left of the fence that looks black?")
    else:
        result = "no"
        for fence_patch in fence_patches:
            is_black = fence_patch.verify_property("fence", "black")
            if is_black:
                horse_patches = image_patch.find("horse")
                for horse_patch in horse_patches:
                    if horse_patch.horizontal_center < fence_patch.horizontal_center:
                        result = "yes"
    return result