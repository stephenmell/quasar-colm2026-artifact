def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")

    if len(man_patches) == 0:
        result = image_patch.simple_query("What is the man that is surfing wearing?")
    else:
        result = None
        for man_patch in man_patches:
            is_surfing = man_patch.verify_property("man", "surfing")
            if is_surfing:
                result = man_patch.simple_query("What is the man wearing?")
        if not result:
            result = image_patch.simple_query("What is the man that is surfing wearing?")
    return result