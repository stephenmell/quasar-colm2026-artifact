# Is the plate to the left of the keyboard in the bottom part of the image?
def execute_command(image)->str:
    image_patch = ImagePatch(image)

    # Define the bottom half of the image
    bottom_top = int(image_patch.vertical_center)
    bottom_patch = image_patch.crop(image_patch.left, bottom_top, image_patch.right, image_patch.upper)

    # Find objects in the bottom half
    plate_patches = bottom_patch.find("plate")
    keyboard_patches = bottom_patch.find("keyboard")

    # If either object isn't detected in the bottom half, ask directly within the bottom area
    if len(plate_patches) == 0 or len(keyboard_patches) == 0:
        result = bottom_patch.simple_query("Is the plate to the left of the keyboard?")
    else:
        result = "no"
        for plate_patch in plate_patches:
            for keyboard_patch in keyboard_patches:
                if plate_patch.horizontal_center < keyboard_patch.horizontal_center:
                    result = "yes"
    return result