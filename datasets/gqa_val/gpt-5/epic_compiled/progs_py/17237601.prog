# Do you see either any fences or boys in the photograph?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_fence = image_patch.exists("fence") or image_patch.exists("fences")
    has_boy = image_patch.exists("boy") or image_patch.exists("boys")
    result = bool_to_yesno(has_fence or has_boy)
    return result