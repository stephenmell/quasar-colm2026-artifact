# INSERT_PROMPT_HERE
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    dome_exists = image_patch.exists("dome")
    if not dome_exists:
        result = image_patch.simple_query("Does the dome look small?")
    else:
        dome_patches = image_patch.find("dome")
        result = "no"
        for dome_patch in dome_patches:
            if dome_patch.verify_property("dome", "small"):
                result = "yes"
    return result