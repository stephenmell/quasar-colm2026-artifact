# Is the man to the left of the people inside the station?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")

    if len(man_patches) == 0:
        result = image_patch.simple_query("Is the man to the left of the people inside the station?")
    else:
        station_patches = image_patch.find("station")
        if len(station_patches) == 0:
            result = image_patch.simple_query("Is the man to the left of the people inside the station?")
        else:
            result = "no"
            man_patch = man_patches[0]
            found_any_inside = False

            for station_patch in station_patches:
                people_patches = station_patch.find("people")
                if len(people_patches) == 0:
                    people_patches = station_patch.find("person")
                for people_patch in people_patches:
                    found_any_inside = True
                    man_rel_center = man_patch.horizontal_center - station_patch.left
                    if man_rel_center < people_patch.horizontal_center:
                        result = "yes"

            if (not found_any_inside) and (result != "yes"):
                result = image_patch.simple_query("Is the man to the left of the people inside the station?")
    return result