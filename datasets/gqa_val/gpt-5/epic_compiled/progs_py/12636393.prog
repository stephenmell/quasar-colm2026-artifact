# Are there airplanes in the photograph?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_airplane = image_patch.exists("airplane")
    has_plane = image_patch.exists("plane")
    has_jet = image_patch.exists("jet")
    has_aircraft = image_patch.exists("aircraft")
    result = bool_to_yesno(has_airplane or has_plane or has_jet or has_aircraft)
    return result