# Does the table look dark brown?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    table_patches = image_patch.find("table")
    if len(table_patches) == 0:
        result = image_patch.simple_query("Does the table look dark brown?")
    else:
        is_dark_brown = False
        for table_patch in table_patches:
            if table_patch.verify_property("table", "dark brown"):
                is_dark_brown = True
        result = bool_to_yesno(is_dark_brown)
    return result