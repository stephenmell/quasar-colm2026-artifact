def execute_command(image)->str:
    image_patch = ImagePatch(image)
    train_patches = image_patch.find("train")

    if len(train_patches) == 0:
        result = image_patch.simple_query("Is there a train that is not gray?")
    else:
        result = "no"
        for train_patch in train_patches:
            is_gray = train_patch.verify_property("train", "gray")
            if not is_gray:
                result = "yes"
    return result