def execute_command(image)->str:
    image_patch = ImagePatch(image)
    person_patches = image_patch.find("person")
    if len(person_patches) == 0:
        result = image_patch.simple_query("Is the happy person riding on a skateboard?")
    else:
        result = "no"
        found_happy = False
        for person_patch in person_patches:
            is_happy = person_patch.verify_property("person", "happy")
            if is_happy:
                found_happy = True
                riding_answer = person_patch.simple_query("Is the person riding on a skateboard?")
                if riding_answer == "yes":
                    result = "yes"
        if not found_happy:
            result = image_patch.simple_query("Is the happy person riding on a skateboard?")
    return result