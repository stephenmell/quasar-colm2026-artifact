def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    person_patches = image_patch.find("person")

    if len(person_patches) == 0:
        result = image_patch.simple_query("Do you see catchers to the right of the person that is wearing a mask?")
    else:
        masked_person_patch = None
        for person_patch in person_patches:
            is_masked = (person_patch.simple_query("Is the person wearing a mask?") == "yes")
            if is_masked and masked_person_patch is None:
                masked_person_patch = person_patch

        if masked_person_patch is None:
            result = image_patch.simple_query("Do you see catchers to the right of the person that is wearing a mask?")
        else:
            right_area_patch = image_patch.crop(masked_person_patch.right, image_patch.lower, image_patch.right, image_patch.upper)

            catcher_patches = right_area_patch.find("catcher")
            if len(catcher_patches) == 0:
                catcher_patches = right_area_patch.find("baseball catcher")
            if len(catcher_patches) == 0:
                catcher_patches = right_area_patch.find("catchers")

            if len(catcher_patches) > 0:
                result = "yes"
    return result