# Is the jeep to the left of the white vehicle?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    jeep_patches = image_patch.find("jeep")

    if len(jeep_patches) == 0:
        result = image_patch.simple_query("Is the jeep to the left of the white vehicle?")
    else:
        # Collect white vehicle patches from various vehicle categories
        white_vehicle_patches = ()
        direct_white_vehicle_patches = image_patch.find("white vehicle")
        white_vehicle_patches = white_vehicle_patches + direct_white_vehicle_patches

        vehicle_types = ("vehicle", "car", "truck", "van", "bus", "suv", "automobile")
        for vtype in vehicle_types:
            vtype_patches = image_patch.find(vtype)
            for vp in vtype_patches:
                if vp.verify_property(vtype, "white"):
                    white_vehicle_patches = white_vehicle_patches + (vp,)

        if len(white_vehicle_patches) == 0:
            result = "no"
        else:
            result = "no"
            for jeep_patch in jeep_patches:
                for white_vehicle_patch in white_vehicle_patches:
                    if jeep_patch.horizontal_center < white_vehicle_patch.horizontal_center:
                        result = "yes"
    return result