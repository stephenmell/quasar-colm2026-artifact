def execute_command(image)->str:
    image_patch = ImagePatch(image)
    man_patches = image_patch.find("man")
    mouse_patches = image_patch.find("computer mouse")
    if len(mouse_patches) == 0:
        mouse_patches = image_patch.find("mouse")

    if len(man_patches) == 0 or len(mouse_patches) == 0:
        result = image_patch.simple_query("Is the computer mouse to the right or to the left of the man that is shown in the picture?")
    else:
        man_patch = man_patches[0]
        best_dx = None
        best_side = "left"
        for mouse_patch in mouse_patches:
            dx = abs(mouse_patch.horizontal_center - man_patch.horizontal_center)
            if best_dx is None or dx < best_dx:
                best_dx = dx
                if mouse_patch.horizontal_center > man_patch.horizontal_center:
                    best_side = "right"
                else:
                    best_side = "left"
        result = best_side
    return result