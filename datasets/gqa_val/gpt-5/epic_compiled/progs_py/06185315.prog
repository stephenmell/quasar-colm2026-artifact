# Is the broccoli to the left of the brown food?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    broccoli_patches = image_patch.find("broccoli")

    if len(broccoli_patches) == 0:
        result = image_patch.simple_query("Is the broccoli to the left of the brown food?")
    else:
        result = "no"
        food_patches = image_patch.find("food")
        if len(food_patches) > 0:
            for food_patch in food_patches:
                is_brown_food = food_patch.verify_property("food", "brown")
                if is_brown_food:
                    for broccoli_patch in broccoli_patches:
                        if broccoli_patch.horizontal_center < food_patch.horizontal_center:
                            result = "yes"
    return result