def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cup_patches = image_patch.find("cup")
    if len(cup_patches) == 0:
        result = image_patch.simple_query("Is the cup in the top of the picture?")
    else:
        result = "no"
        for cup_patch in cup_patches:
            if cup_patch.vertical_center >= image_patch.vertical_center:
                result = "yes"
    return result