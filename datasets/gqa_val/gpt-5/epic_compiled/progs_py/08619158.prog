# Which type of clothing is black, the cowboy hat or the shirt?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    hat_patches = image_patch.find("cowboy hat")
    shirt_patches = image_patch.find("shirt")

    if len(hat_patches) == 0 or len(shirt_patches) == 0:
        result = image_patch.simple_query("Which type of clothing is black, the cowboy hat or the shirt?")
    else:
        hat_black = False
        for hat_patch in hat_patches:
            if hat_patch.verify_property("cowboy hat", "black"):
                hat_black = True
        shirt_black = False
        for shirt_patch in shirt_patches:
            if shirt_patch.verify_property("shirt", "black"):
                shirt_black = True

        if hat_black and not shirt_black:
            result = "cowboy hat"
        elif shirt_black and not hat_black:
            result = "shirt"
        else:
            result = image_patch.simple_query("Which type of clothing is black, the cowboy hat or the shirt?")
    return result