def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fence_patches = image_patch.find("fence")
    if len(fence_patches) == 0:
        result = image_patch.simple_query("Is the fence in the bottom?")
    else:
        result = "no"
        for fence_patch in fence_patches:
            if fence_patch.vertical_center < image_patch.vertical_center:
                result = "yes"
    return result