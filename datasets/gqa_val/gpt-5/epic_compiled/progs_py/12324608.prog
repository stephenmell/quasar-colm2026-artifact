def execute_command(image)->str:
    image_patch = ImagePatch(image)
    car_patches = image_patch.find("car")
    if len(car_patches) == 0:
        result = image_patch.simple_query("Is there a fence to the right of the car?")
    else:
        car_patch = car_patches[0]
        fence_patches = image_patch.find("fence")
        if len(fence_patches) == 0:
            result = "no"
        else:
            result = "no"
            for fence_patch in fence_patches:
                if fence_patch.horizontal_center > car_patch.horizontal_center:
                    result = "yes"
    return result