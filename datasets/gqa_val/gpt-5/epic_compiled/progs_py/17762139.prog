# Are there any cones?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    object_names = ("cone", "traffic cone", "ice cream cone")
    exists_any = False
    for name in object_names:
        if image_patch.exists(name):
            exists_any = True
    result = bool_to_yesno(exists_any)
    return result