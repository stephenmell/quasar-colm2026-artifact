def execute_command(image)->str:
    image_patch = ImagePatch(image)
    elephant_patches = image_patch.find("elephant")
    if len(elephant_patches) == 0:
        result = image_patch.simple_query("Is there an elephant that is small?")
    else:
        result = "no"
        for elephant_patch in elephant_patches:
            if elephant_patch.verify_property("elephant", "small"):
                result = "yes"
    return result