def execute_command(image)->str:
    image_patch = ImagePatch(image)
    chair_patches = image_patch.find("chair")
    if len(chair_patches) == 0:
        result = image_patch.simple_query("Is there a chair that is not orange?")
    else:
        result = "no"
        for chair_patch in chair_patches:
            is_orange = chair_patch.verify_property("chair", "orange")
            if not is_orange:
                result = "yes"
    return result