def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    player_patches = image_patch.find("player")
    if len(player_patches) == 0:
        result = image_patch.simple_query("Are there any cameras to the left of the helmet that the player is wearing?")
    else:
        camera_patches = image_patch.find("camera")
        if len(camera_patches) == 0:
            result = "no"
        else:
            any_helmet_found = False
            for player_patch in player_patches:
                helmet_patches = player_patch.find("helmet")
                if len(helmet_patches) > 0:
                    any_helmet_found = True
                for helmet_patch in helmet_patches:
                    for camera_patch in camera_patches:
                        if camera_patch.horizontal_center < helmet_patch.horizontal_center:
                            result = "yes"
            if not any_helmet_found:
                result = image_patch.simple_query("Are there any cameras to the left of the helmet that the player is wearing?")
    return result