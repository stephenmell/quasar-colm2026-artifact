def execute_command(image)->str:
    image_patch = ImagePatch(image)
    motorbike_patches = image_patch.find("motorbike")
    if len(motorbike_patches) == 0:
        result = image_patch.simple_query("Do you see a bag to the left of the motorbike that looks purple?")
    else:
        bag_patches = image_patch.find("bag")
        if len(bag_patches) == 0:
            result = "no"
        else:
            result = "no"
            for motorbike_patch in motorbike_patches:
                for bag_patch in bag_patches:
                    is_left = bag_patch.horizontal_center < motorbike_patch.horizontal_center
                    is_purple = bag_patch.verify_property("bag", "purple")
                    if is_left and is_purple:
                        result = "yes"
    return result