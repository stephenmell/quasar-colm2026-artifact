# Is the dog on the left side or on the right?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    dog_patches = image_patch.find("dog")
    if len(dog_patches) == 0:
        result = image_patch.simple_query("Is the dog on the left side or on the right?")
    else:
        dog_patch = dog_patches[0]
        if dog_patch.horizontal_center < image_patch.horizontal_center:
            result = "left"
        else:
            result = "right"
    return result