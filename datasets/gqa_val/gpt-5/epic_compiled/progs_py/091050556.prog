def execute_command(image)->str:
    image_patch = ImagePatch(image)
    person_patches = image_patch.find("person")
    if len(person_patches) == 0:
        result = image_patch.simple_query("Are there helmets to the left of the person that is wearing a shoe?")
    else:
        result = "no"
        helmet_patches = image_patch.find("helmet")
        for person_patch in person_patches:
            is_wearing_shoe = (person_patch.simple_query("Is the person wearing a shoe?") == "yes")
            if is_wearing_shoe:
                for helmet_patch in helmet_patches:
                    if helmet_patch.horizontal_center < person_patch.horizontal_center:
                        result = "yes"
    return result