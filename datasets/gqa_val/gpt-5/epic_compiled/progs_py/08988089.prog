# Are there any bowls or trash cans in this scene?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    is_bowl = image_patch.exists("bowl")
    is_trash_can = image_patch.exists("trash can")
    if not is_trash_can:
        is_trash_can = image_patch.exists("trashcan")
    if not is_trash_can:
        is_trash_can = image_patch.exists("garbage can")
    result = bool_to_yesno(is_bowl or is_trash_can)
    return result