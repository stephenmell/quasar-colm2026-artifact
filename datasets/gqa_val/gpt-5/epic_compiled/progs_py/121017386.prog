# Do you think the sky is blue?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    sky_patches = image_patch.find("sky")
    if len(sky_patches) == 0:
        result = image_patch.simple_query("Do you think the sky is blue?")
    else:
        is_blue = False
        for sky_patch in sky_patches:
            if sky_patch.verify_property("sky", "blue"):
                is_blue = True
        result = bool_to_yesno(is_blue)
    return result