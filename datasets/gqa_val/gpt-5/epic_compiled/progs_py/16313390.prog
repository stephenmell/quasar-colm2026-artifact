# On which side of the photo is the white cup?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cup_patches = image_patch.find("cup")

    if len(cup_patches) == 0:
        result = image_patch.simple_query("On which side of the photo is the white cup?")
    else:
        chosen_patch = None
        for cup_patch in cup_patches:
            if cup_patch.verify_property("cup", "white"):
                chosen_patch = cup_patch
        if not chosen_patch:
            result = image_patch.simple_query("On which side of the photo is the white cup?")
        else:
            if chosen_patch.horizontal_center < image_patch.horizontal_center:
                result = "left"
            else:
                result = "right"
    return result