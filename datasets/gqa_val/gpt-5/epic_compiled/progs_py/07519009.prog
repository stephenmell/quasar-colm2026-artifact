def execute_command(image)->str:
    image_patch = ImagePatch(image)
    fork_patches = image_patch.find("fork")
    if len(fork_patches) == 0:
        result = image_patch.simple_query("Are there any metallic forks?")
    else:
        result = "no"
        for fork_patch in fork_patches:
            is_metallic = fork_patch.verify_property("fork", "metallic")
            is_metal = fork_patch.verify_property("fork", "metal")
            if is_metallic or is_metal:
                result = "yes"
    return result