def execute_command(image)->str:
    image_patch = ImagePatch(image)
    jeans_patches = image_patch.find("jeans")
    if len(jeans_patches) == 0:
        result = image_patch.simple_query("Are the jeans blue?")
    else:
        is_blue = False
        for jeans_patch in jeans_patches:
            if jeans_patch.verify_property("jeans", "blue"):
                is_blue = True
        result = bool_to_yesno(is_blue)
    return result