def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    person_patches = image_patch.find("person")
    if len(person_patches) == 0:
        result = image_patch.simple_query("Is there a child to the right of the person that is wearing jeans?")
    else:
        jeans_person_found = False
        for person_patch in person_patches:
            is_wearing_jeans = (person_patch.simple_query("Is the person wearing jeans?") == "yes")
            if is_wearing_jeans:
                jeans_person_found = True
                child_patches = image_patch.find("child")
                for child_patch in child_patches:
                    if child_patch.horizontal_center > person_patch.horizontal_center:
                        result = "yes"
        if not jeans_person_found:
            result = image_patch.simple_query("Is there a child to the right of the person that is wearing jeans?")
    return result