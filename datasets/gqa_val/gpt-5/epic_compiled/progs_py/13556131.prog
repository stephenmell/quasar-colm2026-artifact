# What is the brown animal doing?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    animal_patches = image_patch.find("animal")

    if len(animal_patches) == 0:
        result = image_patch.simple_query("What is the brown animal doing?")
    else:
        result = None
        for animal_patch in animal_patches:
            is_brown = animal_patch.verify_property("animal", "brown")
            if is_brown:
                result = animal_patch.simple_query("What is the brown animal doing?")
        if not result:
            result = image_patch.simple_query("What is the brown animal doing?")
    return result