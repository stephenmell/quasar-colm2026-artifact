def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = None

    # Find the man wearing a shirt
    man_patches = image_patch.find("man")
    man_with_shirt_patch = None
    if len(man_patches) > 0:
        for man_patch in man_patches:
            if man_patch.simple_query("Is the man wearing a shirt?") == "yes":
                if man_with_shirt_patch is None:
                    man_with_shirt_patch = man_patch

    # Find a plastic chair
    chair_patches = image_patch.find("chair")
    plastic_chair_patch = None
    if len(chair_patches) > 0:
        for chair_patch in chair_patches:
            if chair_patch.verify_property("chair", "plastic"):
                if plastic_chair_patch is None:
                    plastic_chair_patch = chair_patch

    # Decide or ask directly if objects are missing
    if man_with_shirt_patch is None or plastic_chair_patch is None:
        result = image_patch.simple_query("Is the plastic chair to the right or to the left of the man that is wearing a shirt?")
    else:
        if plastic_chair_patch.horizontal_center > man_with_shirt_patch.horizontal_center:
            result = "right"
        else:
            result = "left"
    return result