def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cookbook_terms = ("cookbook", "cook book", "cookbooks", "cook books", "recipe book", "recipe books")
    helmet_terms = ("helmet", "helmets", "hard hat", "hard hats")

    is_cookbook = False
    for term in cookbook_terms:
        if image_patch.exists(term):
            is_cookbook = True

    is_helmet = False
    for term in helmet_terms:
        if image_patch.exists(term):
            is_helmet = True

    result = bool_to_yesno(is_cookbook or is_helmet)
    return result