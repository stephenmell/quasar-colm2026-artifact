# INSERT_PROMPT_HERE
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    kite_patches = image_patch.find("kite")
    person_patches = image_patch.find("person")

    if len(kite_patches) == 0 or len(person_patches) == 0:
        result = image_patch.simple_query("Is the kite to the right or to the left of the person that is standing on the side walk?")
    else:
        target_person = None
        for person_patch in person_patches:
            on_sidewalk = (
                person_patch.verify_property("person", "standing on the sidewalk")
                or person_patch.verify_property("person", "on the sidewalk")
                or person_patch.verify_property("person", "standing on the side walk")
            )
            if on_sidewalk and (target_person is None):
                target_person = person_patch

        if target_person is None:
            target_person = person_patches[0]

        kite_patch = kite_patches[0]
        if kite_patch.horizontal_center > target_person.horizontal_center:
            result = "right"
        else:
            result = "left"
    return result