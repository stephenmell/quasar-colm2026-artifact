def execute_command(image)->str:
    image_patch = ImagePatch(image)
    cd_patches = image_patch.find("CD")
    if len(cd_patches) == 0:
        result = image_patch.simple_query("Is the CD in the top part of the picture?")
    else:
        result = "no"
        for cd_patch in cd_patches:
            if cd_patch.vertical_center >= image_patch.vertical_center:
                result = "yes"
    return result