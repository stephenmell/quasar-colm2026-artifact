# Are there both doors and windows in the picture?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    has_door = image_patch.exists("door") or image_patch.exists("doors")
    has_window = image_patch.exists("window") or image_patch.exists("windows")
    result = bool_to_yesno(has_door and has_window)
    return result