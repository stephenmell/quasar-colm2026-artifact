def execute_command(image)->str:
    image_patch = ImagePatch(image)
    tap_patches = image_patch.find("tap")
    if len(tap_patches) == 0:
        result = image_patch.simple_query("Does the tap have black color?")
    else:
        has_black = False
        for tap_patch in tap_patches:
            if tap_patch.verify_property("tap", "black"):
                has_black = True
        result = bool_to_yesno(has_black)
    return result