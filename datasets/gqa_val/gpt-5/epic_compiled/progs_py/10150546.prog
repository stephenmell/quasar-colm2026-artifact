# Are the dark drapes to the right of the picture?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    question = "Are the dark drapes to the right of the picture?"

    # Find picture-like patches
    picture_names = ("picture", "painting", "photo", "poster")
    picture_patches = ()
    for name in picture_names:
        picture_patches = picture_patches + image_patch.find(name)

    # Find drape/curtain patches
    drape_names = ("drape", "drapes", "curtain", "curtains")
    drape_patches = ()
    for name in drape_names:
        drape_patches = drape_patches + image_patch.find(name)

    if len(drape_patches) == 0:
        result = image_patch.simple_query(question)
    else:
        if len(picture_patches) == 0:
            result = "no"
        else:
            result = "no"
            for drape_patch in drape_patches:
                is_dark = False
                for obj_name in drape_names:
                    if not is_dark:
                        is_dark = drape_patch.verify_property(obj_name, "dark")
                if is_dark:
                    for picture_patch in picture_patches:
                        if drape_patch.horizontal_center > picture_patch.horizontal_center:
                            result = "yes"
    return result