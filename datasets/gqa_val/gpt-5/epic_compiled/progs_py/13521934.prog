def execute_command(image)->str:
    image_patch = ImagePatch(image)
    lady_patches = image_patch.find("lady")
    result = "no"

    if len(lady_patches) == 0:
        woman_patches = image_patch.find("woman")
        if len(woman_patches) == 0:
            result = image_patch.simple_query("Are there any children to the left of the lady?")
        else:
            lady_patch = woman_patches[0]
            child_patches = image_patch.find("child")
            boy_patches = image_patch.find("boy")
            girl_patches = image_patch.find("girl")
            kid_patches = image_patch.find("kid")
            children_patches = child_patches + boy_patches + girl_patches + kid_patches
            if len(children_patches) == 0:
                result = "no"
            else:
                for child_patch in children_patches:
                    if child_patch.horizontal_center < lady_patch.horizontal_center:
                        result = "yes"
    else:
        lady_patch = lady_patches[0]
        child_patches = image_patch.find("child")
        boy_patches = image_patch.find("boy")
        girl_patches = image_patch.find("girl")
        kid_patches = image_patch.find("kid")
        children_patches = child_patches + boy_patches + girl_patches + kid_patches
        if len(children_patches) == 0:
            result = "no"
        else:
            for child_patch in children_patches:
                if child_patch.horizontal_center < lady_patch.horizontal_center:
                    result = "yes"
    return result