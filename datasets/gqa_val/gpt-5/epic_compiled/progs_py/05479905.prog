# Are there fences or elephants in the image?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    is_fence = image_patch.exists("fence")
    if not is_fence:
        is_fence = image_patch.exists("fences")
    is_elephant = image_patch.exists("elephant")
    if not is_elephant:
        is_elephant = image_patch.exists("elephants")
    result = bool_to_yesno(is_fence or is_elephant)
    return result