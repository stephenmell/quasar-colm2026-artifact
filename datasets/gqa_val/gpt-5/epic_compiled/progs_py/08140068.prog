def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"
    frisbee_patches = image_patch.find("frisbee")
    if len(frisbee_patches) == 0:
        result = image_patch.simple_query("Are there any frisbees in this image that are white?")
    else:
        for frisbee_patch in frisbee_patches:
            if frisbee_patch.verify_property("frisbee", "white"):
                result = "yes"
    return result