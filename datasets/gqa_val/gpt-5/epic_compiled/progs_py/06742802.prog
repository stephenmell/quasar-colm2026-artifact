# What color is the glove?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    glove_patches = image_patch.find("glove")

    if len(glove_patches) == 0:
        result = image_patch.simple_query("What color is the glove?")
    else:
        result = None
        for glove_patch in glove_patches:
            answer = glove_patch.simple_query("What color is the glove?")
            if answer and not result:
                result = answer
        if not result:
            result = glove_patches[0].simple_query("What color is the glove?")
    return result