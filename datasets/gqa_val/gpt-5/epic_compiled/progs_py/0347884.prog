# Is there a fork on the plate?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    plate_patches = image_patch.find("plate")
    if len(plate_patches) == 0:
        result = image_patch.simple_query("Is there a fork on the plate?")
    else:
        result = "no"
        for plate_patch in plate_patches:
            if plate_patch.exists("fork"):
                result = "yes"
    return result