def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    man_patches = image_patch.find("man")
    if len(man_patches) == 0:
        result = image_patch.simple_query("Is there any beer to the left of the glasses the man is wearing?")
    else:
        # Find beer candidates in the whole image
        beer_types = ("beer", "beer bottle", "beer can")
        beer_patches = ()
        for beer_name in beer_types:
            found_beer = image_patch.find(beer_name)
            if len(found_beer) > 0:
                beer_patches = beer_patches + found_beer

        # Find glasses candidates in the whole image
        glasses_types = ("glasses", "sunglasses", "eyeglasses", "eye glasses")
        global_glasses_patches = ()
        for gname in glasses_types:
            found_glasses = image_patch.find(gname)
            if len(found_glasses) > 0:
                global_glasses_patches = global_glasses_patches + found_glasses

        # If we have men and glasses and beer, check spatial relation
        if len(beer_patches) > 0 and len(global_glasses_patches) > 0:
            for man_patch in man_patches:
                # Compute man bounds robustly
                man_min_x = man_patch.left if man_patch.left < man_patch.right else man_patch.right
                man_max_x = man_patch.right if man_patch.right > man_patch.left else man_patch.left
                man_min_y = man_patch.lower if man_patch.lower < man_patch.upper else man_patch.upper
                man_max_y = man_patch.upper if man_patch.upper > man_patch.lower else man_patch.lower

                # Glasses worn by this man: glasses centers inside the man bbox
                man_glasses = ()
                for gp in global_glasses_patches:
                    gx = gp.horizontal_center
                    gy = gp.vertical_center
                    inside_x = (gx >= man_min_x) and (gx <= man_max_x)
                    inside_y = (gy >= man_min_y) and (gy <= man_max_y)
                    if inside_x and inside_y:
                        man_glasses = man_glasses + (gp,)

                if len(man_glasses) > 0:
                    # Check if any beer is to the left of any of these glasses
                    for gp in man_glasses:
                        for bp in beer_patches:
                            if bp.horizontal_center < gp.horizontal_center:
                                result = "yes"
    return result