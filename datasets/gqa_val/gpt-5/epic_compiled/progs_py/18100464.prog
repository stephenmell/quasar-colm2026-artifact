# Do you see any office chairs?
def execute_command(image)->str:
    image_patch = ImagePatch(image)
    found = False

    # Check for common terms for office chairs
    synonyms = ("office chair", "desk chair", "rolling chair", "swivel chair")
    for name in synonyms:
        if image_patch.exists(name):
            found = True

    # Fallback: look for generic chairs with "office" property
    if not found:
        chair_patches = image_patch.find("chair")
        for chair_patch in chair_patches:
            if chair_patch.verify_property("chair", "office"):
                found = True

    result = bool_to_yesno(found)
    return result