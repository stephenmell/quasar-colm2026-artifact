def execute_command(image)->str:
    image_patch = ImagePatch(image)
    result = "no"

    # Check for common synonyms of "pictures"
    picture_like_objects = ("picture", "painting", "photo", "photograph", "poster")
    for obj_name in picture_like_objects:
        if image_patch.exists(obj_name):
            result = "yes"

    # If none detected via object search, ask directly
    if result == "no":
        direct_answer = image_patch.simple_query("Are there any pictures?")
        if direct_answer == "yes":
            result = "yes"
        else:
            result = "no"
    return result