def execute_command():
    details = None
    emails = None
    header = None
    idx = None
    result = None
    emails = get_unread_emails()
    result = 'You have no unread emails.'

    def _if(details, emails, header, idx, result):
        header = 'Unread emails for Emma Johnson (Blue Sparrow Tech):\n'
        details = ''
        idx = 0

        def _for(email, details, emails, header, idx, result):
            idx = idx + 1
            details = details + '{}. From: {} | Subject: {} | Received: {}\n'.format(idx, str(email.sender), email.subject, email.timestamp.strftime('%Y-%m-%d %H:%M'))
            return (details, emails, header, idx, result)
        details, emails, header, idx, result = for_stmt(_for, emails, (details, emails, header, idx, result))
        result = header + details
        return (details, emails, header, idx, result)
    details, emails, header, idx, result = if_stmt(_if, None, len(emails) != 0, (details, emails, header, idx, result))
    return result