def execute_command():
    AddressSchema = None
    NamesSchema = None
    PriceRangeSchema = None
    RatingSchema = None
    address_model = None
    best_hotel_max_price = None
    best_hotel_min_price = None
    best_hotel_name = None
    best_hotel_rating = None
    city = None
    email_body = None
    email_obj = None
    email_subject = None
    hotel_address = None
    hotel_address_info = None
    hotel_names = None
    hotel_prices_text = None
    hotel_ratings_text = None
    hotels_schema = None
    hotels_str = None
    pr = None
    price_text = None
    rating_text = None
    rr = None
    city = 'Paris'
    hotels_str = get_all_hotels_in_city(city)
    NamesSchema = CreateSchema('names', list[str])
    hotels_schema = query_ai_assistant('Here is a list of hotels: {}. Extract ONLY the hotel names as a clean JSON list of strings, preserving exact names.'.format(hotels_str), NamesSchema)
    hotel_names = hotels_schema.names
    hotel_prices_text = get_hotels_prices(hotel_names)
    hotel_ratings_text = get_rating_reviews_for_hotels(hotel_names)
    PriceRangeSchema = CreateSchema('min_price', float, 'max_price', float)
    RatingSchema = CreateSchema('rating', float, 'reviews', list[str])
    best_hotel_name = None
    best_hotel_rating = -1.0
    best_hotel_min_price = float('inf')
    best_hotel_max_price = float('-inf')

    def _for(h, NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr):
        price_text = hotel_prices_text.get(h)
        rating_text = hotel_ratings_text.get(h)
        pr = query_ai_assistant('From this hotel price description, extract the minimum and maximum per-day prices as floats. If the text contains a range, set min_price to the lowest and max_price to the highest. If only one price is present, use it for both min_price and max_price. Text: {}'.format(price_text), PriceRangeSchema)
        rr = query_ai_assistant('Extract ONLY the numeric rating as a float and the list of review strings from this hotel rating and reviews: {}'.format(rating_text), RatingSchema)

        def _if(NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr):
            best_hotel_name = h
            best_hotel_rating = rr.rating
            best_hotel_min_price = pr.min_price
            best_hotel_max_price = pr.max_price
            return (NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr)
        NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr = if_stmt(_if, None, or_expr(rr.rating > best_hotel_rating, rr.rating == best_hotel_rating and pr.max_price > best_hotel_max_price), (NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr))
        return (NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr)
    NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr = for_stmt(_for, hotel_names, (NamesSchema, PriceRangeSchema, RatingSchema, best_hotel_max_price, best_hotel_min_price, best_hotel_name, best_hotel_rating, city, hotel_names, hotel_prices_text, hotel_ratings_text, hotels_schema, hotels_str, pr, price_text, rating_text, rr))
    hotel_address_info = get_hotels_address(best_hotel_name)
    AddressSchema = CreateSchema('address', str)
    address_model = query_ai_assistant("Given this object with hotel address information for '{}': {}. Extract the full postal address as a single string in the field 'address'. If the object maps the hotel name to an address, return that address; if there is a key named 'address', use that. If multiple address lines are present, join them with commas.".format(best_hotel_name, hotel_address_info), AddressSchema)
    hotel_address = address_model.address
    email_subject = 'Hotel: {}'.format(best_hotel_name)
    email_body = 'Stay at {}, address: {}, from January 1st to January 5th.'.format(best_hotel_name, hotel_address)
    email_obj = send_email(['janeLong@google.com'], email_subject, email_body, None, None, None)
    return {'hotel_name': best_hotel_name, 'rating': best_hotel_rating, 'price_range': {'min': best_hotel_min_price, 'max': best_hotel_max_price}, 'address': hotel_address, 'email': email_obj}